u0440\u043e\u0432\u043e\u0457 \u0441\u0442\u0440\u0456\u0447\u043a\u0438 \u0432\u0438\u043c\u0456\u0440\u044f\u0442\u0438 \u043e\u0431\u0445\u0432\u0430\u0442 \u0442\u0430\u043b\u0456\u0457.\n        <\/div>\n    <\/div>\n    <div class=\"col-md-4 mb-50\">\n        <img class=\"raz_img\" src=\"image\/help\/raz2.png\" alt=\"\"\/>\n        <div class=\"title_sm\"><span>\u041e\u0431\u0445\u0432\u0430\u0442 \u0442\u0430\u043b\u0456\u0457<\/span><\/div>\n        <div class=\"raz_text\">\n            \u041e\u0431\u0445\u0432\u0430\u0442 \u0442\u0430\u043b\u0456\u0457 \u0432\u0438\u043c\u0456\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e \u043f\u043e \u043d\u0430\u0439\u0432\u0443\u0436\u0447\u0456\u0439 \u0447\u0430\u0441\u0442\u0438\u043d\u0456 \u0442\u0456\u043b\u0430, \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0447\u0438 \u0447\u0435\u0440\u0435\u0437 \u0441\u0430\u043c\u0443 \u0432\u0438\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u0443 \u0442\u043e\u0447\u043a\u0443 \u0436\u0438\u0432\u043e\u0442\u0430.\n        <\/div>\n    <\/div>\n    <div class=\"col-md-4 mb-50\">\n        <img class=\"raz_img\" src=\"image\/help\/raz3.png\" alt=\"\"\/>\n        <div class=\"title_sm\"><span>\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0442\u0438 \u0437 \u0442\u0430\u0431\u043b\u0438\u0446\u0435\u044e<\/span><\/div>\n        <div class=\"raz_text\">\n            \u0414\u043b\u044f \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0441\u043f\u0456\u0432\u0432\u0456\u0434\u043d\u0435\u0441\u0442\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u0456 \u0432\u0438\u043c\u0456\u0440\u0438 \u0437 \u0440\u043e\u0437\u043c\u0456\u0440\u0430\u043c\u0438 \u0442\u0430\u0431\u043b\u0438\u0446\u0456.\n        <\/div>\n    <\/div>\n<\/div>\n\n\n<div class=\"table-container-outer mb-50\">\n    <div class=\"table-container-fade\"><\/div>\n    <div class=\"table-container\">\n        <table class=\"razmer_table\">\n            <tr>\n                <td>\u041e\u0431\u0445\u0432\u0430\u0442 \u0442\u0430\u043b\u0456\u0457 (\u0441\u043c)<\/td>\n                <td>78-82<\/td>\n                <td>82-86<\/td>\n                <td>86-90<\/td>\n                <td>92-94<\/td>\n                <td>96-100<\/td>\n                <td>102-106<\/td>\n                <td>106-110<\/td>\n            <\/tr>\n            <tr>\n                <td>\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0438\u0439 \u0440\u043e\u0437\u043c\u0456\u0440 (UKR)<\/td>\n                <td>46<\/td>\n                <td>48<\/td>\n                <td>50<\/td>\n                <td>52<\/td>\n                <td>54<\/td>\n                <td>56<\/td>\n                <td>58<\/td>\n            <\/tr>\n            <tr>\n                <td>\u041c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0439 (INT)<\/td>\n                <td>XS<\/td>\n                <td>S<\/td>\n                <td>M<\/td>\n                <td>L<\/td>\n                <td>XL<\/td>\n                <td>XXL<\/td>\n                <td>\u0425\u0425XL<\/td>\n            <\/tr>\n        <\/table>\n    <\/div>\n<\/div>\n\n<div class=\"citata phone_hbg\">\n     \u042f\u043a\u0449\u043e \u0432\u0438\u043d\u0438\u043a\u043d\u0443\u0442\u044c \u0442\u0440\u0443\u0434\u043d\u043e\u0449\u0456 \u0437 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f\u043c \u0440\u043e\u0437\u043c\u0456\u0440\u0443, \u0432\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u0434\u043e \u043d\u0430\u0441 \u0437\u0430 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0456\u0454\u044e:\n     <br>\n     <br>\n     <strong>(068) 503 05 05 | (063) 641 56 99 (\u0442\u0456\u043b\u044c\u043a\u0438 Viber)<\/strong>\n     <br>\n     <br>\n     P.S. \u0417\u0430 8 \u0440\u043e\u043a\u0456\u0432 \u0440\u043e\u0431\u043e\u0442\u0438 \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043b\u0438\u0441\u044f \"\u0437 \u0437\u0430\u043f\u043b\u044e\u0449\u0435\u043d\u0438\u043c\u0438 \u043e\u0447\u0438\u043c\u0430\" \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0442\u0438 \u0440\u043e\u0437\u043c\u0456\u0440 \u0431\u0456\u043b\u0438\u0437\u043d\u0438 \u043d\u0430\u0448\u0438\u0445 \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432 \u0434\u043e 90%, \u0432\u0441\u044c\u043e\u0433\u043e \u0437 \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u043f\u0438\u0442\u0430\u043d\u044c :)\n     <br>\n     <br>\n     <strong>\u0411\u0443\u0434\u0435\u043c\u043e \u0440\u0430\u0434\u0456 \u0432\u0430\u0448\u043e\u043c\u0443 \u0434\u0437\u0432\u0456\u043d\u043a\u0443!<\/strong>\n<\/div>","meta_title":"\u042f\u043a \u0432\u0437\u043d\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u0440\u043e\u0437\u043c\u0456\u0440?","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"10","sort_order":"2","status":"1","language_id":"3","title":"\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430\/\u043e\u043f\u043b\u0430\u0442\u0430","description":"<div id=\"dost_op_w\">\n    <div class=\"row dost_op_w-flex\"> \n        <div class=\"col-lg-4 mb-40\">\n            <img class=\"colimg\" src=\"image\/help\/kurerskaya_dostavka.jpg\" alt=\"\">\n            <div class=\"title_href_w\">\n                <a class=\"title_href btn_pop\" data-effect=\"mfp-zoom-in\" href=\"#kdk\">\u041a\u0443\u0440'\u0454\u0440\u0441\u044c\u043a\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u043e \u041a\u0438\u0454\u0432\u0443<\/a>\n                <!-- Popup itself -->\n                <div id=\"kdk\" class=\"white-popup mfp-with-anim mfp-hide\">\n                    <div class=\"title_sm\"><span>\u0410\u0434\u0440\u0435\u0441\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u043e \u041a\u0438\u0454\u0432\u0443<\/span><\/div>\n\n                    \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0443 \u043c\u0435\u0436\u0430\u0445 \u041a\u0438\u0454\u0432\u0430 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u043f\u0440\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u0456 \u0432\u0456\u0434 1500 \u0433\u0440\u043d.\n                    <br>\n                    <br>\n                    \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043a\u0443\u0440'\u0454\u0440\u043e\u043c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0454\u044e \u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430 \u0437\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430.\n                    <br>\n                    <br>\n                    \u041f\u043e \u041a\u0438\u0454\u0432\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437 10:00 \u0434\u043e 22:00 \u0443 \u0440\u043e\u0431\u043e\u0447\u0456 \u0434\u043d\u0456, \u0437 10:00 \u0434\u043e 19:00 \u0443 \u0441\u0443\u0431\u043e\u0442\u0443.\n                    <br>\n                    <br>\n                    \u041f\u0440\u0438 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u0456 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u043a\u0430\u0436\u0456\u0442\u044c \u0437\u0440\u0443\u0447\u043d\u0438\u0439 \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0447\u0430\u0441, \u0456 \u043c\u0438 \u0437\u0440\u043e\u0431\u0438\u043c\u043e \u0432\u0441\u0435, \u0449\u043e\u0431 \u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0432\u0430\u0448\u0435 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u0447\u0430\u0441\u043d\u043e!\n                    <br>\n                    <br>\n                    \u041d\u0430\u0448\u0456 \u0441\u043f\u0456\u0432\u0440\u043e\u0431\u0456\u0442\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0443\u044e\u0442\u044c \u0446\u0456\u043b\u0456\u0441\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u043d\u0456\u0441\u0442\u044c \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456.\n                <\/div>\n                <!-- end Popup -->\n            <\/div>\n            <div class=\"ob_voz_t\">\n                <ul class=\"ls_none\">\n                    <li>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043a\u0443\u0440'\u0454\u0440\u043e\u043c \u0437\u0430 \u0430\u0434\u0440\u0435\u0441\u043e\u044e - 1-3 \u0434\u043d\u0456 \u0437 \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f<\/li>\n                     <li>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0443 \u0437\u0440\u0443\u0447\u043d\u0438\u0439 \u0434\u043b\u044f \u0432\u0430\u0441 \u0447\u0430\u0441. <\/li>\n                     <li>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043a\u0443\u0440'\u0454\u0440\u043e\u043c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0454\u044e \u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430 \u0437\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430. <\/li>\n                     <li><strong>\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u0456 \u0432\u0456\u0434 1500 \u0433\u0440\u043d<\/strong><\/li>\n                <\/ul>\n            <\/div>\n        <\/div>\n        <div class=\"col-lg-4 mb-40\">\n            <img class=\"colimg\" src=\"image\/help\/novaya_pochta.jpg\" alt=\"\">\n            <div class=\"title_href_w\">\n                <a class=\"title_href btn_pop\" data-effect=\"mfp-zoom-in\" href=\"#npu\">\u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430 \u043f\u043e \u0423\u043a\u0440\u0430\u0457\u043d\u0456 <\/a>\n                <!-- Popup itself -->\n                <div id=\"npu\" class=\"white-popup mfp-with-anim mfp-hide\">\n                    <div class=\"title_sm\"><span>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0443 \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u041d\u043e\u0432\u043e\u0457 \u041f\u043e\u0448\u0442\u0438 \u043f\u043e \u0432\u0441\u0456\u0439 \u0423\u043a\u0440\u0430\u0457\u043d\u0456<\/span><\/div>\n                    \u0417\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u041d\u043e\u0432\u043e\u044e \u041f\u043e\u0448\u0442\u043e\u044e, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0442\u043e\u0432\u0430\u0440 \u043d\u0430\u0432\u0456\u0442\u044c \u0443 \u043d\u0430\u0439\u0432\u0456\u0434\u0434\u0430\u043b\u0435\u043d\u0456\u0448\u0438\u0445 \u043a\u0443\u0442\u043e\u0447\u043a\u0430\u0445 \u0423\u043a\u0440\u0430\u0457\u043d\u0438\n                     <br>\n                     <br>\n                     \u0412 \u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u043c\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0430\u0439\u043c\u0430\u0454 2-4 \u0434\u043d\u0456, \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0456 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u0438 \u0443\u0437\u0433\u043e\u0434\u044f\u0442\u044c \u0437 \u0432\u0430\u043c\u0438 \u0434\u0430\u0442\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043f\u0435\u0440\u0435\u0434 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043a\u043e\u044e \u0442\u043e\u0432\u0430\u0440\u0443.\n                     <br>\n                     <br>\n                     \u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u041d\u043e\u0432\u043e\u044e \u041f\u043e\u0448\u0442\u043e\u044e \u0434\u043e \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430\n                     <br>\n                     <br>\n                     \u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u0456 \u0432\u0456\u0434 1500 \u0433\u0440\u043d\n                <\/div>\n                <!-- end Popup -->\n            <\/div>\n            <div class=\"ob_voz_t\">\n                <ul class=\"ls_none\">\n                    <li>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0434\u043e \u0432\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u041d\u043e\u0432\u043e\u0457 \u041f\u043e\u0448\u0442\u0438 - 2-4 \u0434\u043d\u0456 \u0437 \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f<\/li>\n                     <li>\u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0437\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430<\/li>\n                     <li><strong>\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u0456 \u0432\u0456\u0434 1500 \u0433\u0440\u043d<\/strong><\/li>\n                <\/ul>\n            <\/div>\n        <\/div>\n        <div class=\"col-lg-4 mb-40\">\n            <img class=\"colimg\" src=\"image\/help\/ekspress_dostavka.jpg\" alt=\"\">\n            <div class=\"title_href_w\">\n                <a class=\"title_href btn_pop\" data-effect=\"mfp-zoom-in\" href=\"#edpu\">\u0415\u043a\u0441\u043f\u0440\u0435\u0441 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u043e \u041a\u0438\u0454\u0432\u0443\/\u0423\u043a\u0440\u0430\u0457\u043d\u0456<\/a>\n                <!-- Popup itself -->\n                <div id=\"edpu\" class=\"white-popup mfp-with-anim mfp-hide\">\n                    <div class=\"title_sm\"><span>\u041c\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\u043b\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0434\u0435\u044f\u043a\u0438\u0445 \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 1-2 \u0434\u043d\u0456\u0432.<\/span><\/div>\n                    \u0414\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044c, \u044f\u043a\u0456 \u0442\u043e\u0432\u0430\u0440\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0456 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456-\u0437\u0430\u0432\u0442\u0440\u0430 \u043c\u043e\u0436\u043d\u0430 \u043f\u0435\u0440\u0435\u0439\u0448\u043e\u0432\u0448\u0438 \u0432 \u043a\u0430\u0440\u0442\u043a\u0443 \u0442\u043e\u0432\u0430\u0440\u0443 \u0442\u0430 \u043f\u043e\u0431\u0430\u0447\u0438\u0432\u0448\u0438 \u043f\u0456\u0434\u043f\u0438\u0441 \u201c\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 - \u0435\u043a\u0441\u043f\u0440\u0435\u0441 1-2 \u0434\u043d\u0456\u201d\n                    <img class=\"res_img mt-20 mb-20\" src=\"\/image\/help\/eksprass.jpg\" alt=\"\"\/>\n                    <span class=\"red\">*<\/span>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 - \u0435\u043a\u0441\u043f\u0440\u0435\u0441 1-2 \u0434\u043d\u0456 - \u043e\u0437\u043d\u0430\u0447\u0430\u0454, \u0449\u043e \u0442\u043e\u0432\u0430\u0440\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0456 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456-\u0437\u0430\u0432\u0442\u0440\u0430 \u043f\u043e \u041a\u0438\u0454\u0432\u0443 \u0442\u0430 1-2 \u0434\u043d\u0456 \u043f\u043e \u0423\u043a\u0440\u0430\u0457\u043d\u0456.\n                <\/div>\n                <!-- end Popup -->\n            <\/div>\n            <div class=\"ob_voz_t\">\n                <ul class=\"ls_none\">\n                    <li>\u041c\u043e\u0436\u043b\u0438\u0432\u043e \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u043f\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0445, \u044f\u043a \u201c\u0415\u043a\u0441\u043f\u0440\u0435\u0441 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430\u201d \u0443 \u043a\u0430\u0440\u0442\u0446\u0456 \u0442\u043e\u0432\u0430\u0440\u0443 \u2013 1-2 \u0434\u043d\u0456 \u0437 \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f. <\/li>\n                    \n                    <li><strong>\u0411\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u0456 \u0432\u0456\u0434 1500 \u0433\u0440\u043d<\/strong><\/li>\n                <\/ul>\n            <\/div>\n        <\/div>\n        <div class=\"col-lg-4 mb-40\">\n            <img class=\"colimg\" src=\"image\/help\/samovivoz.jpg\" alt=\"\">\n            <div class=\"title_href_w\">\n                <a class=\"title_href btn_pop\" data-effect=\"mfp-zoom-in\" href=\"#sam\">\u0421\u0430\u043c\u043e\u0432\u0438\u0432\u0456\u0437<\/a>\n                <!-- Popup itself -->\n                <div id=\"sam\" class=\"white-popup mfp-with-anim mfp-hide\">\n                    <div class=\"title_sm\"><span>\u0421\u0430\u043c\u043e\u0432\u0438\u0432\u0456\u0437 \u0456\u0437 \u043f\u0443\u043d\u043a\u0442\u0443 \u0432\u0438\u0434\u0430\u0447\u0456<\/span><\/div>\n                    \u0421\u0430\u043c\u043e\u0432\u0438\u0432\u0456\u0437 \u0442\u043e\u0432\u0430\u0440\u0443 \u0456\u0437 \u043f\u0443\u043d\u043a\u0442\u0443 \u0432\u0438\u0434\u0430\u0447\u0456 \u0437\u0430 \u0430\u0434\u0440\u0435\u0441\u043e\u044e: \u0432\u0443\u043b. \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440\u0441\u044c\u043a\u0430, 18\n                    <br>\n                    <br>\n                    \u041f\u0443\u043a\u0442 \u0456\u0437 \u0432\u0438\u0434\u0430\u0447\u0456 \u0442\u0430 \u0448\u043e\u0443-\u0440\u0443\u043c \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0454. \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u044e \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0454\u044e \u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430.\n                    <!-- \u0412 \u0440\u0430\u0431\u043e\u0447\u0438\u0435 \u0434\u043d\u0438 \u041f\u043d - \u041f\u0442 \u0441 9:00 \u0434\u043e 18:00, \u0421\u0431 \u0438 \u0412\u0441 - \u0432\u044b\u0445\u043e\u0434\u043d\u043e\u0439, \u043f\u043e\u0441\u043b\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u0438\u044f \u0437\u0430\u043a\u0430\u0437\u0430 \u0441 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u043c. -->\n                    <br>\n                    <br>\n                    <strong>\u041e\u043f\u043b\u0430\u0442\u0430: \u0433\u043e\u0442\u0456\u0432\u043a\u0430.<\/strong>\n\n                <\/div>\n                <!-- end Popup -->\n            <\/div>\n            <div class=\"ob_voz_t\">\n                <ul class=\"ls_none\">\n                    <li>\u0421\u0430\u043c\u043e\u0432\u0438\u0432\u0456\u0437 \u0442\u043e\u0432\u0430\u0440\u0443 \u0456\u0437 \u043f\u0443\u043d\u043a\u0442\u0443 \u0432\u0438\u0434\u0430\u0447\u0456 \u0437\u0430 \u0430\u0434\u0440\u0435\u0441\u043e\u044e: \u0432\u0443\u043b. \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440\u0441\u044c\u043a\u0430, 18<\/li>\n                    <li>\u041f\u0443\u043a\u0442 \u0456\u0437 \u0432\u0438\u0434\u0430\u0447\u0456 \u0442\u0430 \u0448\u043e\u0443-\u0440\u0443\u043c \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0454. \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u044e \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0454\u044e \u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430.<\/li>\n                <\/ul>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"title mb-40 mt-20\"><span>\u0421\u043f\u043e\u0441\u043e\u0431\u0438 \u043e\u043f\u043b\u0430\u0442\u0438<\/span><\/div>\n    <div class=\"row\">\n        <div class=\"col-lg-4 mb-40\">\n            <img class=\"colimg\" src=\"image\/help\/nalichnie.jpg\" alt=\"\">\n            <div class=\"title_href_w\">\n                <div class=\"title_href\">\u0413\u043e\u0442\u0456\u0432\u043a\u043e\u044e<\/div>\n            <\/div>\n            <div class=\"ob_voz_t\">\n                <ul class=\"ls_none\">\n                    <li>\u041e\u043f\u043b\u0430\u0442\u0430 \u0433\u043e\u0442\u0456\u0432\u043a\u043e\u044e \u043f\u0440\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u0456 \u0442\u043e\u0432\u0430\u0440\u0443<\/li>\n                     <li>\u041f\u043e \u041a\u0438\u0454\u0432\u0443 \u0442\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0456 - \u043f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u043e\u044e \u041d\u043e\u0432\u043e\u0457 \u041f\u043e\u0448\u0442\u0438 <\/li>\n                     <li>(\u043f\u0440\u0438 \u0441\u043e\u0431\u0456 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u043c\u0430\u0442\u0438 \u043f\u0430\u0441\u043f\u043e\u0440\u0442 \u0430\u0431\u043e \u043f\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043d\u044f \u0432\u043e\u0434\u0456\u044f)<\/li>\n                     <li>(\u043a\u043e\u043c\u0456\u0441\u0456\u044f \u0437\u0430 \u043f\u0456\u0441\u043b\u044f\u043f\u043b\u0430\u0442\u0443 \u043e\u043f\u043b\u0430\u0447\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u043e\u043a\u0443\u043f\u0446\u0435\u043c \u0437\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430)<\/li>\n                <\/ul>\n            <\/div>\n        <\/div>\n        <div class=\"col-lg-4 mb-40\">\n            <img class=\"colimg\" src=\"image\/help\/visa.jpg\" alt=\"\">\n            <div class=\"title_href_w\">\n                <a class=\"title_href btn_pop\" data-effect=\"mfp-zoom-in\" href=\"#vismas\">Visa \u0442\u0430 MasterCard<\/a>\n                <!-- Popup itself -->\n                <div id=\"vismas\" class=\"white-popup mfp-with-anim mfp-hide\">\n                    \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043e\u043d\u043b\u0430\u0439\u043d \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u044e \u043a\u0430\u0440\u0442\u043a\u043e\u044e Visa \u0442\u0430 MasterCard \u0431\u0435\u0437 \u043a\u043e\u043c\u0456\u0441\u0456\u0457.\n                    <br>\n                    <br>\n                    <strong>\u041e\u043f\u043b\u0430\u0442\u0430 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043f\u043b\u0430\u0442\u0456\u0436\u043d\u0438\u0445 \u043a\u0430\u0440\u0442\u043e\u043a \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c:<\/strong>\n                    <br>\n                    \u041f\u0456\u0434 \u0447\u0430\u0441 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u0441\u0430\u0439\u0442\u0456 \u0412\u0430\u043c \u0431\u0443\u0434\u0435 \u0437\u0430\u043f\u0440\u043e\u043f\u043e\u043d\u043e\u0432\u0430\u043d\u043e \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0432\u0438\u0431\u0456\u0440 \u0441\u043f\u043e\u0441\u043e\u0431\u0443 \u043e\u043f\u043b\u0430\u0442\u0438. \u0423 \u0433\u0440\u0430\u0444\u0456 \"\u041e\u043f\u043b\u0430\u0442\u0430\" \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \"Visa\/MasterCard\". \u041f\u0456\u0441\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0412\u0438 \u043f\u0435\u0440\u0435\u0430\u0434\u0440\u0435\u0441\u0443\u0454\u0442\u0435 \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0456\u0432 \u0431\u0430\u043d\u043a\u0443, \u0434\u0435 \u0412\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0431\u0443\u0434\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u043e\u043f\u043b\u0430\u0442\u0443.\n                    <br>\n                    <br>\n                    <small>*\u041e\u043f\u043b\u0430\u0442\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u0430 \u043b\u0438\u0448\u0435 \u043a\u0430\u0440\u0442\u043a\u0430\u043c\u0438, \u0432\u0438\u043f\u0443\u0449\u0435\u043d\u0438\u043c\u0438 \u043d\u0430 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0456\u0457 \u0423\u043a\u0440\u0430\u0457\u043d\u0438<\/small>\n                <\/div>\n                <!-- end Popup -->\n            <\/div>\n            <div class=\"ob_voz_t\">\n                <ul class=\"ls_none\">\n                    <li>\u041e\u043f\u043b\u0430\u0442\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043e\u043d\u043b\u0430\u0439\u043d \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u043e\u044e \u043a\u0430\u0440\u0442\u043a\u043e\u044e Visa \u0442\u0430 MasterCard<\/li>\n                    <li>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0442\u043e\u0432\u0430\u0440\u0443 \u043c\u043e\u0436\u043b\u0438\u0432\u0430 \u043b\u0438\u0448\u0435 \u043f\u0456\u0441\u043b\u044f \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u043b\u0430\u0442\u0435\u0436\u0443.<\/li>\n                <\/ul>\n            <\/div>\n        <\/div>\n    <\/div>\n<\/div>","meta_title":"\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430\/\u043e\u043f\u043b\u0430\u0442\u0430","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"6","sort_order":"2","status":"1","language_id":"3","title":"\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435","description":"&lt;p&gt;\r\n\t\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435&lt;\/p&gt;\r\n","meta_title":"\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"8","sort_order":"3","status":"1","language_id":"3","title":"\u041e\u0431\u043c\u0456\u043d\/\u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f","description":"\u0422\u043e\u0432\u0430\u0440, \u044f\u043a\u0438\u0439 \u0432\u0430\u043c \u043d\u0435 \u043f\u0456\u0434\u0456\u0439\u0448\u043e\u0432 \u0447\u0438 \u043c\u0430\u0454 \u0432\u0438\u0440\u043e\u0431\u043d\u0438\u0447\u0438\u0439 \u0431\u0440\u0430\u043a, \u043c\u0438 \u043c\u043e\u0436\u0435\u043c\u043e \u043e\u0431\u043c\u0456\u043d\u044f\u0442\u0438 \u043d\u0430 \u0456\u043d\u0448\u0438\u0439 \u0430\u0431\u043e \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043c\u043e \u0433\u0440\u043e\u0448\u0456.\n<div class=\"clearfix\"><\/div>\n<div class=\"citata_dash exchange mt-30\">\n    <strong>14 \u0434\u043d\u0456\u0432 \u043d\u0430 \u043e\u0431\u043c\u0456\u043d \u0442\u0430 \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f<\/strong>\n    <br>\n    \u041f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f\/\u043e\u0431\u043c\u0456\u043d \u0442\u043e\u0432\u0430\u0440\u0443 \u043c\u043e\u0436\u043b\u0438\u0432\u0435 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 14 \u0434\u043d\u0456\u0432 \u043f\u0456\u0441\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f.\n<\/div>\n<div class=\"clearfix\"><\/div>\n\n\n<div class=\"title_sm mt-20\"><span>\u041f\u0440\u0438\u043c\u0456\u0440\u044f\u0439\u0442\u0435 \u0431\u0456\u043b\u0438\u0437\u043d\u0443<\/span><\/div>\n<div class=\"art_img\">\n    <img src=\"image\/help\/primerayite_belio.jpg\" alt=\"\">\n<\/div>\n\n<span class=\"red\">\u041e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e!:<\/span> \u043f\u0440\u0438\u043c\u0456\u0440\u044f\u0442\u0438 \u043d\u0438\u0436\u043d\u044e \u0431\u0456\u043b\u0438\u0437\u043d\u0443 \u0442\u0430 \u043f\u043b\u0430\u0432\u0430\u043b\u044c\u043d\u0438\u0439 \u043e\u0434\u044f\u0433 \u043f\u043e\u0432\u0435\u0440\u0445 \u0441\u0432\u043e\u0454\u0457 \u0431\u0456\u043b\u0438\u0437\u043d\u0438, \u0434\u043e\u043a\u0438 \u043d\u0435 \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0442\u043e\u0432\u0430\u0440 \u043f\u0456\u0434\u0445\u043e\u0434\u0438\u0442\u044c. \u041f\u043e\u0442\u0456\u043c \u0432\u0438\u0434\u0430\u043b\u044f\u0439\u0442\u0435 \u0431\u0438\u0440\u043a\u0438, \u0435\u0442\u0438\u043a\u0435\u0442\u043a\u0438.\n<br>\n<br>\n<strong>\u041f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f\/\u043e\u0431\u043c\u0456\u043d \u0442\u043e\u0432\u0430\u0440\u0443 \u043d\u0430\u043b\u0435\u0436\u043d\u043e\u0457 \u044f\u043a\u043e\u0441\u0442\u0456 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f<\/strong>\n<br>\n(\u0421\u0442\u0430\u0442\u0442\u044f 9. \u0417\u0430\u043a\u043e\u043d\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u00ab\u041f\u0440\u043e \u0437\u0430\u0445\u0438\u0441\u0442 \u043f\u0440\u0430\u0432 \u0441\u043f\u043e\u0436\u0438\u0432\u0430\u0447\u0456\u0432\u00bb):\n\n<div class=\"mt-10\">\n    - \u044f\u043a\u0449\u043e \u0432\u0456\u043d \u043d\u0435 \u0431\u0443\u0432 \u0443 \u0432\u0436\u0438\u0442\u043a\u0443; <br>\n     - \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0442\u043e\u0432\u0430\u0440\u043d\u0438\u0439 \u0432\u0438\u0433\u043b\u044f\u0434 (\u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456 \u043f\u043b\u044f\u043c\u0438, \u0437\u0430\u0447\u0456\u043f\u043a\u0438 \u0442\u0430 \u0456\u043d.);<br>\n     - \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0446\u0456\u043b\u0456\u0441\u043d\u0456\u0441\u0442\u044c \u0435\u0442\u0438\u043a\u0435\u0442\u043e\u043a, \u0431\u0456\u0440\u043e\u043a, \u044f\u0440\u043b\u0438\u043a\u0456\u0432, \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u043e\u0457 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0438;\n<\/div>\n\n<div class=\"clearfix\"><\/div>\n<div class=\"citata mt-40 mb-40\">\n    <strong>\u0412\u0430\u0436\u043b\u0438\u0432\u043e!<\/strong> <br>\n     \u0414\u041b\u042f \u041d\u0418\u0416\u041d\u042c\u041e\u0407 \u0411\u0406\u041b\u0418\u0417\u041d\u0418, \u041e\u0414\u042f\u0413\u0423 \u0414\u041b\u042f \u041f\u041b\u0410\u0412\u0410\u041d\u041d\u042f \u0406 \u041f\u0410\u041d\u0427\u0406\u0428\u041d\u041e-\u0428\u041a\u0410\u0420\u041f\u0415\u0422\u041d\u0418\u0425 \u0412\u0418\u0420\u041e\u0411\u0406\u0412 \u041c\u041e\u0416\u041b\u0418\u0412\u0418\u0419 \u0422\u0406\u041b\u042c\u041a\u0418 \u041e\u0411\u041c\u0406\u041d.\n     <br>\n     \u0414\u041b\u042f \u041e\u0414\u042f\u0413\u0423 \u0406 \u0412\u0415\u0420\u0425\u041d\u042c\u041e\u0413\u041e \u0422\u0420\u0418\u041a\u041e\u0422\u0410\u0416\u0423 \u041c\u041e\u0416\u041b\u0418\u0412\u0418\u0419 \u041e\u0411\u041c\u0406\u041d \u0410\u0411\u041e \u041f\u041e\u0412\u0415\u0420\u041d\u0415\u041d\u041d\u042f \u0413\u0420\u041e\u0428\u0415\u0419.\n<\/div>\n<div class=\"clearfix\"><\/div>\n\n<div class=\"row ob_voz\">\n\n    <div class=\"col-lg-4 mb-40\">\n        <img class=\"raz_img2\" src=\"image\/help\/obmen_vozvrat_belia.jpg\" alt=\"\">\n        <div class=\"title_sm\"><span>\u041e\u0431\u043c\u0456\u043d\/\u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f \u0431\u0456\u043b\u0438\u0437\u043d\u0438<\/span><\/div>\n        <div class=\"ob_voz_t\">\n            \u041c\u0438 \u0437\u043d\u0430\u0454\u043c\u043e \u043f\u043e \u0441\u043e\u0431\u0456, \u0449\u043e \u0456\u043d\u043e\u0434\u0456 \u0431\u0443\u0432\u0430\u0454 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c \u0432\u0438\u0431\u043e\u0440\u0443 \u043e\u0434\u044f\u0433\u0443 \u0447\u0435\u0440\u0435\u0437 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442, \u043d\u0430\u0432\u0456\u0442\u044c \u043a\u043e\u043b\u0438 \u043d\u0430\u0447\u0435\u0431\u0442\u043e \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u0456\u0434\u0456\u0431\u0440\u0430\u043b\u0438 \u0440\u043e\u0437\u043c\u0456\u0440. \u0422\u043e\u043c\u0443 \u043c\u0438 \u0433\u043e\u0442\u043e\u0432\u0456 \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u0442\u0438 \u043e\u0431\u043c\u0456\u043d \u0442\u043e\u0432\u0430\u0440\u0456\u0432, \u0449\u043e \u043d\u0435 \u043f\u0456\u0434\u0456\u0439\u0448\u043b\u0438, \u0437 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u0437\u0443\u0441\u0438\u043b\u043b\u044f\u043c\u0438 \u0434\u043b\u044f \u0432\u0430\u0441.\n            <br>\n            <br>\n            \u041f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0434\u0456\u0448\u043b\u0456\u0442\u044c \u043d\u0430\u043c \u0442\u043e\u0432\u0430\u0440\u0438, \u044f\u043a\u0456 \u0431\u0430\u0436\u0430\u0454\u0442\u0435 \u043e\u0431\u043c\u0456\u043d\u044f\u0442\u0438 (<a href=\"<?php echo $this->url->link('information\/information', 'information_id=14'); ?>\">\u0430\u0434\u0440\u0435\u0441\u0430 \u0434\u043b\u044f \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043a\u0438<\/a>).\n            <br>\n            <br>\n            \u041f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f \u043d\u0438\u0436\u043d\u044c\u043e\u0457 \u0431\u0456\u043b\u0438\u0437\u043d\u0438, \u043e\u0434\u044f\u0433\u0443 \u0434\u043b\u044f \u043f\u043b\u0430\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u0430\u043d\u0447\u0456\u0448\u043d\u043e-\u0448\u043a\u0430\u0440\u043f\u0435\u0442\u043a\u043e\u0432\u0438\u0445 \u0432\u0438\u0440\u043e\u0431\u0456\u0432 \u0437\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u043e \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u043e\u043c \u0423\u043a\u0440\u0430\u0457\u043d\u0438 (\n            <a href=\"\/postanova_pro_obmen.doc\" target=\"_blank\">\u0434\u0438\u0432.\u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0443 \u041a\u0430\u0431\u0456\u043d\u0435\u0442\u0443 \u041c\u0456\u043d\u0456\u0441\u0442\u0440\u0456\u0432<\/a>).\n        <\/div>\n    <\/div>\n\n    <div class=\"col-lg-4 mb-40\">\n        <img class=\"raz_img2\" src=\"image\/help\/obmen_vozvrat_odegdi.jpg\" alt=\"\">\n        <div class=\"title_sm\"><span>\u041e\u0431\u043c\u0456\u043d\/\u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f \u043e\u0434\u044f\u0433\u0443<\/span><\/div>\n        <div class=\"ob_voz_t\">\n            \u0414\u043b\u044f \u0442\u0440\u0438\u043a\u043e\u0442\u0430\u0436\u0443: \u043c\u0430\u0439\u043e\u043a, \u0444\u0443\u0442\u0431\u043e\u043b\u043e\u043a, \u043e\u0434\u044f\u0433 \u0434\u043b\u044f \u0441\u043d\u0443 \u2014 \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u043e\u0431\u043c\u0456\u043d \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u0442\u043e\u0432\u0430\u0440 \u0443 \u043d\u0430\u0448\u043e\u043c\u0443 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0456 \u0430\u0431\u043e \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f \u0433\u0440\u043e\u0448\u0435\u0439.\n        <\/div>\n    <\/div>\n\n    <div class=\"col-lg-4 mb-40\">\n        <img class=\"raz_img2\" src=\"image\/help\/stoimost_obmena_vozvrata.jpg\" alt=\"\">\n        <div class=\"title_sm\"><span>\u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u043e\u0431\u043c\u0456\u043d\u0443\/\u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f<\/span><\/div>\n        <div class=\"ob_voz_t\">\n             <strong>\u0414\u043b\u044f \u0423\u043a\u0440\u0430\u0457\u043d\u0438<\/strong> \u2013 \u041d\u041e\u0412\u0410 \u041f\u041e\u0428\u0422\u0410 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0437\u0456 3-\u0445 \u0434\u043d\u0456\u0432. \u0417\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430<br><br>\n             <strong>\u0414\u043b\u044f \u041a\u0438\u0454\u0432\u0430 <\/strong> \u2013 \u043a\u0443\u0440'\u0454\u0440\u043e\u043c \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456-\u0437\u0430\u0432\u0442\u0440\u0430. \u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c: 50 \u0433\u0440\u043d.<br><br>\n             <strong>\u0421\u0430\u043c\u043e\u043e\u0431\u043c\u0456\u043d<\/strong> - \u0432\u0443\u043b. \u0412\u043e\u043b\u043e\u0434\u0438\u043c\u0438\u0440\u0441\u044c\u043a\u0430, 18\/2 \u043e\u0444\u0456\u0441 45<br><br>\n             <strong>\u0420\u0435\u0436\u0438\u043c \u0440\u043e\u0431\u043e\u0442\u0438:<\/strong> \u041f\u043d - \u041f\u0442 \u0437 9:00 \u0434\u043e 18:00, \u0421\u0431 \u0442\u0430 \u041d\u0434 - \u0432\u0438\u0445\u0456\u0434\u043d\u0438\u0439\n        <\/div>\n    <\/div>\n\n<\/div>\n\n\n\n\n\n<div class=\"title_sm\"><span>\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0431\u043c\u0456\u043d\u0443\/\u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f<\/span><\/div>\n\n<div class=\"citata\">\n    <ul class=\"ls_none\">\n        <li>\n            <strong>1.<\/strong> \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u0443 \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f\/\u043e\u0431\u043c\u0456\u043d\u0443 \u0430\u0431\u043e \u043b\u0438\u0441\u0442\u043e\u043c \u043f\u043e e-mail: <a href=\"mailto:info@manline.com.ua\">info@manline.com.ua<\/a><\/strong>\n        <\/li>\n        <li>\n            <strong>2.<\/strong> \u0414\u043b\u044f \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u043d\u0430 \u043e\u0431\u043c\u0456\u043d, \u043e\u0444\u043e\u0440\u043c\u043b\u044e\u0439\u0442\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0456 \u043d\u043e\u0432\u0435 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u0432\u043a\u0430\u0437\u0443\u0439\u0442\u0435 \u0443 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u044f\u0445 \u201c\u0417\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u043e\u0431\u043c\u0456\u043d\u201d.\n\n        <\/li>\n        <li>\n            <strong>3.<\/strong> \u042f\u043a\u0449\u043e \u0441\u0443\u043c\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0431\u0456\u043b\u044c\u0448\u0430 \u0437\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0454 \u2014 \u043c\u0438 \u0432\u0438\u0441\u0442\u0430\u0432\u0438\u043c\u043e \u0440\u0430\u0445\u0443\u043d\u043e\u043a \u043d\u0430 \u0434\u043e\u043f\u043b\u0430\u0442\u0443.\n\n        <\/li>\n        <li>\n            <strong>4.<\/strong> \u042f\u043a\u0449\u043e \u043c\u0435\u043d\u0448\u0435 \u2014 \u0433\u0440\u043e\u0448\u0456 \u0431\u0443\u0434\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0456 \u043d\u0430 \u0432\u0430\u0448\u0443 \u043a\u0430\u0440\u0442\u043a\u0443, \u0433\u043e\u0442\u0456\u0432\u043a\u043e\u044e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043a\u0443\u0440'\u0454\u0440\u043e\u043c \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u0430\u0431\u043e \u0443 \u043d\u0430\u0441 \u0432 \u043e\u0444\u0456\u0441\u0456.\n\n        <\/li>\n    <\/ul>\n<\/div>","meta_title":"\u041e\u0431\u043c\u0456\u043d\/\u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"5","sort_order":"4","status":"1","language_id":"3","title":"\u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0441\u043e\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f","description":"&lt;p&gt;\r\n\t\u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0441\u043e\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f&lt;\/p&gt;\r\n","meta_title":"\u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0441\u043e\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f","meta_description":"","meta_keyword":"","store_id":"0"}]