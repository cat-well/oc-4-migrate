[{"information_id":"18","sort_order":"0","status":"1","language_id":"3","title":"\u0412\u0430\u043a\u0430\u043d\u0441\u0438\u0438","description":"&lt;p&gt;\r\n\t&lt;span id=&quot;docs-internal-guid-7e620ca6-850a-642f-b9b9-80de933a1d67&quot;&gt;&lt;span style=&quot;font-size: 14.6667px; font-family: Arial; color: rgb(0, 0, 0); vertical-align: baseline; white-space: pre-wrap; background-color: transparent;&quot;&gt;\u0432\u0430\u043a\u0430\u043d\u0441\u0438\u0438&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\r\n","meta_title":"\u0412\u0430\u043a\u0430\u043d\u0441\u0438\u0438","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"16","sort_order":"0","status":"1","language_id":"3","title":"\u0412\u0456\u0434\u0433\u0443\u043a\u0438","description":"<div class=\"citata\"><!--seo_text_start-->\n            <strong>\u041c\u0438, \u044f\u043a \u0456 \u0432\u0438, \u043b\u044e\u0431\u0438\u043c\u043e \u0447\u0435\u0441\u043d\u0456 \u0432\u0456\u0434\u0433\u0443\u043a\u0438. \u041c\u0438 \u043d\u0435 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0456, \u0430\u043b\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043c\u043e \u0446\u044c\u043e\u0433\u043e \u0437 \u0432\u0430\u0448\u043e\u044e \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e.<\/strong>\n            <br>\n            \u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c, \u0449\u043e \u0432\u0430\u043c \u0441\u043f\u043e\u0434\u043e\u0431\u0430\u043b\u043e\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u043a\u0443\u043f\u043a\u0430\u0445, \u0456 \u0449\u043e \u0432\u0438 \u0445\u043e\u0442\u0456\u043b\u0438 \u0431 \u043f\u043e\u043b\u0456\u043f\u0448\u0438\u0442\u0438 \u0432 \u043d\u0430\u0448\u0438\u0445 \u0432\u0437\u0430\u0454\u043c\u0438\u043d\u0430\u0445.\n        <!--seo_text_end--><\/div>\n\n\n        <div class=\"row mt-40\">\n            <div class=\"col-md-6\">\n                <script type=\"text\/javascript\" src=\"\/\/vk.com\/js\/api\/openapi.js?112\"><\/script>\n\n                <script type=\"text\/javascript\">\n                    VK.init({apiId: 3831900, onlyWidgets: true});\n                <\/script>\n                <div id=\"vk_comments\">\n                    <script type=\"text\/javascript\">\n                        VK.Widgets.Comments(\"vk_comments\", {limit: 20, width: \"\", attach: \"*\"});\n                    <\/script><\/div>\n            <\/div>\n            <div class=\"col-md-6\">\n                <div id=\"hypercomments_widget\"><\/div>\n                <script type=\"text\/javascript\">\n                    _hcwp = window._hcwp || [];\n                    _hcwp.push({widget:\"Stream\", widget_id: 79564});\n                    (function() {\n                        if(\"HC_LOAD_INIT\" in window)return;\n                        HC_LOAD_INIT = true;\n                        var lang = (navigator.language || navigator.systemLanguage || navigator.userLanguage || \"en\").substr(0, 2).toLowerCase();\n                        var hcc = document.createElement(\"script\"); hcc.type = \"text\/javascript\"; hcc.async = true;\n                        hcc.src = (\"https:\" == document.location.protocol ? \"https\" : \"http\")+\":\/\/w.hypercomments.com\/widget\/hc\/79564\/\"+lang+\"\/widget.js\";\n                        var s = document.getElementsByTagName(\"script\")[0];\n                        s.parentNode.insertBefore(hcc, s.nextSibling);\n                    })();\n                <\/script>\n            <\/div>\n        <\/div>\n","meta_title":"\u0412\u0456\u0434\u0433\u0443\u043a\u0438","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"7","sort_order":"0","status":"1","language_id":"3","title":"\u0412\u0456\u0434\u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f","description":"&lt;p&gt;\r\n\totslidit-zakaz&lt;\/p&gt;\r\n","meta_title":"\u0412\u0456\u0434\u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"14","sort_order":"0","status":"1","language_id":"3","title":"\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u0438","description":"<div class=\"row conta_w mb-60\">\n    <div class=\"col-lg-7\">\n        <div class=\"row\">\n            <div class=\"col-md-6 cont_w_in\">\n                <div class=\"sm_title cont1\">\u0417\u0430\u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443\u0439\u0442\u0435 \u043d\u0430\u043c<\/div>\n                <div class=\"cont_text ringo_phone\">\n                    <a class=\"tel_mob\" href=\"tel:068 503 05 05\">(068) 503 05 05<\/a> <br>\n                    <a class=\"tel_mob\" href=\"tel:063 641 56 99\">(063) 641 56 99 <\/a><span> (\u0442\u0456\u043b\u044c\u043a\u0438 Viber)<\/span><br>\n\n                <\/div>\n            <\/div>\n            <div class=\"col-md-6 cont_w_in\">\n                <div class=\"sm_title cont4\">\u041f\u0443\u043d\u043a\u0442 \u0456\u0437 \u0432\u0438\u0434\u0430\u0447\u0456<\/div>\n                <div class=\"cont_text\">\n                    \u041f\u0443\u043a\u0442 \u0456\u0437 \u0432\u0438\u0434\u0430\u0447\u0456 \u0442\u0430 \u0448\u043e\u0443-\u0440\u0443\u043c \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u0454. \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u044e \u043a\u043e\u043c\u043f\u0430\u043d\u0456\u0454\u044e \u041d\u043e\u0432\u0430 \u041f\u043e\u0448\u0442\u0430.\n                <\/div>\n            <\/div>\n            <div class=\"clearfix\"><\/div>\n            <div class=\"col-md-6 cont_w_in\">\n                <div class=\"sm_title cont2\">\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043d\u0430\u043c<\/div>\n                <div class=\"cont_text\">\n                    <a href=\"mailto:info@manline.com.ua\">info@manline.com.ua<\/a>\n                <\/div>\n            <\/div>\n            <div class=\"col-md-6 cont_w_in\">\n                <div class=\"sm_title cont3\">\u0420\u0435\u0436\u0438\u043c \u0440\u043e\u0431\u043e\u0442\u0438:<\/div>\n                <div class=\"cont_text\">\n                    \u041f\u043d - \u041f\u0442 \u0437 9:00 \u0434\u043e 18:00\n                     <br>\n                     \u0421\u0431 \u0456 \u041d\u0434 - \u0432\u0438\u0445\u0456\u0434\u043d\u0438\u0439\n                <\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"col-lg-5 lg_hid\">\n        <script type=\"text\/javascript\" src=\"http:\/\/maps.google.com\/maps\/api\/js?key=AIzaSyAhDcmcmrKOV8oTxHNr3TrVkaTbe33H5Jk\"><\/script>\n        <script>\n            var stockholm2 = new google.maps.LatLng(50.4570047, 30.3958549);\n            var parliament2 = new google.maps.LatLng(50.4570047, 30.3958549);\n            var marker2;\n            var map2;\n            var contentString2 = '<div id=\"content\">' +\n                '<div id=\"siteNotice\">' +\n                '<\/div>' +\n                '<div id=\"bodyContent\">' +\n                '\u0433. \u041a\u0438\u0435\u0432, \u0443\u043b. \u0427\u0438\u0441\u0442\u044f\u043a\u043e\u0432\u0441\u043a\u0430\u044f, 2 (\u043c\u0435\u0442\u0440\u043e \u0421\u0432\u044f\u0442\u043e\u0448\u0438\u043d)' +\n                '<\/div>' +\n                '<\/div>';\n\n            function initialize2() {\n                var mapOptions2 = {\n                    zoom: 15,\n                    center: stockholm2,\n                    scrollwheel: false\n                };\n                var infowindow = new google.maps.InfoWindow({\n                    content: contentString2\n                });\n                map2 = new google.maps.Map(document.getElementById('map-kont'),\n                    mapOptions2);\n\n                marker2 = new google.maps.Marker({\n                    map: map2,\n                    draggable: true,\n                    position: parliament2,\n                    title: \"ManLine\"\n                });\n                infowindow.open(map2, marker2);\n            }\n\n\n            google.maps.event.addDomListener(window, 'load', initialize2);\n        <\/script>\n        <div class=\"map_wrapper\">\n            <div id=\"map-kont\"><\/div>\n        <\/div>\n    <\/div>\n<\/div>\n\n<div class=\"title_sm mb-40\"><span>\u0417\u0430\u0434\u0430\u0442\u0438 \u043f\u0438\u0442\u0430\u043d\u043d\u044f<\/span><\/div>\n<form action=\"\" method=\"post\" class=\"contactform kont_form\">\n    <div class=\"success_polt\"><\/div>\n\n    <div class=\"row\">\n        <div class=\"col-md-2\"><label for=\"name\"><span class=\"red\">*<\/span> \u0406\u043c'\u044f<\/label><\/div>\n        <div class=\"col-md-10\">\n            <input type=\"text\" required=\"\" data-label=\"\u0415\u0432\u0433\u0435\u043d\u0456\u0439\" value=\"\" placeholder=\"\u0412\u0430\u0448\u0435 \u0456\u043c'\u044f\" name=\"name_polt[]\" class=\"name_inp\" id=\"name\">\n        <\/div>\n    <\/div>\n\n    <div class=\"row\">\n        <div class=\"col-md-2\"><label for=\"mail\"><span class=\"red\">*<\/span> Email<\/label><\/div>\n        <div class=\"col-md-10\">\n            <input type=\"text\" required=\"\" data-label=\"\u0415\u0432\u0433\u0435\u043d\u0456\u0439\" value=\"\" placeholder=\"Email\" name=\"mail_polt[]\" class=\"name_inp\" id=\"mail\">\n        <\/div>\n    <\/div>\n    <div class=\"row\">\n        <div class=\"col-md-2\"><label for=\"phone\"><span class=\"red\">*<\/span> \u0422\u0435\u043b\u0435\u0444\u043e\u043d<\/label><\/div>\n        <div class=\"col-md-10\">\n            <input type=\"text\" required=\"\" data-label=\"\u0415\u0432\u0433\u0435\u043d\u0456\u0439\" value=\"\" placeholder=\"\u0412\u0430\u0448 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\" name=\"name_polt[]\" class=\"name_inp\" id=\"phone\">\n        <\/div>\n    <\/div>\n    <div class=\"row\">\n        <div class=\"col-md-2\"><label for=\"text\">\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f<\/label><\/div>\n        <div class=\"col-md-10\">\n            <textarea name=\"text_polt[]\" data-label=\"\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f\" id=\"text\" cols=\"30\" rows=\"10\"><\/textarea>\n        <\/div>\n    <\/div>\n    <div class=\"row\">\n        <div class=\"col-md-10 col-md-offset-2\">\n            <input type=\"hidden\" value=\"\u0417\u0430\u0434\u0430\u0442\u0438 \u043f\u0438\u0442\u0430\u043d\u043d\u044f \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u0443\" data-label=\"\u0418\u0437 \u0444\u043e\u0440\u043c\u044b\" size=\"50\" class=\"zakaz_from not_clear\">\n            <input type=\"hidden\" value=\"\" name=\"site_page_polt[]\" data-label=\"\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430\" size=\"50\" class=\"site_page_polt\">\n            <input type=\"submit\" value=\"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f\" name=\"submit_polt\" class=\"btn submit button\">\n        <\/div>\n    <\/div>\n\n\n<\/form>","meta_title":"\u041a\u043e\u043d\u0442\u0430\u043a\u0442\u0438","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"11","sort_order":"0","status":"1","language_id":"3","title":"\u041c\u043e\u0434\u0435\u043b\u0456 \u043d\u0430 \u0432\u0438\u0431\u0456\u0440","description":"<div class=\"mt-40\">\n    <div class=\"art_img\">\n        <img src=\"image\/help\/modeli_na_vibor.jpg\" alt=\"\">\n    <\/div>\n    \u041d\u0430\u0448 \u043a\u0443\u0440'\u0454\u0440 \u043f\u0440\u0438\u0432\u0435\u0437\u0435 \u0432\u0430\u043c \u043d\u0430 \u0432\u0438\u0431\u0456\u0440 \u0434\u043e 7 \u043e\u0434\u0438\u043d\u0438\u0446\u044c \u043d\u0438\u0436\u043d\u044c\u043e\u0457 \u0431\u0456\u043b\u0438\u0437\u043d\u0438 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0449\u043e\u0431 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0442\u0438\u0441\u044f \u0432 \u044f\u043a\u043e\u0441\u0442\u0456 \u043f\u0440\u043e\u043f\u043e\u043d\u043e\u0432\u0430\u043d\u0438\u0445 \u043d\u0430\u043c\u0438 \u0442\u043e\u0432\u0430\u0440\u0456\u0432, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0437\u043c\u043e\u0433\u043b\u0438 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0456 \u043a\u043e\u043b\u044c\u043e\u0440\u0438 \u0442\u0430 \u0440\u043e\u0437\u043c\u0456\u0440.\n    <br>\n    <br>\n    \u0417\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0431\u0443\u0434\u0435 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0443 \u0432\u043a\u0430\u0437\u0430\u043d\u0435 \u043c\u0456\u0441\u0446\u0435 \u0442\u0430 \u0447\u0430\u0441 \u043a\u0443\u0440'\u0454\u0440\u043e\u043c \u043f\u0456\u0441\u043b\u044f \u043f\u043e\u0433\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0437 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u043c.\n    <br>\n    <br>\n    \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u0430 \u0443 \u0432\u0438\u0445\u0456\u0434\u043d\u0456 \u0434\u043d\u0456 \u0442\u0430 \u0432\u0435\u0447\u0456\u0440\u043d\u0456 \u0433\u043e\u0434\u0438\u043d\u0438 \u0434\u043e 20:00.\n    <br>\n    <div class=\"citata_dash\">\n        \u0423 \u0440\u0430\u0437\u0456 \u043f\u043e\u0432\u043d\u043e\u0457 \u0432\u0456\u0434\u043c\u043e\u0432\u0438 \u0432\u0456\u0434 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0446\u0456\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u2013 50 \u0433\u0440\u043d.\n    <\/div>\n\n<\/div>","meta_title":"\u041c\u043e\u0434\u0435\u043b\u0456 \u043d\u0430 \u0432\u0438\u0431\u0456\u0440","meta_description":"","meta_keyword":"","store_id":"0"},{"information_id":"12","sort_order":"0","status":"1","language_id":"3","title":"\u041f\u043e\u0434\u0430\u0440\u0443\u043d\u043a\u043e\u0432\u0456 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0438","description":"\n\u0412\u0441\u0456 \u043c\u0438 \u0437\u043d\u0430\u0454\u043c\u043e, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u043f\u0440\u0438\u0454\u043c\u043d\u043e \u0440\u043e\u0431\u0438\u0442\u0438 \u043f\u043e\u0434\u0430\u0440\u0443\u043d\u043a\u0438 \u0434\u0440\u0443\u0437\u044f\u043c \u0442\u0430 \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u0442\u0438 \u0443 \u0457\u0445\u043d\u0456 \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u043d\u044f.\n<br>\n<br>\n\u0410\u043b\u0435 \u0442\u0443\u0442 \u0454 \u0440\u0438\u0437\u0438\u043a \u043f\u043e\u043c\u0438\u043b\u0438\u0442\u0438\u0441\u044f \u0432 \u0434\u0435\u0442\u0430\u043b\u044f\u0445 \u0442\u0430 \u043d\u0435\u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438\u0445 \u0431\u0430\u0436\u0430\u043d\u043d\u044f\u0445, \u043d\u0430\u0432\u0456\u0442\u044c \u043a\u043e\u043b\u0438 \u0432\u0438 \u0434\u043e\u0431\u0440\u0435 \u0437\u043d\u0430\u0454\u0442\u0435 \u043b\u044e\u0434\u0438\u043d\u0443.\n\u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e \u0436, \u0432\u0430\u043c \u0431\u0443\u0434\u0443\u0442\u044c \u0449\u0438\u0440\u043e \u0432\u0434\u044f\u0447\u043d\u0456, \u0430\u043b\u0435 \u0437\u0430\u0434\u043e\u0432\u043e\u043b\u0435\u043d\u043d\u044f \u0432\u0456\u0434 \u043f\u043e\u0434\u0430\u0440\u0443\u043d\u043a\u0430 \u0431\u0443\u0434\u0435 \u043d\u0435 \u043f\u043e\u0432\u043d\u0438\u043c.\n<br>\n<br>\n\u041f\u043e\u0434\u0430\u0440\u0443\u0432\u0430\u0432\u0448\u0438 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442, \u0432\u0438 \u0442\u043e\u0447\u043d\u043e \u043c\u043e\u0436\u0435\u0442\u0435 \u0431\u0443\u0442\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u043b\u044e\u0434\u0438\u043d\u0430 \u0432\u0438\u0431\u0435\u0440\u0435 \u043d\u0430\u0439\u0431\u0430\u0436\u0430\u043d\u0456\u0448\u0435 \u0437\u0430\u0431\u0430\u0440\u0432\u043b\u0435\u043d\u043d\u044f \u0439\u043e\u0433\u043e \u0443\u043b\u044e\u0431\u043b\u0435\u043d\u0438\u0445 \u0441\u0456\u043c\u0435\u0439\u043e\u043a \u0456 \u043f\u043e-\u0434\u043e\u0431\u0440\u043e\u043c\u0443 \u0437\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438\u043c\u0435 \u0432\u0430\u0441 \u0456 \u0432\u0430\u0448 \u043f\u043e\u0434\u0430\u0440\u0443\u043d\u043e\u043a :)\n\n<br>\n<br>\n<div class=\"citata\">\n   \u0412\u0438\u0437\u043d\u0430\u0447\u0438\u0432\u0448\u0438\u0441\u044c \u0456\u0437 \u043d\u043e\u043c\u0456\u043d\u0430\u043b\u043e\u043c \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0430, \u043e\u0444\u043e\u0440\u043c\u043b\u044e\u0439\u0442\u0435 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u0441\u0430\u0439\u0442\u0456 \u0430\u0431\u043e \u0437\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u043c. \u0421\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0438 \u043f\u0440\u043e\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u0437\u0430 \u0457\u0445\u043d\u044c\u043e\u044e \u043d\u043e\u043c\u0456\u043d\u0430\u043b\u044c\u043d\u043e\u044e \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044e. \u0422\u0435\u0440\u043c\u0456\u043d \u0434\u0456\u0457 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0430 6 \u043c\u0456\u0441\u044f\u0446\u0456\u0432 \u0456\u0437 \u043c\u043e\u043c\u0435\u043d\u0442\u0443 \u043f\u043e\u043a\u0443\u043f\u043a\u0438.\n<\/div>\n\n\n<div class=\"title_sm mt-40\"><span>\u0424\u043e\u0442\u043e \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0456\u0432<\/span><\/div>\n<div class=\"row mb-30\">\n    <div class=\"col-md-6 sertif_item\">\n        <a href=\"<?php echo $this->url->link('product\/product', 'product_id=895'); ?>\">\n            <img src=\"image\/help\/250.png\" alt=\"\" class=\"res_img\"\/>\n        <\/a>\n    <\/div>\n    <div class=\"col-md-6 sertif_item\">\n        <a href=\"<?php echo $this->url->link('pr