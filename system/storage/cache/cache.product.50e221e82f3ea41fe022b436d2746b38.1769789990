0\u044f \u0437\u0430\u0441\u0442\u0435\u0436\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u043a &quot;\u0442\u0435\u043b\u0443&quot; \u0441\u0443\u043c\u043a\u0438 \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u0430\u0440\u0430\u0431\u0438\u043d\u043e\u0432 \u0438 \u043f\u043e\u043b\u0443\u043a\u043e\u043b\u0435\u0446.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u0418\u0437\u0434\u0435\u043b\u0438\u0435 \u0438\u043c\u0435\u0435\u0442 \u0434\u0432\u0435 \u0440\u0443\u0447\u043a\u0438 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430 \u0441\u0443\u043c\u043a\u0438 \u0432 \u0440\u0443\u043a\u0435.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u0412 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u043a \u0441\u0443\u043c\u043a\u0435 \u043f\u0440\u0438\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u0441\u044a\u0435\u043c\u043d\u044b\u0439 \u043f\u043b\u0435\u0447\u0435\u0432\u043e\u0439 \u0440\u0435\u043c\u0435\u043d\u044c. \u0414\u043b\u0438\u043d\u0430 \u0440\u0435\u043c\u043d\u044f \u043c\u043e\u0436\u0435\u0442 \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u043c\u0435\u0442\u0430\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u044f\u0436\u043a\u0438 (\u043e\u0442 76 \u0434\u043e 143 \u0441\u043c).&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0439: 1. \u0412\u043d\u0443\u0442\u0440\u0438 \u0435\u0441\u0442\u044c \u0447\u0435\u0442\u044b\u0440\u0435 \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u044b\u0445 \u043a\u0430\u0440\u043c\u0430\u043d\u0430 (\u043e\u0434\u0438\u043d \u043d\u0430 \u043c\u043e\u043b\u043d\u0438\u0438), \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0440\u0435\u0437\u043d\u043e\u0439 \u043a\u0430\u0440\u043c\u0430\u043d \u043d\u0430 \u043c\u043e\u043b\u043d\u0438\u0438.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u041d\u0430 \u043b\u0438\u0446\u0435\u0432\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u0435\u0441\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043a\u0430\u0440\u043c\u0430\u043d \u043d\u0430 \u043c\u043e\u043b\u043d\u0438\u0438. \u0422\u0430\u043a\u0436\u0435 \u0441\u0443\u043c\u043a\u0430 \u0438\u043c\u0435\u0435\u0442 \u0434\u0432\u0430 \u0432\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0431\u043e\u043a\u043e\u0432\u044b\u0445 \u043a\u0430\u0440\u043c\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u043c\u043e\u0449\u0438 \u043c\u043e\u043b\u043d\u0438\u0438.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u041d\u0430 \u0442\u044b\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u0441\u0443\u043c\u043a\u0438 \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0440\u0435\u0437\u043d\u043e\u0439 \u043a\u0430\u0440\u043c\u0430\u043d \u043d\u0430 \u043c\u043e\u043b\u043d\u0438\u0438.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u043f\u043e\u0434\u043a\u043b\u0430\u0434\u044b: \u043f\u043b\u043e\u0442\u043d\u0430\u044f \u0442\u043a\u0430\u043d\u044c.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0438\u0437\u0434\u0435\u043b\u0438\u044f: \u043a\u043e\u0436\u0437\u0430\u043c.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u041e\u0431\u044a\u0435\u043c: 28,8 \u043b (\u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u043a\u0430\u0440\u043c\u0430\u043d\u043e\u0432).&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u0426\u0432\u0435\u0442: \u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u044b\u0439.&lt;br \/&gt;\r\n\t&lt;br \/&gt;\r\n\t\u0426\u