\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044f \u0432\u043e\u0437\u0434\u0443\u0445. \u041c\u043e\u0434\u0430\u043b \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0431\u0435\u043b\u044c\u044e \u043b\u0435\u0433\u043a\u043e\u0441\u0442\u044c, \u043d\u0435\u0436\u043d\u043e\u0441\u0442\u044c \u043d\u0430 \u043e\u0449\u0443\u043f\u044c, \u0441\u0442\u043e\u0439\u043a\u043e\u0441\u0442\u044c \u043a \u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u044b\u043c \u0441\u0442\u0438\u0440\u043a\u0430\u043c \u0438 \u043f\u0440\u043e\u0441\u0442\u043e\u0442\u0443 \u0432 \u0443\u0445\u043e\u0434\u0435. \u0410 \u044d\u043b\u0430\u0441\u0442\u0430\u043d \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u043b \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e\u043c &amp;nbsp;\u0440\u0430\u0441\u0442\u044f\u0433\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0432 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044f \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u0438\u0434.&lt;\/span&gt;&lt;\/span&gt;&lt;span style=&quot;font-size: 14pt; color: rgb(51, 62, 72); background-image: initial; background-attachment: initial; background-size: initial; background-origin: initial; background-clip: initial; background-position: initial; background-repeat: initial;&quot;&gt;&lt;o:p&gt;&lt;\/o:p&gt;&lt;\/span&gt;&lt;\/p&gt;\r\n&lt;\/div&gt;\r\n&lt;div style=&quot;line-height: 21px; font-family: arial; font-size: 14px; color: rgb(51, 51, 51); margin: 0px !important; background-image: none !important; background-attachment: scroll !impo