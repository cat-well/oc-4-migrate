# 1.To use URL Alias you need to be running apache with mod_rewrite enabled.

# 2. In your opencart directory rename htaccess.txt to .htaccess.

# For any support issues please visit: http://www.opencart.com

#Options +FollowSymlinks

# Prevent Directoy listing
Options -Indexes

# Prevent Direct Access to files
<FilesMatch "\.(tpl|ini|log)">
 Order deny,allow
 Deny from all
</FilesMatch>

# SEO URL Settings
RewriteEngine On
# If your opencart installation does not run on the main web folder make sure you folder it does run in ie. / becomes /shop/

RewriteBase /
RewriteCond %{HTTP_HOST} ^test\.manline\.com\.ua$ [NC]
RewriteCond %{HTTP:SSL} !=1 [NC]
RewriteRule ^(.*) https://test.manline.com.ua/$1 [L,R=301]
#RewriteRule ^sitemap.xml$ index.php?route=feed/google_sitemap [L]
RewriteRule ^sitemap\.xml$ index.php?route=extension/feed/sitemap [L,QSA]
RewriteRule ^googlebase.xml$ index.php?route=feed/google_base [L]
RewriteRule ^download/(.*) /index.php?route=error/not_found [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !.*\.(ico|gif|jpg|jpeg|png|js|css)
RewriteRule ^([^?]*) index.php?_route_=$1 [B,L,QSA]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*) https://%1/$1 [L,R=301]

RewriteCond %{QUERY_STRING} ^route=product/category&path=64_1663(.*)$
RewriteRule ^index\.php /noski/termonoski/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=product/category&path=1655_1658(.*)$
RewriteRule ^index\.php /majki-futbolki/mayki/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=product/category&path=1655_1659(.*)$
RewriteRule ^index\.php /majki-futbolki/futbolki/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=product/category&path=1665(.*)$
RewriteRule ^index\.php /plyazhnaya-odezhda/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=product/manufacturer/info&manufacturer_id=66(.*)$
RewriteRule ^index\.php /plyazhnaya-odezhda/aqux/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=product/category&path=63_1664(.*)$
RewriteRule ^index\.php /muzhskie-trusy/komplekti/%1? [R=301,L]

Redirect 301 /muzhskie-trusy/brify/ /muzhskie-trusy/slipy/?
Redirect 301 /kontakti-shourum.html /kontakty.html?
Redirect 301 /obmen.html /obmenvozvrat.html?
Redirect 301 /dostavka-oplata.html /dostavkaoplata.html?
Redirect 301 /kak-vibrat-razmer.html /kak-uznat-svoj-razmer.html?
Redirect 301 /pochemu-u-nas.html /o-nas.html?
Redirect 301 /aussiebum.html /plyazhnaya-odezhda/aussiebum/?
Redirect 301 /calvin-klein-egipetizrail.html /muzhskie-trusy/calvin-klein/?
Redirect 301 /nijnee-bele/ /muzhskie-trusy/?

Redirect 301 /belye-plavki-%3F-dlya-plazha.html /plyazhnaya-odezhda/?

Redirect 301 /muzhskie-trusy/komplekt-5sht-calvin-klein-steel.html /muzhskie-trusy/black-boxer-trunk-vysokaja-pocadka.html?
Redirect 301 /muzhskie-trusy/komplekt-3sht-calvin-klein-steel.html /muzhskie-trusy/ck-trusy-slip-plavkami-original-998.html?
Redirect 301 /muzhskie-trusy/calvin-klein-boxer-flag-nabor.html /muzhskie-trusy/original-men-s-underwear-calvin-klein.html?
Redirect 301 /muzhskie-trusy/nabor-5-sht-calvin-klein-boxer-365.html /muzhskie-trusy/trusi-calvin-klein-3pack.html?
Redirect 301 /muzhskie-trusy/calvin-klein-boxer-steel-blacksilver.html /muzhskie-trusy/black-boxer-trunk-calvin-klein.html?

### Additional Settings that may need to be enabled for some servers
### Uncomment the commands by removing the # sign in front of it.
### If you get an "Internal Server Error 500" after enabling any of the following settings, restore the # as this means your host doesn't allow that.

# 1. If your cart only allows you to add one item at a time, it is possible register_globals is on. This may work to disable it:
# php_flag register_globals off

# 2. If your cart has magic quotes enabled, This may work to disable it:
# php_flag magic_quotes_gpc Off

# 3. Set max upload file size. Most hosts will limit this and not allow it to be overridden but you can try
# php_value upload_max_filesize 999M

# 4. set max post size. uncomment this line if you have a lot of product options or are getting errors where forms are not saving all fields
# php_value post_max_size 999M

# 5. set max time script can take. uncomment this line if you have a lot of product options or are getting errors where forms are not saving all fields
# php_value max_execution_time 200

# 6. set max time for input to be recieved. Uncomment this line if you have a lot of product options or are getting errors where forms are not saving all fields
# php_value max_input_time 200

# 7. disable open_basedir limitations
# php_admin_value open_basedir none

<IfModule mod_headers.c>
Header always append X-Frame-Options SAMEORIGIN
</IfModule>