{# Manline OC4 — SimpleCheckout-style one-page checkout #}
{{ header }}

<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
</div>

<div class="container">
  <div class="simple-content">
    <div id="simplecheckout_form_0" data-logged="{{ customer_logged ? 'true' : 'false' }}">
      <div class="simplecheckout">

        {# Layout similar to OC2 template placeholders. We will refine into 2 columns later. #}
        <div class="simplecheckout-three-column">
          <div class="simplecheckout-left-column">
            <div class="simplecheckout-block" id="simplecheckout_customer">
              {{ register|raw }}
            </div>

            <div class="simplecheckout-block" id="simplecheckout_payment_address">
              {{ payment_address|raw }}
            </div>

            <div class="simplecheckout-block" id="simplecheckout_shipping_address">
              {{ shipping_address|raw }}
            </div>

            <div class="simplecheckout-block" id="simplecheckout_shipping">
              {{ shipping_method|raw }}
            </div>

            <div class="simplecheckout-block" id="simplecheckout_payment">
              {{ payment_method|raw }}
            </div>
          </div>

          <div class="simplecheckout-right-column">
            <div class="simplecheckout-block" id="simplecheckout_summary">
              {{ confirm|raw }}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

{{ footer }}
