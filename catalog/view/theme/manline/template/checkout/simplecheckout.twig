{# Manline OC4 — SimpleCheckout-style one-page checkout (OC2 markup inspired) #}
{{ header }}
<script>
  // used by simplecheckout-lite.js
  window.ocLanguage = '{{ lang }}';
</script>
<script src="catalog/view/theme/manline/js/simplecheckout-lite.js?v=20260308-1"></script>

<div class="container">
  {# Breadcrumbs (OC2-like) #}
  <div class="breadcrumb_w">
    {% for breadcrumb in breadcrumbs %}
      {% if not loop.first %}
        <span class="sep">&gt;</span>
      {% endif %}
      {% if not loop.last %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% else %}
        <span class="current">{{ breadcrumb.text }}</span>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="container">
  <h1>{{ heading_title }}</h1>

  <div class="simple-content">
    <div
      id="simplecheckout_form_0"
      data-logged="{{ customer_logged ? 'true' : 'false' }}"
      data-reload-url="{{ reload_action }}"
      data-np-url="{{ novaposhta_endpoint }}"
    >
      <div class="simplecheckout">

        <div class="simplecheckout-left-column">
          {{ simple_blocks.cart|raw }}
        </div>

        <div class="simplecheckout-right-column">
          {{ simple_blocks.customer|raw }}
          {{ simple_blocks.comment|raw }}
          {{ simple_blocks.shipping|raw }}
          {{ simple_blocks.shipping_address|raw }}
          {{ simple_blocks.payment|raw }}
          <div id="simplecheckout_payment_form">{{ simple_blocks.payment_form|raw }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

{{ footer }}
