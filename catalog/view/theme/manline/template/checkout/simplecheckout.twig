{# Manline OC4 — SimpleCheckout-style one-page checkout scaffold #}
{{ header }}

<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
</div>

<div class="container">
  <div class="simple-content">
    <div class="simplecheckout">
      <div class="content" style="padding:20px;background:#fff">
        <h1 style="margin-top:0">Checkout (SimpleCheckout)</h1>
        <p>Scaffold page. Next step: port OC2 SimpleCheckout blocks + AJAX reload flow.</p>
      </div>
    </div>
  </div>
</div>

{{ footer }}
