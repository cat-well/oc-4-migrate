<div class="simplecheckout-block" id="simplecheckout_customer" {% if errors.firstname or errors.lastname or errors.telephone or errors.email %}data-error="true"{% endif %}>
  <div class="checkout-heading"><span>{{ text_customer }}</span></div>
  <div class="simplecheckout-block-content">
    <div class="simplecheckout-table-form">
      <div class="simplecheckout-table-form-left"><span class="simplecheckout-required">*</span> {{ entry_firstname }}</div>
      <div class="simplecheckout-table-form-right">
        <input type="text" name="firstname" value="{{ customer.firstname }}" placeholder="{{ placeholder_firstname }}" />
        {% if errors.firstname %}
          <div class="simplecheckout-error-text">{{ errors.firstname }}</div>
        {% endif %}
      </div>

      <div class="simplecheckout-table-form-left"><span class="simplecheckout-required">*</span> {{ entry_lastname }}</div>
      <div class="simplecheckout-table-form-right">
        <input type="text" name="lastname" value="{{ customer.lastname }}" placeholder="{{ placeholder_lastname }}" />
        {% if errors.lastname %}
          <div class="simplecheckout-error-text">{{ errors.lastname }}</div>
        {% endif %}
      </div>

      <div class="simplecheckout-table-form-left"><span class="simplecheckout-required">*</span> {{ entry_telephone }}</div>
      <div class="simplecheckout-table-form-right">
        <input type="text" name="telephone" value="{{ customer.telephone }}" placeholder="{{ placeholder_telephone }}" />
        {% if errors.telephone %}
          <div class="simplecheckout-error-text">{{ errors.telephone }}</div>
        {% endif %}
      </div>

      <div class="simplecheckout-table-form-left"><span class="simplecheckout-required">*</span> {{ entry_email }}</div>
      <div class="simplecheckout-table-form-right">
        <input type="text" name="email" value="{{ customer.email }}" placeholder="{{ placeholder_email }}" />
        {% if errors.email %}
          <div class="simplecheckout-error-text">{{ errors.email }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
