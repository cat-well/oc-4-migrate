{{ header }}
<div id="cms-blog" class="container blog-info">
  <div class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <div>
        {% if not loop.last %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% else %}
          <span>{{ breadcrumb.text }}</span>
        {% endif %}
      </div>
      {% if not loop.last %}<div class="text_separator" aria-hidden="true"></div>{% endif %}
    {% endfor %}
    <div class="clearfix"></div>
  </div>

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
      {{ content_top }}

      <div class="blog-article">
        <header class="blog-article-header">
          <h1 class="blog-article-title">{{ heading_title }}</h1>

          <div class="blog-article-meta">
            <span class="blog-article-meta__item">{{ text_by }} <a href="{{ filter_author }}">{{ author }}</a></span>
            <span class="blog-article-meta__sep">•</span>
            <span class="blog-article-meta__item">{{ date_added }}</span>
            {% if reading_time %}
              <span class="blog-article-meta__sep">•</span>
              <span class="blog-article-meta__item">{{ reading_time }} мин чтения</span>
            {% endif %}
            <span class="blog-article-meta__sep">•</span>
            <span class="blog-article-meta__item">{{ comment_total }} {{ text_comment }}</span>
          </div>

          {% if image %}
            <figure class="blog-article-hero">
              <img src="{{ image }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-fluid" loading="lazy"/>
            </figure>
          {% endif %}
        </header>

        <div class="row g-4 blog-article-layout">
          <div class="col-12 col-lg-8">
            <div id="blog-article-content" class="blog-article-content">
              {{ description }}
            </div>

            {% if tags %}
              <div class="blog-tags">
                <div class="blog-tags__title">{{ text_tags }}</div>
                <div class="blog-tags__list">
                  {% for tag in tags %}
                    <a class="blog-tag" href="{{ tag.href }}">{{ tag.tag }}</a>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if comment %}
              <div id="comment-container" class="blog-comments">
                {{ comment }}
              </div>
            {% endif %}
          </div>

          <div class="col-12 col-lg-4">
            <aside class="blog-article-aside">
              <div class="card blog-toc-card">
                <div class="card-body">
                  <div class="blog-aside-title">Оглавление</div>
                  <nav id="blog-toc" class="blog-toc" aria-label="Table of contents"></nav>
                </div>
              </div>

              <div class="card blog-related-card">
                <div class="card-body">
                  {% if related_articles %}
                    <div class="blog-aside-title">Читайте также</div>
                    <ul class="blog-related-list">
                      {% for a in related_articles %}
                        <li class="blog-related-item">
                          <a href="{{ a.href }}" class="blog-related-link">{{ a.name }}</a>
                          {% if a.date_added %}<div class="blog-related-date">{{ a.date_added }}</div>{% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                    <a class="btn btn-outline-secondary btn-sm mt-2" href="{{ continue }}">Все статьи</a>
                  {% else %}
                    <a class="btn btn-outline-secondary btn-sm" href="{{ continue }}">Все статьи</a>
                  {% endif %}
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
