<div id="cookie" class="cookie-banner">
  <div class="container">
    <div class="row mt-2 cookie-banner__row">
      <div class="col-12 p-2 text-center">
        <p class="cookie-banner__text">{{ text_cookie }}</p>
        <div class="cookie-banner__actions">
          <button type="button" value="{{ agree }}" class="btn bg-primary btn-block text-white cookie-banner__btn cookie-banner__btn--agree">{{ button_agree }}</button>
          <button type="button" value="{{ disagree }}" class="btn btn-light btn-block cookie-banner__btn cookie-banner__btn--disagree">{{ button_disagree }}</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Force cookie consent confirm via POST to avoid intermediary caching of GET requests.
// Also unbind any previously attached handlers (e.g. from cached common.js).
(function() {
  if (!window.jQuery) return;

  function postConfirm(url) {
    try {
      var u = new URL(url, window.location.origin);
      var agree = u.searchParams.get('agree') || '0';

      return $.ajax({
        url: url,
        type: 'post',
        cache: false,
        dataType: 'json',
        data: { agree: agree }
      });
    } catch (e) {
      return $.Deferred().reject(e).promise();
    }
  }

  $('#cookie button').off('click').on('click', function(e) {
    e.preventDefault();

    var url = $(this).val();

    postConfirm(url)
      .done(function(json) {
        if (json && json.success) {
          $('#cookie').fadeOut(400, function() {
            $('#cookie').remove();
          });
        }
      })
      .fail(function(xhr) {
        console.log('Cookie confirm failed', xhr);
      });

    return false;
  });
})();
</script>
