{# FilterPro-like sidebar (temporary, driven by admin blocks config) #}

<div id="filterpro" class="filterpro_like" data-fp-mode="{{ fp_mode|default('category') }}" data-fp-base-path="{{ fp_base_path }}" data-fp-base-query="{{ fp_base_query }}" data-fp-base-url="{{ base_url }}">

  <div class="f_group">
    <div class="f_title">{% if is_ua %}Фільтр{% else %}Фильтр{% endif %}</div>
    <div class="f_actions">
      <button type="button" class="btn btn-sm fp_apply" id="fp-apply" disabled>{% if is_ua %}Застосувати{% else %}Применить{% endif %}</button>
      <a class="f_clear" href="{{ base_url }}">{% if is_ua %}Скинути{% else %}Сбросить{% endif %}</a>
    </div>
  </div>

  {% for b in blocks %}
    <div class="f_group {% if not b.expanded %}fp_collapsed{% endif %}" data-fp-group>
      <div class="f_title" data-fp-toggle>
        {{ b.label }}
        {% if b.tooltip %}<span class="fp_tip" title="{{ b.tooltip }}">?</span>{% endif %}
      </div>

      <div class="f_body">
        {% if b.type == 'nav' %}
          <ul class="f_list fp_nav">
            {% for it in b.items %}
              <li class="f_item">
                <a href="{{ it.url }}">{{ it.label }} <span class="f_cnt">({{ it.total }})</span></a>
              </li>
            {% endfor %}
          </ul>

        {% elseif b.type == 'price' %}
          <form method="get" action="{{ b.price.action }}" class="f_price" data-fp-price>

            {% if b.display == 'slider' %}
              <div class="fp_price_slider" data-fp-slider>
                <div class="fp_track"></div>
                <div class="fp_range" data-fp-range></div>
                <input type="range" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" value="{{ b.price.selected_min ?: b.price.min_floor }}" step="1" data-fp-min-range>
                <input type="range" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" value="{{ b.price.selected_max ?: b.price.max_ceil }}" step="1" data-fp-max-range>
                <div class="fp_ticks">
                  <span class="fp_tick">{{ b.price.min_floor }}</span>
                  <span class="fp_tick">{{ b.price.max_ceil }}</span>
                </div>
              </div>
            {% endif %}

            <div class="f_row">
              <label>{% if is_ua %}Від{% else %}От{% endif %}:</label>
              <input type="number" name="min_price" value="{{ b.price.selected_min }}" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" placeholder="{{ b.price.min_floor }}" data-fp-min-num />
            </div>
            <div class="f_row">
              <label>{% if is_ua %}До{% else %}До{% endif %}:</label>
              <input type="number" name="max_price" value="{{ b.price.selected_max }}" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" placeholder="{{ b.price.max_ceil }}" data-fp-max-num />
            </div>
            
          </form>

        {% else %}

          {% if b.display == 'image' %}
            <div class="f_colors" data-fp-image-group data-fp-key="{{ b.slug_key|default(b.key) }}">
              {% for it in b.items %}
                <a class="f_color {% if it.selected %}active{% endif %}" href="{{ it.url }}" title="{{ it.label }} ({{ it.total }})" data-fp-val="{{ it.fp_val|default('') }}">
                  {% if it.image %}
                    <img src="image/{{ it.image }}" alt="{{ it.label }}" />
                  {% else %}
                    <span>{{ it.label }}</span>
                  {% endif %}
                </a>
              {% endfor %}
            </div>

          {% elseif b.display == 'tiles' %}
            <div class="fp_tiles" data-fp-list-group data-fp-key="{{ b.slug_key|default(b.key) }}">
              {% for it in b.items %}
                <a href="{{ it.url }}" class="fp_tile {% if it.selected %}active{% endif %}" data-fp-list data-fp-key="{{ it.fp_key|default(b.slug_key|default(b.key)) }}" data-fp-val="{{ it.fp_val|default('') }}">
                  {{ it.label }}
                </a>
              {% endfor %}
            </div>

          {% elseif b.display == 'checkbox' %}
            <ul class="f_list fp_checks">
              {% for it in b.items %}
                <li class="f_item">
                  <label class="fp_check">
                    <input type="checkbox" {% if it.selected %}checked{% endif %} data-fp-key="{{ it.fp_key|default(b.slug_key|default(b.key)) }}" data-fp-val="{{ it.fp_val|default('') }}" />
                    <span class="fp_check_text">{{ it.label }} <span class="f_cnt">({{ it.total }})</span></span>
                  </label>
                </li>
              {% endfor %}
            </ul>

          {% else %}
            <ul class="f_list" data-fp-list-group data-fp-key="{{ b.slug_key|default(b.key) }}">
              {% for it in b.items %}
                <li class="f_item">
                  <a href="{{ it.url }}" class="{% if it.selected %}active{% endif %}" data-fp-list data-fp-key="{{ it.fp_key|default(b.slug_key|default(b.key)) }}" data-fp-val="{{ it.fp_val|default('') }}">
                    {{ it.label }} <span class="f_cnt">({{ it.total }})</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

        {% endif %}
      </div>
    </div>
  {% endfor %}

</div>

{% if not fp_partial %}
<script>
  // Multi-select apply: collect selected values and build /f/ URL
  function fpRootEl() { return document.getElementById('filterpro'); }
  function fpApplyBtn() { return document.getElementById('fp-apply'); }

  function fpGetSelection() {
    var sel = {};
    var fpRoot = fpRootEl();
    if (!fpRoot) return sel;

    // checkboxes
    fpRoot.querySelectorAll('input[type="checkbox"][data-fp-key][data-fp-val]').forEach(function(cb){
      if (!cb.checked) return;
      var k = cb.getAttribute('data-fp-key') || '';
      var v = cb.getAttribute('data-fp-val') || '';
      if (!k || !v) return;
      if (!sel[k]) sel[k] = [];
      sel[k].push(String(v));
    });

    // image tiles (selected via .active)
    fpRoot.querySelectorAll('[data-fp-image-group]').forEach(function(group){
      var k = group.getAttribute('data-fp-key') || '';
      if (!k) return;
      group.querySelectorAll('a.f_color.active[data-fp-val]').forEach(function(a){
        var v = a.getAttribute('data-fp-val') || '';
        if (!v) return;
        if (!sel[k]) sel[k] = [];
        sel[k].push(String(v));
      });
    });

    // list links (selected via .active)
    fpRoot.querySelectorAll('a[data-fp-list].active[data-fp-key][data-fp-val]').forEach(function(a){
      var k = a.getAttribute('data-fp-key') || '';
      var v = a.getAttribute('data-fp-val') || '';
      if (!k || !v) return;
      if (!sel[k]) sel[k] = [];
      sel[k].push(String(v));
    });

    // price (query params)
    var minNum = fpRoot.querySelector('[data-fp-min-num]');
    var maxNum = fpRoot.querySelector('[data-fp-max-num]');
    if (minNum && String(minNum.value||'').trim() !== '') sel.min_price = [String(minNum.value).trim()];
    if (maxNum && String(maxNum.value||'').trim() !== '') sel.max_price = [String(maxNum.value).trim()];

    // de-dup + sort
    Object.keys(sel).forEach(function(k){
      sel[k] = Array.from(new Set(sel[k].filter(Boolean))).sort();
      if (!sel[k].length) delete sel[k];
    });

    return sel;
  }

  // expose for future AJAX implementation
  window.fpGetSelection = fpGetSelection;

  function buildUrlFromSelection() {
    var fpRoot = fpRootEl();
    if (!fpRoot) return null;
    var basePath = fpRoot.getAttribute('data-fp-base-path') || '';
    var baseQuery = fpRoot.getAttribute('data-fp-base-query') || '';
    var baseUrl = fpRoot.getAttribute('data-fp-base-url') || basePath;

    var sel = fpGetSelection();

    // Extract price query params if present
    var qMin = sel.min_price && sel.min_price[0] ? sel.min_price[0] : '';
    var qMax = sel.max_price && sel.max_price[0] ? sel.max_price[0] : '';
    delete sel.min_price;
    delete sel.max_price;

    var keys = Object.keys(sel).sort();
    var parts = [];
    keys.forEach(function(k){
      var vals = Array.from(new Set(sel[k].filter(Boolean))).sort();
      if (!vals.length) return;
      parts.push(k + '_' + vals.join(','));
    });

    var q = baseQuery ? baseQuery : '';
    if (qMin) q += (q ? '&' : '') + 'min_price=' + encodeURIComponent(qMin);
    if (qMax) q += (q ? '&' : '') + 'max_price=' + encodeURIComponent(qMax);

    var mode = fpRoot.getAttribute('data-fp-mode') || 'category';

    if (mode === 'search') {
      // Search mode: keep everything as query params (no /f/)
      // baseQuery already contains language+search(+other safe params).
      var qq = baseQuery ? baseQuery : '';
      // manufacturer uses dedicated param for compatibility
      if (sel.manufacturer && sel.manufacturer.length) {
        qq += (qq ? '&' : '') + 'manufacturer=' + encodeURIComponent(sel.manufacturer.join(','));
      }
      // add all other keys as-is (e.g. f_material=...)
      keys.forEach(function(k){
        if (k === 'manufacturer') return;
        qq += (qq ? '&' : '') + encodeURIComponent(k) + '=' + encodeURIComponent(sel[k].join(','));
      });
      if (qMin) qq += (qq ? '&' : '') + 'min_price=' + encodeURIComponent(qMin);
      if (qMax) qq += (qq ? '&' : '') + 'max_price=' + encodeURIComponent(qMax);

      return String(basePath).replace(/\/+$/, '') + (qq ? ('?' + qq) : '');
    }

    if (!parts.length) {
      // price-only (or cleared) selection
      return q ? (baseUrl + (baseUrl.indexOf('?') === -1 ? '?' : '&') + q) : baseUrl;
    }

    var url = String(basePath).replace(/\/+$/, '') + '/f/' + parts.join('/');
    if (q) url += '?' + q;
    return url;
  }

  var fpApplyTimer = null;

  function markDirty() {
    var applyBtn = fpApplyBtn();
    if (applyBtn) applyBtn.disabled = false;
  }

  function scheduleApply(delayMs) {
    delayMs = (typeof delayMs === 'number') ? delayMs : 450;
    if (fpApplyTimer) clearTimeout(fpApplyTimer);
    fpApplyTimer = setTimeout(function(){
      var url = buildUrlFromSelection();
      if (url) fpAjaxUpdate(url);
      var applyBtn = fpApplyBtn();
      if (applyBtn) applyBtn.disabled = true;
    }, delayMs);
  }

  // Toggle image tiles (multi-select) and enable Apply
  document.addEventListener('click', function(e){
    var a = e.target && (e.target.closest ? e.target.closest('a.f_color[data-fp-val]') : null);
    if (a) {
      var group = a.closest && a.closest('[data-fp-image-group]');
      if (group) {
        if (!(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)) {
          e.preventDefault();
        }
        a.classList.toggle('active');
        markDirty();
        scheduleApply();
        return;
      }
    }

    // Toggle list links (multi-select) and enable Apply
    var link = e.target && (e.target.closest ? e.target.closest('a[data-fp-list][data-fp-val]') : null);
    if (link && fpRoot && fpRoot.contains(link)) {
      if (!(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)) {
        e.preventDefault();
      }
      link.classList.toggle('active');
      markDirty();
      scheduleApply();
      return;
    }
  });

  // When user changes any checkbox, enable Apply + auto-apply
  document.addEventListener('change', function(e) {
    var el = e.target;
    if (!el) return;
    if (el.matches && el.matches('#filterpro input[type="checkbox"][data-fp-key]')) {
      markDirty();
      scheduleApply();
    }
  });

  var fpReqSeq = 0;

  function fpAjaxUpdate(url) {
    if (!url) return;

    // fallback
    if (!window.fetch) {
      window.location.href = url;
      return;
    }

    var content = document.getElementById('content');
    var list = document.getElementById('product-list');
    var pag = document.querySelector('.pagination_w');

    // If we are not on a category page yet, do normal navigation
    if (!content || !list || !pag) {
      window.location.href = url;
      return;
    }

    content.classList.add('fp_loading');

    // Guard against out-of-order responses (double clicks / rapid changes)
    fpReqSeq += 1;
    var reqId = fpReqSeq;

    // Use partial JSON endpoint (lighter than full HTML fetch)
    var purl = url + (url.indexOf('?') === -1 ? '?' : '&') + 'fp_partial=1';

    fetch(purl, {
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      }
    })
      .then(function(r){
        var ct = (r.headers && r.headers.get && r.headers.get('content-type')) || '';
        if (ct.indexOf('application/json') !== -1) return r.json();
        return r.text().then(function(t){ throw { kind: 'non-json', text: t }; });
      })
      .then(function(payload){
        // Ignore stale responses
        if (reqId !== fpReqSeq) return;

        if (!payload) throw { kind: 'empty' };

        if (payload.products_html != null) {
          var html = String(payload.products_html);
          if (html.trim() === '') {
            html = '<div class="fp_empty">' + ({{ is_ua ? 'true' : 'false' }} ? 'Товарів не знайдено' : 'Товаров не найдено') + '</div>';
          }
          list.innerHTML = html;
        }
        if (payload.pagination_html != null) {
          pag.innerHTML = String(payload.pagination_html || '');
        }

        var curSort = document.getElementById('input-sort');
        var curLimit = document.getElementById('input-limit');
        if (curSort && payload.sort_options_html != null) {
          curSort.innerHTML = String(payload.sort_options_html);
        }
        if (curLimit && payload.limit_options_html != null) {
          curLimit.innerHTML = String(payload.limit_options_html);
        }

        // Update filter sidebar HTML (scripts are loaded only on first render)
        if (payload.filter_html) {
          var oldFp = document.getElementById('filterpro');
          if (oldFp) {
            oldFp.outerHTML = String(payload.filter_html);
            // re-init handlers for newly inserted DOM (price slider)
            fpInitPrice();
          }
        }

        if (payload.title) document.title = String(payload.title);

        window.history.pushState({ fp: 1 }, '', url);
      })
      .catch(function(err){
        // Ignore stale errors
        if (reqId !== fpReqSeq) return;
        window.location.href = url;
      })
      .finally(function(){
        // Only clear loader for the latest request
        if (reqId === fpReqSeq) {
          content.classList.remove('fp_loading');
        }
      });
  }

  document.addEventListener('click', function(e){
    var btn = e.target && (e.target.closest ? e.target.closest('#fp-apply') : null);
    if (!btn) return;
    // manual apply still works
    var url = buildUrlFromSelection();
    if (url) fpAjaxUpdate(url);
    btn.disabled = true;
  });

  // prevent price form submit from reloading page
  document.addEventListener('submit', function(e){
    var form = e.target;
    if (form && form.matches && form.matches('form[data-fp-price]')) {
      e.preventDefault();
      scheduleApply(0);
    }
  });

  function fpInitPrice() {
    // Price slider sync (re-init after sidebar replacement)
    document.querySelectorAll('form[data-fp-price]').forEach(function(form) {
      if (form.getAttribute('data-fp-inited') === '1') return;
      form.setAttribute('data-fp-inited', '1');

      var minRange = form.querySelector('[data-fp-min-range]');
      var maxRange = form.querySelector('[data-fp-max-range]');
      var minNum = form.querySelector('[data-fp-min-num]');
      var maxNum = form.querySelector('[data-fp-max-num]');
      var rangeEl = form.querySelector('[data-fp-range]');

      function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

      function updateFill() {
        if (!rangeEl || !minRange || !maxRange) return;
        var lo = parseInt(minRange.min || '0', 10);
        var hi = parseInt(minRange.max || '0', 10);
        var vMin = parseInt(minRange.value || lo, 10);
        var vMax = parseInt(maxRange.value || hi, 10);
        var total = (hi - lo) || 1;
        var left = ((vMin - lo) / total) * 100;
        var right = ((vMax - lo) / total) * 100;
        rangeEl.style.left = left + '%';
        rangeEl.style.width = Math.max(0, right - left) + '%';
      }

      function syncFromRanges() {
        if (!minRange || !maxRange) return;
        var lo = parseInt(minRange.min || '0', 10);
        var hi = parseInt(minRange.max || '0', 10);
        var vMin = parseInt(minRange.value || lo, 10);
        var vMax = parseInt(maxRange.value || hi, 10);
        if (vMin > vMax) vMin = vMax;
        minRange.value = vMin;
        maxRange.value = vMax;
        if (minNum) minNum.value = vMin;
        if (maxNum) maxNum.value = vMax;
        updateFill();
      }

      function syncFromNumbers() {
        if (!minNum || !maxNum) return;
        var lo = parseInt(minNum.min || '0', 10);
        var hi = parseInt(minNum.max || '0', 10);
        var vMin = parseInt(minNum.value || lo, 10);
        var vMax = parseInt(maxNum.value || hi, 10);
        vMin = clamp(vMin, lo, hi);
        vMax = clamp(vMax, lo, hi);
        if (vMin > vMax) vMin = vMax;
        minNum.value = vMin;
        maxNum.value = vMax;
        if (minRange) minRange.value = vMin;
        if (maxRange) maxRange.value = vMax;
        updateFill();
      }

      if (minRange && maxRange) {
        minRange.addEventListener('input', function(){ syncFromRanges(); markDirty(); scheduleApply(600); });
        maxRange.addEventListener('input', function(){ syncFromRanges(); markDirty(); scheduleApply(600); });
        syncFromRanges();
      }

      if (minNum && maxNum) {
        minNum.addEventListener('change', function(){ syncFromNumbers(); markDirty(); scheduleApply(300); });
        maxNum.addEventListener('change', function(){ syncFromNumbers(); markDirty(); scheduleApply(300); });
      }
    });
  }

  // init once
  fpInitPrice();

  // Pagination link hijack (AJAX)
  document.addEventListener('click', function(e){
    var a = e.target && (e.target.closest ? e.target.closest('.pagination_w a') : null);
    if (!a) return;
    var href = a.getAttribute('href');
    if (!href) return;
    e.preventDefault();
    fpAjaxUpdate(href);
  });

  // Sort/limit change hijack (AJAX)
  document.addEventListener('change', function(e){
    var el = e.target;
    if (!el) return;
    if (el.id === 'input-sort' || el.id === 'input-limit') {
      var url = el.value;
      if (url) {
        fpAjaxUpdate(url);
      }
    }
  });

  // Back/forward
  window.addEventListener('popstate', function(){
    // reload current URL via ajax to keep state in sync
    fpAjaxUpdate(window.location.href);
  });

  // Accordion
  document.addEventListener('click', function(e) {
    var t = e.target;
    if (!t) return;
    var title = t.closest && t.closest('[data-fp-toggle]');
    if (!title) return;
    var group = title.closest('[data-fp-group]');
    if (!group) return;
    if (t.closest('a')) return;
    if (t.closest('label')) return;
    if (t.closest('input')) return;
    group.classList.toggle('fp_collapsed');
  });
</script>

<style>
  .filterpro_like .f_group{margin:0 0 18px;}
  #content.fp_loading{opacity:.6;pointer-events:none;}
  .filterpro_like .f_title{cursor:pointer;user-select:none;font-weight:700;margin:0 0 8px;}
  .filterpro_like .f_actions{margin:-6px 0 10px;display:flex;gap:10px;align-items:center;}
  .filterpro_like .fp_apply{background:#fed700;border:1px solid #e8c800;color:#000;padding:2px 10px;border-radius:3px;}
  .filterpro_like .fp_apply[disabled]{opacity:.5;cursor:not-allowed;}
  .filterpro_like .fp_empty{padding:14px 10px;border:1px dashed #ddd;border-radius:6px;color:#666;background:#fafafa;}
  .filterpro_like .f_clear{font-size:12px;color:#666;text-decoration:underline;}

  .filterpro_like .fp_collapsed .f_body{display:none;}

  .filterpro_like .fp_tip{display:inline-block;margin-left:6px;width:16px;height:16px;line-height:16px;text-align:center;border-radius:50%;background:#eee;color:#555;font-size:12px;}

  .filterpro_like .f_list{list-style:none;margin:0;padding:0;}
  .filterpro_like .f_item{margin:0 0 6px;}
  .filterpro_like .f_item a{color:#333;text-decoration:none;}
  .filterpro_like .f_item a.active{font-weight:700;text-decoration:underline;}
  .filterpro_like .fp_nav a{color:#333;text-decoration:none;}
  .filterpro_like .f_cnt{color:#999;font-weight:400;}

  .filterpro_like .fp_checks .fp_check{display:flex;gap:8px;align-items:center;cursor:pointer;}
  .filterpro_like .fp_checks input[type=checkbox]{margin:0;}

  .filterpro_like .f_colors{display:flex;flex-wrap:wrap;gap:6px;}
  .filterpro_like .f_color{display:inline-block;border:1px solid #ddd;padding:2px;border-radius:3px;}
  .filterpro_like .f_color.active{border-color:#fed700;}
  .filterpro_like .f_color img{display:block;width:22px;height:22px;object-fit:contain;}

  .filterpro_like .fp_tiles{display:flex;flex-wrap:wrap;gap:8px;}
  .filterpro_like .fp_tile{display:inline-block;min-width:44px;text-align:center;padding:6px 10px;border:1px solid #ddd;border-radius:4px;color:#333;text-decoration:none;background:#fff;}
  .filterpro_like .fp_tile.active{border-color:#fed700;box-shadow:0 0 0 2px rgba(254,215,0,.25) inset;}

  .filterpro_like .f_price .f_row{display:flex;gap:6px;align-items:center;margin:0 0 6px;}
  .filterpro_like .f_price input{width:100%;}
  .filterpro_like .fp_price_slider{position:relative;margin:0 0 12px;padding:10px 0 18px;}
  .filterpro_like .fp_price_slider .fp_track{position:absolute;left:0;right:0;top:18px;height:4px;background:#e5e5e5;border-radius:2px;}
  .filterpro_like .fp_price_slider .fp_range{position:absolute;top:18px;height:4px;background:#fed700;border-radius:2px;}
  .filterpro_like .fp_price_slider input[type=range]{position:absolute;left:0;right:0;top:10px;width:100%;pointer-events:none;background:transparent;-webkit-appearance:none;appearance:none;height:30px;margin:0;}
  .filterpro_like .fp_price_slider input[type=range]::-webkit-slider-thumb{pointer-events:auto;-webkit-appearance:none;appearance:none;width:14px;height:14px;border-radius:50%;background:#333;border:2px solid #fff;box-shadow:0 1px 2px rgba(0,0,0,.25);}
  .filterpro_like .fp_price_slider input[type=range]::-moz-range-thumb{pointer-events:auto;width:14px;height:14px;border-radius:50%;background:#333;border:2px solid #fff;box-shadow:0 1px 2px rgba(0,0,0,.25);}
  .filterpro_like .fp_price_slider input[type=range]::-webkit-slider-runnable-track{height:4px;background:transparent;}
  .filterpro_like .fp_price_slider input[type=range]::-moz-range-track{height:4px;background:transparent;}
  .filterpro_like .fp_price_slider .fp_ticks{display:flex;justify-content:space-between;font-size:11px;color:#777;margin-top:20px;}
</style>
{% endif %}
