{# FilterPro-like sidebar (temporary, driven by admin blocks config) #}

<div id="filterpro" class="filterpro_like">

  <div class="f_group">
    <div class="f_title">{% if is_ua %}Фільтр{% else %}Фильтр{% endif %}</div>
    <div class="f_actions">
      <a class="f_clear" href="{{ base_url }}">{% if is_ua %}Скинути{% else %}Сбросить{% endif %}</a>
    </div>
  </div>

  {% for b in blocks %}
    <div class="f_group {% if not b.expanded %}fp_collapsed{% endif %}" data-fp-group>
      <div class="f_title" data-fp-toggle>
        {{ b.label }}
        {% if b.tooltip %}<span class="fp_tip" title="{{ b.tooltip }}">?</span>{% endif %}
      </div>

      <div class="f_body">
        {% if b.type == 'price' %}
          <form method="get" action="{{ b.price.action }}" class="f_price">
            <div class="f_row">
              <label>{% if is_ua %}Від{% else %}От{% endif %}:</label>
              <input type="number" name="min_price" value="{{ b.price.selected_min }}" min="{{ b.price.min_floor }}" placeholder="{{ b.price.min_floor }}" />
            </div>
            <div class="f_row">
              <label>{% if is_ua %}До{% else %}До{% endif %}:</label>
              <input type="number" name="max_price" value="{{ b.price.selected_max }}" max="{{ b.price.max_ceil }}" placeholder="{{ b.price.max_ceil }}" />
            </div>
            <button type="submit" class="btn">OK</button>
          </form>

        {% else %}

          {% if b.display == 'image' %}
            <div class="f_colors">
              {% for it in b.items %}
                <a class="f_color {% if it.selected %}active{% endif %}" href="{{ it.url }}" title="{{ it.label }} ({{ it.total }})">
                  {% if it.image %}
                    <img src="image/{{ it.image }}" alt="{{ it.label }}" />
                  {% else %}
                    <span>{{ it.label }}</span>
                  {% endif %}
                </a>
              {% endfor %}
            </div>

          {% elseif b.display == 'checkbox' %}
            <ul class="f_list fp_checks">
              {% for it in b.items %}
                <li class="f_item">
                  <label class="fp_check">
                    <input type="checkbox" {% if it.selected %}checked{% endif %} data-fp-url="{{ it.url }}" />
                    <span class="fp_check_text">{{ it.label }} <span class="f_cnt">({{ it.total }})</span></span>
                  </label>
                </li>
              {% endfor %}
            </ul>

          {% else %}
            <ul class="f_list">
              {% for it in b.items %}
                <li class="f_item">
                  <a href="{{ it.url }}" class="{% if it.selected %}active{% endif %}">
                    {{ it.label }} <span class="f_cnt">({{ it.total }})</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

        {% endif %}
      </div>
    </div>
  {% endfor %}

</div>

<script>
  // Checkbox navigation (keep link-based URLs)
  document.addEventListener('change', function(e) {
    var el = e.target;
    if (!el) return;
    if (el.matches && el.matches('input[type="checkbox"][data-fp-url]')) {
      var url = el.getAttribute('data-fp-url');
      if (url) window.location.href = url;
    }
  });

  // Accordion
  document.addEventListener('click', function(e) {
    var t = e.target;
    if (!t) return;
    var title = t.closest && t.closest('[data-fp-toggle]');
    if (!title) return;
    var group = title.closest('[data-fp-group]');
    if (!group) return;
    if (t.closest('a')) return;
    if (t.closest('label')) return;
    group.classList.toggle('fp_collapsed');
  });
</script>

<style>
  .filterpro_like .f_group{margin:0 0 18px;}
  .filterpro_like .f_title{cursor:pointer;user-select:none;font-weight:700;margin:0 0 8px;}
  .filterpro_like .f_actions{margin:-6px 0 10px;}
  .filterpro_like .f_clear{font-size:12px;color:#666;text-decoration:underline;}

  .filterpro_like .fp_collapsed .f_body{display:none;}

  .filterpro_like .fp_tip{display:inline-block;margin-left:6px;width:16px;height:16px;line-height:16px;text-align:center;border-radius:50%;background:#eee;color:#555;font-size:12px;}

  .filterpro_like .f_list{list-style:none;margin:0;padding:0;}
  .filterpro_like .f_item{margin:0 0 6px;}
  .filterpro_like .f_item a{color:#333;text-decoration:none;}
  .filterpro_like .f_item a.active{font-weight:700;text-decoration:underline;}
  .filterpro_like .f_cnt{color:#999;font-weight:400;}

  .filterpro_like .fp_checks .fp_check{display:flex;gap:8px;align-items:center;cursor:pointer;}
  .filterpro_like .fp_checks input[type=checkbox]{margin:0;}

  .filterpro_like .f_colors{display:flex;flex-wrap:wrap;gap:6px;}
  .filterpro_like .f_color{display:inline-block;border:1px solid #ddd;padding:2px;border-radius:3px;}
  .filterpro_like .f_color.active{border-color:#fed700;}
  .filterpro_like .f_color img{display:block;width:22px;height:22px;object-fit:contain;}

  .filterpro_like .f_price .f_row{display:flex;gap:6px;align-items:center;margin:0 0 6px;}
  .filterpro_like .f_price input{width:100%;}
</style>
