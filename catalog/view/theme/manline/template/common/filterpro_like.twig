{# Minimal FilterPro-like sidebar (temporary) #}

<div id="filterpro" class="filterpro_like">

  <div class="f_group">
    <div class="f_title">{% if is_ua %}Фільтр{% else %}Фильтр{% endif %}</div>
    <div class="f_actions">
      <a class="f_clear" href="{{ base_url }}">{% if is_ua %}Скинути{% else %}Сбросить{% endif %}</a>
    </div>
  </div>

  {# Price #}
  {% if show_price %}
    <div class="f_group">
      <div class="f_title">{% if is_ua %}Ціна{% else %}Цена{% endif %}</div>
      <form method="get" action="{{ price_form_action }}" class="f_price">
        <div class="f_row">
          <label>{% if is_ua %}Від{% else %}От{% endif %}:</label>
          <input type="number" name="min_price" value="{{ selected_min_price }}" min="{{ price_min_floor }}" placeholder="{{ price_min_floor }}" />
        </div>
        <div class="f_row">
          <label>{% if is_ua %}До{% else %}До{% endif %}:</label>
          <input type="number" name="max_price" value="{{ selected_max_price }}" max="{{ price_max_ceil }}" placeholder="{{ price_max_ceil }}" />
        </div>
        <button type="submit" class="btn">OK</button>
      </form>
    </div>
  {% endif %}

  {# Manufacturers #}
  {% if show_manufacturer and manufacturer_items %}
    <div class="f_group">
      <div class="f_title">{% if is_ua %}Виробники{% else %}Производители{% endif %}</div>
      <ul class="f_list">
        {% for m in manufacturer_items %}
          <li class="f_item">
            <a href="{{ m.url }}" class="{% if m.selected %}active{% endif %}">
              {{ m.name }} <span class="f_cnt">({{ m.total }})</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {# Colors (option_id=13) #}
  {% if show_color and color_items %}
    <div class="f_group">
      <div class="f_title">{% if is_ua %}Колір{% else %}Цвет{% endif %}</div>
      <div class="f_colors">
        {% for c in color_items %}
          <a class="f_color {% if c.selected %}active{% endif %}" href="{{ c.url }}" title="{{ c.name }} ({{ c.total }})">
            {% if c.image %}
              <img src="image/{{ c.image }}" alt="{{ c.name }}" />
            {% else %}
              <span>{{ c.name }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# Style (attribute_id=23) #}
  {% if show_style and style_items %}
    <div class="f_group">
      <div class="f_title">{% if is_ua %}Стиль{% else %}Стиль{% endif %}</div>
      <ul class="f_list">
        {% for s in style_items %}
          <li class="f_item">
            <a href="{{ s.url }}" class="{% if s.selected %}active{% endif %}">
              {{ s.text }} <span class="f_cnt">({{ s.total }})</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

</div>

<style>
  .filterpro_like .f_group{margin:0 0 18px;}
  .filterpro_like .f_title{font-weight:700;margin:0 0 8px;}
  .filterpro_like .f_actions{margin:-6px 0 10px;}
  .filterpro_like .f_clear{font-size:12px;color:#666;text-decoration:underline;}
  .filterpro_like .f_list{list-style:none;margin:0;padding:0;}
  .filterpro_like .f_item{margin:0 0 6px;}
  .filterpro_like .f_item a{color:#333;text-decoration:none;}
  .filterpro_like .f_item a.active{font-weight:700;text-decoration:underline;}
  .filterpro_like .f_cnt{color:#999;font-weight:400;}
  .filterpro_like .f_colors{display:flex;flex-wrap:wrap;gap:6px;}
  .filterpro_like .f_color{display:inline-block;border:1px solid #ddd;padding:2px;border-radius:3px;}
  .filterpro_like .f_color.active{border-color:#fed700;}
  .filterpro_like .f_color img{display:block;width:22px;height:22px;object-fit:contain;}
  .filterpro_like .f_price .f_row{display:flex;gap:6px;align-items:center;margin:0 0 6px;}
  .filterpro_like .f_price input{width:100%;}
</style>
