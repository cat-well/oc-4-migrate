{# FilterPro-like sidebar (temporary, driven by admin blocks config) #}

<div id="filterpro" class="filterpro_like" data-fp-base-path="{{ fp_base_path }}" data-fp-base-query="{{ fp_base_query }}" data-fp-base-url="{{ base_url }}">

  <div class="f_group">
    <div class="f_title">{% if is_ua %}Фільтр{% else %}Фильтр{% endif %}</div>
    <div class="f_actions">
      <button type="button" class="btn btn-sm fp_apply" id="fp-apply" disabled>{% if is_ua %}Застосувати{% else %}Применить{% endif %}</button>
      <a class="f_clear" href="{{ base_url }}">{% if is_ua %}Скинути{% else %}Сбросить{% endif %}</a>
    </div>
  </div>

  {% for b in blocks %}
    <div class="f_group {% if not b.expanded %}fp_collapsed{% endif %}" data-fp-group>
      <div class="f_title" data-fp-toggle>
        {{ b.label }}
        {% if b.tooltip %}<span class="fp_tip" title="{{ b.tooltip }}">?</span>{% endif %}
      </div>

      <div class="f_body">
        {% if b.type == 'price' %}
          <form method="get" action="{{ b.price.action }}" class="f_price" data-fp-price>

            {% if b.display == 'slider' %}
              <div class="fp_price_slider" data-fp-slider>
                <div class="fp_track"></div>
                <div class="fp_range" data-fp-range></div>
                <input type="range" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" value="{{ b.price.selected_min ?: b.price.min_floor }}" step="1" data-fp-min-range>
                <input type="range" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" value="{{ b.price.selected_max ?: b.price.max_ceil }}" step="1" data-fp-max-range>
                <div class="fp_ticks">
                  <span class="fp_tick">{{ b.price.min_floor }}</span>
                  <span class="fp_tick">{{ b.price.max_ceil }}</span>
                </div>
              </div>
            {% endif %}

            <div class="f_row">
              <label>{% if is_ua %}Від{% else %}От{% endif %}:</label>
              <input type="number" name="min_price" value="{{ b.price.selected_min }}" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" placeholder="{{ b.price.min_floor }}" data-fp-min-num />
            </div>
            <div class="f_row">
              <label>{% if is_ua %}До{% else %}До{% endif %}:</label>
              <input type="number" name="max_price" value="{{ b.price.selected_max }}" min="{{ b.price.min_floor }}" max="{{ b.price.max_ceil }}" placeholder="{{ b.price.max_ceil }}" data-fp-max-num />
            </div>
            <button type="submit" class="btn">OK</button>
          </form>

        {% else %}

          {% if b.display == 'image' %}
            <div class="f_colors">
              {% for it in b.items %}
                <a class="f_color {% if it.selected %}active{% endif %}" href="{{ it.url }}" title="{{ it.label }} ({{ it.total }})">
                  {% if it.image %}
                    <img src="image/{{ it.image }}" alt="{{ it.label }}" />
                  {% else %}
                    <span>{{ it.label }}</span>
                  {% endif %}
                </a>
              {% endfor %}
            </div>

          {% elseif b.display == 'checkbox' %}
            <ul class="f_list fp_checks">
              {% for it in b.items %}
                <li class="f_item">
                  <label class="fp_check">
                    <input type="checkbox" {% if it.selected %}checked{% endif %} data-fp-key="{{ b.slug_key|default(b.key) }}" data-fp-val="{{ it.fp_val|default('') }}" />
                    <span class="fp_check_text">{{ it.label }} <span class="f_cnt">({{ it.total }})</span></span>
                  </label>
                </li>
              {% endfor %}
            </ul>

          {% else %}
            <ul class="f_list">
              {% for it in b.items %}
                <li class="f_item">
                  <a href="{{ it.url }}" class="{% if it.selected %}active{% endif %}">
                    {{ it.label }} <span class="f_cnt">({{ it.total }})</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

        {% endif %}
      </div>
    </div>
  {% endfor %}

</div>

<script>
  // Multi-select apply: collect checked boxes and build /f/ URL
  var fpRoot = document.getElementById('filterpro');
  var applyBtn = document.getElementById('fp-apply');

  function buildUrlFromChecks() {
    if (!fpRoot) return null;
    var basePath = fpRoot.getAttribute('data-fp-base-path') || '';
    var baseQuery = fpRoot.getAttribute('data-fp-base-query') || '';
    var baseUrl = fpRoot.getAttribute('data-fp-base-url') || basePath;

    var sel = {};
    fpRoot.querySelectorAll('input[type="checkbox"][data-fp-key][data-fp-val]').forEach(function(cb){
      if (!cb.checked) return;
      var k = cb.getAttribute('data-fp-key') || '';
      var v = cb.getAttribute('data-fp-val') || '';
      if (!k || !v) return;
      if (!sel[k]) sel[k] = [];
      sel[k].push(String(v));
    });

    var keys = Object.keys(sel).sort();
    var parts = [];
    keys.forEach(function(k){
      var vals = Array.from(new Set(sel[k].filter(Boolean))).sort();
      if (!vals.length) return;
      parts.push(k + '_' + vals.join(','));
    });

    if (!parts.length) {
      return baseUrl;
    }

    var url = String(basePath).replace(/\/+$/, '') + '/f/' + parts.join('/');
    if (baseQuery) url += '?' + baseQuery;
    return url;
  }

  function markDirty() {
    if (applyBtn) applyBtn.disabled = false;
  }

  // When user changes any checkbox, enable Apply
  document.addEventListener('change', function(e) {
    var el = e.target;
    if (!el) return;
    if (el.matches && el.matches('#filterpro input[type="checkbox"][data-fp-key]')) {
      markDirty();
    }
  });

  if (applyBtn) {
    applyBtn.addEventListener('click', function(){
      var url = buildUrlFromChecks();
      if (url) window.location.href = url;
    });
  }

  // Price slider sync (no AJAX; just keeps inputs in sync)
  document.querySelectorAll('form[data-fp-price]').forEach(function(form) {
    var minRange = form.querySelector('[data-fp-min-range]');
    var maxRange = form.querySelector('[data-fp-max-range]');
    var minNum = form.querySelector('[data-fp-min-num]');
    var maxNum = form.querySelector('[data-fp-max-num]');
    var rangeEl = form.querySelector('[data-fp-range]');

    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

    function updateFill() {
      if (!rangeEl || !minRange || !maxRange) return;
      var lo = parseInt(minRange.min || '0', 10);
      var hi = parseInt(minRange.max || '0', 10);
      var vMin = parseInt(minRange.value || lo, 10);
      var vMax = parseInt(maxRange.value || hi, 10);
      var total = (hi - lo) || 1;
      var left = ((vMin - lo) / total) * 100;
      var right = ((vMax - lo) / total) * 100;
      rangeEl.style.left = left + '%';
      rangeEl.style.width = Math.max(0, right - left) + '%';
    }

    function syncFromRanges() {
      if (!minRange || !maxRange) return;
      var lo = parseInt(minRange.min || '0', 10);
      var hi = parseInt(minRange.max || '0', 10);
      var vMin = parseInt(minRange.value || lo, 10);
      var vMax = parseInt(maxRange.value || hi, 10);
      if (vMin > vMax) vMin = vMax;
      minRange.value = vMin;
      maxRange.value = vMax;
      if (minNum) minNum.value = vMin;
      if (maxNum) maxNum.value = vMax;
      updateFill();
    }

    function syncFromNumbers() {
      if (!minNum || !maxNum) return;
      var lo = parseInt(minNum.min || '0', 10);
      var hi = parseInt(minNum.max || '0', 10);
      var vMin = parseInt(minNum.value || lo, 10);
      var vMax = parseInt(maxNum.value || hi, 10);
      vMin = clamp(vMin, lo, hi);
      vMax = clamp(vMax, lo, hi);
      if (vMin > vMax) vMin = vMax;
      minNum.value = vMin;
      maxNum.value = vMax;
      if (minRange) minRange.value = vMin;
      if (maxRange) maxRange.value = vMax;
      updateFill();
    }

    if (minRange && maxRange) {
      minRange.addEventListener('input', syncFromRanges);
      maxRange.addEventListener('input', syncFromRanges);
      syncFromRanges();
    }

    if (minNum && maxNum) {
      minNum.addEventListener('change', syncFromNumbers);
      maxNum.addEventListener('change', syncFromNumbers);
    }
  });

  // Accordion
  document.addEventListener('click', function(e) {
    var t = e.target;
    if (!t) return;
    var title = t.closest && t.closest('[data-fp-toggle]');
    if (!title) return;
    var group = title.closest('[data-fp-group]');
    if (!group) return;
    if (t.closest('a')) return;
    if (t.closest('label')) return;
    if (t.closest('input')) return;
    group.classList.toggle('fp_collapsed');
  });
</script>

<style>
  .filterpro_like .f_group{margin:0 0 18px;}
  .filterpro_like .f_title{cursor:pointer;user-select:none;font-weight:700;margin:0 0 8px;}
  .filterpro_like .f_actions{margin:-6px 0 10px;display:flex;gap:10px;align-items:center;}
  .filterpro_like .fp_apply{background:#fed700;border:1px solid #e8c800;color:#000;padding:2px 10px;border-radius:3px;}
  .filterpro_like .fp_apply[disabled]{opacity:.5;cursor:not-allowed;}
  .filterpro_like .f_clear{font-size:12px;color:#666;text-decoration:underline;}

  .filterpro_like .fp_collapsed .f_body{display:none;}

  .filterpro_like .fp_tip{display:inline-block;margin-left:6px;width:16px;height:16px;line-height:16px;text-align:center;border-radius:50%;background:#eee;color:#555;font-size:12px;}

  .filterpro_like .f_list{list-style:none;margin:0;padding:0;}
  .filterpro_like .f_item{margin:0 0 6px;}
  .filterpro_like .f_item a{color:#333;text-decoration:none;}
  .filterpro_like .f_item a.active{font-weight:700;text-decoration:underline;}
  .filterpro_like .f_cnt{color:#999;font-weight:400;}

  .filterpro_like .fp_checks .fp_check{display:flex;gap:8px;align-items:center;cursor:pointer;}
  .filterpro_like .fp_checks input[type=checkbox]{margin:0;}

  .filterpro_like .f_colors{display:flex;flex-wrap:wrap;gap:6px;}
  .filterpro_like .f_color{display:inline-block;border:1px solid #ddd;padding:2px;border-radius:3px;}
  .filterpro_like .f_color.active{border-color:#fed700;}
  .filterpro_like .f_color img{display:block;width:22px;height:22px;object-fit:contain;}

  .filterpro_like .f_price .f_row{display:flex;gap:6px;align-items:center;margin:0 0 6px;}
  .filterpro_like .f_price input{width:100%;}
  .filterpro_like .fp_price_slider{position:relative;margin:0 0 12px;padding:10px 0 18px;}
  .filterpro_like .fp_price_slider .fp_track{position:absolute;left:0;right:0;top:18px;height:4px;background:#e5e5e5;border-radius:2px;}
  .filterpro_like .fp_price_slider .fp_range{position:absolute;top:18px;height:4px;background:#fed700;border-radius:2px;}
  .filterpro_like .fp_price_slider input[type=range]{position:absolute;left:0;right:0;top:10px;width:100%;pointer-events:none;background:transparent;-webkit-appearance:none;appearance:none;height:30px;margin:0;}
  .filterpro_like .fp_price_slider input[type=range]::-webkit-slider-thumb{pointer-events:auto;-webkit-appearance:none;appearance:none;width:14px;height:14px;border-radius:50%;background:#333;border:2px solid #fff;box-shadow:0 1px 2px rgba(0,0,0,.25);}
  .filterpro_like .fp_price_slider input[type=range]::-moz-range-thumb{pointer-events:auto;width:14px;height:14px;border-radius:50%;background:#333;border:2px solid #fff;box-shadow:0 1px 2px rgba(0,0,0,.25);}
  .filterpro_like .fp_price_slider input[type=range]::-webkit-slider-runnable-track{height:4px;background:transparent;}
  .filterpro_like .fp_price_slider input[type=range]::-moz-range-track{height:4px;background:transparent;}
  .filterpro_like .fp_price_slider .fp_ticks{display:flex;justify-content:space-between;font-size:11px;color:#777;margin-top:20px;}
</style>
