{# Manline menu
   If custom_menu is provided (legacy module data), render OC1.4/OC2-compatible markup.
   Else fall back to stock OC4 menu. #}

{% if custom_menu_module %}
  {{ custom_menu_module }}
{% elseif custom_menu and custom_menu|length %}
  <ul class="main_nav nav_menu mob_hid">
    {% for category in custom_menu %}
      <li class="catalog_list">
        <a href="{{ category.link }}">{{ category.name }}</a>

        {% if category.sub_menu and category.sub_menu|length %}
          <ul class="children_w list_menu ul_count{{ category.column }}">
            {% for sub in category.sub_menu %}
              <li class="col-md-{{ sub.column }}">
                {% if sub.link %}
                  <a href="{{ sub.link }}"><span>{{ sub.name }}</span></a>
                {% else %}
                  <span><span>{{ sub.name }}</span></span>
                {% endif %}

                {% if sub.sub_menu and sub.sub_menu|length %}
                  <ul>
                    {% for child in sub.sub_menu %}
                      {% if child.name == 'product' and child.product %}
                        <li class="product_menu_polt col-md-{{ child.column }}">
                          <div class="product_w noimgs">
                            <div class="product_in">
                              <div class="prod_info">
                                <a class="prod_image" href="{{ child.product.href }}">
                                  <img src="{{ child.product.image }}" title="{{ child.product.name }}" alt="{{ child.product.name }}" />
                                </a>
                                <div class="prod_name_w">
                                  <a class="prod_name" href="{{ child.product.href }}">{{ child.product.name_short }}</a>
                                </div>
                                <div class="prod_price">
                                  {% if child.product.price %}
                                    {% if not child.product.special %}
                                      {{ child.product.price|number_format(0, '.', '') }} грн.
                                    {% else %}
                                      <span class="price-old">{{ child.product.price|number_format(0, '.', '') }} грн.</span>
                                      <span class="price-new">{{ child.product.special|number_format(0, '.', '') }} грн.</span>
                                    {% endif %}
                                  {% endif %}
                                </div>
                              </div>
                            </div>
                          </div>
                        </li>
                      {% else %}
                        <li><a href="{{ child.link }}">{{ child.name }}</a></li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  <div class="clearfix"></div>
{% elseif categories %}
  <div class="container">
    <nav id="menu" class="navbar navbar-expand-lg bg-primary">
      <div id="category" class="d-block d-sm-block d-lg-none">{{ text_category }}</div>
      <button type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" class="navbar-toggler d-lg-none"><i class="fa-solid fa-bars"></i></button>
      <div id="navbar-menu" class="collapse navbar-collapse">
        <ul class="nav navbar-nav">
          {% for category in categories %}
            {% if category.children %}
              {% set total = category.children|length %}
              {% if total > 20 %}
                {% set batch = (total / 4)|round(0, 'ceil') %}
                {% set column = 4 %}
              {% else %}
                {% set batch = 5 %}
                {% set column = (total / 5)|round(0, 'ceil') %}
              {% endif %}
              <li class="nav-item dropdown"><a href="{{ category.href }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">{{ category.name }}</a>
                <div class="dropdown-menu dropdown-column-{{ column }}">
                  <div class="dropdown-inner">
                    {% for children in category.children|batch(batch) %}
                      <ul class="list-unstyled">
                        {% for child in children %}
                          <li><a href="{{ child.href }}" class="dropdown-item">{{ child.name }}</a></li>
                        {% endfor %}
                      </ul>
                    {% endfor %}
                  </div>
                  <ul class="list-unstyled">
                    <li>
                      <hr class="dropdown-divider">
                    </li>
                    <li><a href="{{ category.href }}" class="dropdown-item">{{ text_all }} {{ category.name }}</a></li>
                  </ul>
                </div>
              </li>
            {% else %}
              <li class="nav-item"><a href="{{ category.href }}" class="dropdown-item">{{ category.name }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </nav>
  </div>
{% endif %}
