{{ header }}

{# Allow modules to render at the top of home (Homepage Slideshow / Index Banner is managed via admin → Design → Layouts → Home → Content Top) #}
{{ content_top }}

<div id="common-home" class="container">
  <div class="row">

    {# Benefits row (OC2-like) #}
    {% if home_features is defined and home_features %}
      <div class="col-xs-12">
        <div class="pre_wrap mob_hid">
          {% for f in home_features %}
            <div class="col-xs-3 pre_w{% if loop.last %} bn{% endif %}">
              <img src="/{{ f.image }}" alt="{% if lang == 'uk-ua' %}{{ f.alt_ua|default(f.alt_ru|default('')) }}{% else %}{{ f.alt_ru|default(f.alt_ua|default('')) }}{% endif %}" class="pre pre{{ loop.index }}"/>
              <div class="pre_td">
                <div class="pre_t">
                  {% if lang == 'uk-ua' %}{{ f.title_ua|default(f.title_ru|default('')) }}{% else %}{{ f.title_ru|default(f.title_ua|default('')) }}{% endif %}
                </div>
                <div class="pre_d">
                  {% if lang == 'uk-ua' %}{{ f.desc_ua|default(f.desc_ru|default('')) }}{% else %}{{ f.desc_ru|default(f.desc_ua|default('')) }}{% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="clearfix"></div>

        {# Top categories grid (OC2: top categories with image) #}
        {% if home_top_categories is defined and home_top_categories %}
          <div class="row mt-40">
            {% for c in home_top_categories %}
              <div class="col-xs-6 col-md-4 mb-30">
                <a href="{{ c.href }}">
                  <img class="res_img" src="{{ c.image }}" alt="{{ c.name|e }}" loading="lazy"/>
                </a>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {# Category tiles (from home.json) - 2x3 image tiles with caption baked into images (OC2-like) #}
    {% if home_category_tiles is defined and home_category_tiles %}
      <div class="col-xs-12 home-cat-tiles" style="margin-top:20px">
        <div class="row">
          {% for t in home_category_tiles %}
            <div class="col-xs-12 col-sm-4">
              <a class="cat_sub" href="{{ t.href }}">
                {% set img_src = (lang == 'uk-ua') ? (t.image_ua|default(t.image_ru|default(t.image|default('')))) : (t.image_ru|default(t.image_ua|default(t.image|default('')))) %}
                {% if img_src and (img_src starts with 'http' or img_src starts with '/') %}
                  <img src="{{ img_src }}" alt="" loading="lazy"/>
                {% else %}
                  <img src="/{{ img_src }}" alt="" loading="lazy"/>
                {% endif %}
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Popular brands carousel (OC2-like) #}
    {% if home_brands is defined and home_brands %}
      <div class="col-xs-12">
        <div class="container">
          <div class="title mt-20"><span>{% if lang == 'uk-ua' %}Популярні бренди{% else %}Популярные бренды{% endif %}</span></div>
          <div class="clearfix"></div>
          <div class="brand_carousel">
            {% for b in home_brands %}
              <div class="brand_carousel_item">
                <a href="{{ b.href }}" class="manuf_cat_href">
                  <img src="{{ b.image starts with 'http' or b.image starts with '/' ? b.image : '/image/' ~ b.image }}" alt="" loading="lazy"/>
                  <span class="manuf_cat_name">{{ b.name }}</span>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}

    {# Panda Code-like recommended blocks (manual from admin). If configured, they replace legacy auto carousels. #}
    {% if home_recommended_blocks is defined and home_recommended_blocks %}
      {% for b in home_recommended_blocks %}
        {# Render using EXACT same markup as the legacy carousels (bestseller/special) #}
        <div class="col-xs-12" style="margin-top:35px">
          <div class="title">
            <h2>
              {% if lang == 'uk-ua' %}{{ b.title_ua|default(b.title_ru|default('')) }}{% else %}{{ b.title_ru|default(b.title_ua|default('')) }}{% endif %}
            </h2>
          </div>
          <div class="carusel_prod">
            {% for p in b.items %}
              {{ p }}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      {# Sale carousel (Specials) #}
      {% if home_special_products is defined and home_special_products %}
        <div class="col-xs-12" style="margin-top:35px">
          <div class="title">
            <h2>
              {% if lang == 'uk-ua' %}{{ home_special_title_ua|default('Розпродаж') }}{% else %}{{ home_special_title_ru|default('Распродажа') }}{% endif %}
            </h2>
          </div>
          <div class="carusel_prod">
            {% for p in home_special_products %}
              {{ p }}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {# Popular products carousel (BestSeller) #}
      {% if home_bestseller_products is defined and home_bestseller_products %}
        <div class="col-xs-12" style="margin-top:35px">
          <div class="title">
            <h2>
              {% if lang == 'uk-ua' %}{{ home_bestseller_title_ua|default('Популярні товари') }}{% else %}{{ home_bestseller_title_ru|default('Популярные товары') }}{% endif %}
            </h2>
          </div>
          <div class="carusel_prod">
            {% for p in home_bestseller_products %}
              {{ p }}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endif %}

    {# Underwear category block (OC2-like) #}
    {% if home_underwear_rows is defined and home_underwear_rows %}
      <div class="col-xs-12" style="margin-top:35px">
        <div class="container">
          <div class="category">
            <div class="title mt-40">
              <h1>{% if lang == 'uk-ua' %}Купити чоловічу білизну{% else %}Купить мужское белье{% endif %}</h1>
            </div>

            <div class="mob_row">
              {% for r in home_underwear_rows %}
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-3">
                    <a href="{{ r.href }}" class="cat_href">
                      <span class="bord">
                        <span class="cat_text">
                          <span class="cat_title">{% if lang == 'uk-ua' %}{{ r.title_ua }}{% else %}{{ r.title_ru }}{% endif %}</span>
                          <span class="cat_desc">{% if lang == 'uk-ua' %}{{ r.desc_ua }}{% else %}{{ r.desc_ru }}{% endif %}</span>
                          <span class="btn">{% if lang == 'uk-ua' %}Дивитись все{% else %}Смотреть все{% endif %}</span>
                        </span>
                      </span>
                      <img class="cat_img_bg" src="{{ r.bg }}" alt="" loading="lazy"/>
                      <span class="bl_o"></span>
                    </a>
                  </div>

                  <div class="col-xs-9 mob_hid">
                    <div class="row">
                      {% for p in r.items %}
                        <div class="col-xs-4 col-sm-3 product_w noimgs{% if loop.index0 == 3 %} mob_hid{% endif %}">
                          <div class="product_in">
                            <div class="prod_info">
                              <a class="prod_image" href="{{ p.href }}">
                                <img src="{{ p.image }}" title="{{ p.name|e }}" alt="{{ p.name|e }}" loading="lazy"/>
                              </a>
                              <div class="prod_name_w">
                                <a class="prod_name" href="{{ p.href }}">{{ p.name }}</a>
                              </div>

                              {% if p.quantity > 0 %}
                                <div class="prod_stock">{% if lang == 'uk-ua' %}Є в наявності{% else %}Есть в наличии{% endif %}</div>
                              {% else %}
                                <div class="prod_stock no_stock">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>
                              {% endif %}

                              <div class="prod_price">
                                {% if p.special_raw %}
                                  <span class="price-old">{{ p.price_raw|round(0, 'floor') }} грн.</span> <span class="price-new">{{ p.special_raw|round(0, 'floor') }} грн.</span>
                                {% else %}
                                  {{ p.price_raw|round(0, 'floor') }} грн.
                                {% endif %}
                              </div>

                              <div class="hover_tovar">
                                {% if p.model %}
                                  <div class="hover_t_b"><span class="hov_text">{% if lang == 'uk-ua' %}Код товару:{% else %}Код товара:{% endif %}</span> <span class="hot_text">{{ p.model }}</span></div>
                                {% endif %}
                                {% if p.sizes %}
                                  <div class="hover_t_b"><span class="hov_text">{% if lang == 'uk-ua' %}Розміри в наявності:{% else %}Размеры в наличии:{% endif %}</span> <span class="hot_text">{{ p.sizes }}</span></div>
                                {% endif %}
                              </div>
                            </div>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {# Featured products carousel (legacy placeholder) removed for 1:1 home parity #}

    {# Blog: latest posts (fast path: from home.json) #}
    {% if home_blog_posts is defined and home_blog_posts %}
      <div class="col-xs-12">
        <div class="blog_w mt-70">
          <div class="container">
            <div class="title mb-40">
              <span>{% if lang == 'uk-ua' %}{{ home_blog_title_ua|default('Останнє з блогу') }}{% else %}{{ home_blog_title_ru|default('Последнее из блога') }}{% endif %}</span>
            </div>
            <div class="blog_items_w">
              {% for b in home_blog_posts %}
                <div class="col-xs-12 col-md-4 blog_item_w">
                  <div class="blog_item_in">
                    {# b.image may be a full URL (model_tool_image->resize) or a relative path #}
                    {% set img_src = b.image|default('') %}
                    {% if img_src and (img_src starts with 'http' or img_src starts with '/') %}
                      <a class="blog_img_w" href="{{ b.href }}"><img src="{{ img_src }}" alt="" loading="lazy"/></a>
                    {% else %}
                      <a class="blog_img_w" href="{{ b.href }}"><img src="/{{ img_src }}" alt="" loading="lazy"/></a>
                    {% endif %}
                    <div class="blog_title_w">
                      <a href="{{ b.href }}" class="blog_title">
                        {% if lang == 'uk-ua' %}{{ b.title_ua|default(b.title_ru|default('')) }}{% else %}{{ b.title_ru|default(b.title_ua|default('')) }}{% endif %}
                      </a>
                      {% set blog_desc = (lang == 'uk-ua') ? (b.desc_ua|default(b.desc_ru|default(''))) : (b.desc_ru|default(b.desc_ua|default(''))) %}
                      {% if blog_desc %}
                        <div class="blog_desc">{{ blog_desc }}</div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="blog_dop">
                    <div class="blog_date">
                      <div class="date_d">{{ b.date_day|default('') }}</div>
                      <div class="date_m_y">
                        {% if lang == 'uk-ua' %}{{ b.date_month_ua|default(b.date_month_ru|default('')) }}{% else %}{{ b.date_month_ru|default(b.date_month_ua|default('')) }}{% endif %} <br>
                        {{ b.date_year|default('') }}
                      </div>
                    </div>
                    <a href="{{ b.href }}" class="read_more">
                      {% if lang == 'uk-ua' %}{{ b.read_more_ua|default(b.read_more_ru|default('Читати статтю')) }}{% else %}{{ b.read_more_ru|default(b.read_more_ua|default('Читать статью')) }}{% endif %}
                    </a>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {# SEO text block (OC2 legacy). Hidden on mobile. #}
    <div class="container seo_text mt-40 mob_hid"><!--seo_text_start-->

      <h2>{% if lang == 'uk-ua' %}Філософія нашого інтернет магазину{% else %}Философия нашего интернет магазина{% endif %}</h2>
      <p>
        {% if lang == 'uk-ua' %}
          Man Line – інтернет магазин, в якому ви зможете купити чоловічу спідню білизну відомих світових брендів для себе та своїх близьких, а також підібрати аксесуари на будь-який випадок.
          <br><br>
          Це не правда, що чоловіки не мають своїх пунктиків і улюблених аксесуарів. Ми знаємо, наскільки важливо кожному представнику сильної статі почуватися комфортно і в той же час – стильно. Тому питання вибору чоловічої нижньої білизни, шкарпеток, краваток і навіть приладів для гоління має величезне значення. Ми знаємо, чим вас здивувати, що порекомендувати, як правильно підібрати необхідні деталі туалету, які підкреслять індивідуальність та відмінний смак.
        {% else %}
          Man Line – интернет магазин, в котором вы сможете купить мужское нижнее белье известных мировых брендов для себя и своих близких, а также подобрать аксессуары на любой случай.
          <br><br>
          Это не правда, что у мужчин нет своих пунктиков и любимых аксессуаров. Мы знаем, как важно каждому представителю сильного пола чувствовать себя комфортно и в то же время – стильно. Поэтому вопрос выбора мужского нижнего белья, носков, галстуков и даже бритвенных приборов имеет огромное значение. Мы знаем, чем вас удивить, что порекомендовать, как правильно подобрать необходимые детали туалета, которые подчеркнут индивидуальность и отменный вкус.
        {% endif %}
      </p>

      <h2>{% if lang == 'uk-ua' %}У чому особливість нашого асортименту чоловічої нижньої білизни?{% else %}В чем особенность нашего ассортимента мужского нижнего белья?{% endif %}</h2>
      {% if lang == 'uk-ua' %}
      <ol>
        <li>У нашому магазині ви зможете купити чоловічу білизну відомих світових брендів, таких як Key, Calvin Kline, Atlantic, Andrew Christina. А це означає, що ви отримуєте не тільки стильну інтимну деталь гардеробу, але відмінну якість. Вся наша продукція проходить ретельний відбір та обов'язкову перевірку, таким чином, чоловіча спідня білизна відповідає всім критеріям безпеки.</li>
        <li>Нижня білизна для чоловіків зробила крок далеко вперед, і кількість різноманітних моделей вражає уяву навіть затятих модників. У нас ви зможете купити чоловічу білизну будь-якого фасону: від вільних боксерів до пікантних сліпів.</li>
        <li>Не тільки форма та тканина має значення. Ми знаємо, що колір чоловічої білизни іноді багато що вирішує. Комусь хочеться яскравих і насичених кольорів, щоб розфарбувати буденну сірість, хтось віддає перевагу класичним білим або чорним тонам. У нашому магазині ви зможете купити чоловічу білизну будь-якого відтінку: від трендового кольору марсали, до практичного чорного.</li>
        <li>Кожен сезон та пора року диктує свої правила. До нашого асортименту ми включаємо і модні новинки, і сезонні тренди, так що на нашому сайті ви зможете не тільки вибрати нижню білизну, а й коротко ознайомитися з новинами світу моди. Крім того, підготуватися до пляжного сезону і вибрати шорти та плавки або забезпечити собі комфорт на зиму, купивши термобілизну.</li>
        <li>Чоловіча спідня білизна має значення, але не тільки вона створює образ. Сильна сучасна людина повинна враховувати у своєму гардеробі всі деталі, тому ми пропонуємо широкий вибір аксесуарів: від краваток і підтяжок, до приладів для гоління і навіть сумок.</li>
        <li>Відокремити чоловіче від жіночого часом буває дуже важко. Тому на нашому сайті дівчата можуть не тільки вибрати подарунок для коханої людини або друга, але й доглянути жіночу нижню білизну для себе, зрештою, це теж певною мірою подарунок для коханого, чи не так?</li>
      </ol>
      {% else %}
      <ol>
        <li>В нашем магазине вы сможете купить мужское нижнее белье известных мировых брендов, таких как Key, Calvin Kline, Atlantic, Andrew Christina. А  это значит, что вы получаете не только стильную интимную деталь гардероба, но отменное качество. Вся наша продукция проходит тщательный отбор и обязательную проверку, таким образом, мужское нижнее белье соответствует всем критериям безопасности.</li>
        <li>Нижнее белье для мужчин шагнуло далеко вперед, и количество разнообразных моделей поражает воображение даже заядлых модников. У нас вы сможете купить мужское белье любого фасона: от свободных боксеров, до пикантных слипов.</li>
        <li>Не только форма и ткань имеет значение. Мы знаем, что цвет мужского белья иногда многое решает. Кому-то хочется ярких и насыщенных цветов, чтобы раскрасить будничную серость, кто-то предпочитает классические белые или черные тона. В нашем магазине вы сможете купить мужское белье любого оттенка: от трендового цвета марсалы, до - практичного черного.</li>
        <li>Каждый сезон и время года диктует свои правила. В наш ассортимент мы включаем и модные новинки, и сезонные тренды, так что на нашем сайте вы сможете не только выбрать нижнее белье, но и коротко ознакомится с новостями мира моды. Кроме того, подготовится к пляжному сезону и выбрать шорты и плавки или же обеспечить себе комфорт на зиму, купив термобелье.</li>
        <li>Мужское нижнее белье имеет значение, но не только оно создает образ. Сильный современный человек должен учитывать в своем гардеробе все детали, поэтому мы предлагаем так же широкий выбор аксессуаров: от галстуков и подтяжек, до бритвенных приборов и даже сумок.</li>
        <li>Отделить мужское от женского порой бывает очень тяжело. Поэтому на нашем сайте девушки могут не только выбрать подарок для любимого человека или друга, но и присмотреть женское нижнее белье для себя, в конце концов, это тоже в какой-то степени подарок для любимого, не правда ли?</li>
      </ol>
      {% endif %}

      <h2>{% if lang == 'uk-ua' %}Переваги, які ви отримуєте, при покупці в Man Line{% else %}Преимущества, которые вы получаете, при покупке в Man Line{% endif %}</h2>
      {% if lang == 'uk-ua' %}
      <ul>
        <li>Ми уважні до делікатних питань, наші стилісти завжди готові допомогти підібрати необхідну деталь туалету, порадити та порекомендувати фасон чи крій, який буде найкомфортнішим для вас.</li>
        <li>Ми в курсі новинок і раді повідомити всі новини світу високої моди, щоб ви завжди були в тренді.</li>
        <li>Ми маємо високу якість і досить лояльні ціни. За помірну суму від 99 грн, ви отримуєте брендову якісну спідню білизну.</li>
        <li>Швидка доставка, легкість в оформленні замовлення та будь-яка зручна форма оплати замовлення – це необхідний мінімум у роботі будь-якого інтернет магазину, який і обговорювати не варто. Ми гарантуємо вам, що вирішивши купити спідню чоловічу білизну або будь-який інший аксесуар у нас, ви зможете це зробити без труднощів, швидко, зручно, в будь-який момент.</li>
      </ul>
      {% else %}
      <ul>
        <li>Мы внимательны к деликатным вопросам, наши стилисты всегда готовы помочь подобрать необходимую деталь туалета, посоветовать и порекомендовать фасон или крой, который будет наиболее комфортным для вас.</li>
        <li>Мы в курсе новинок и рады сообщить вам все новости мира высокой моды, чтобы вы всегда были в тренде.</li>
        <li>У нас высокое качество и довольно лояльные цены. За умеренную сумму от 99 грн, вы получаете брендовое качественное нижнее белье.</li>
        <li>Быстрая доставка, лекгость в оформлении заказа и любая удобная форма оплаты заказа – это тот необходимый минимум в работе любого интернет магазина, который и обсуждать не стоит. Мы гарантируем вам, что решив купить нижнее мужское белье или любой другой аксессуар у нас, вы сможете это сделать без затруднений, быстро, удобно, в любой момент.</li>
