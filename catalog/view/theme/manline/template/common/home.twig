{{ header }}

<div id="common-home" class="container">
  <div class="row">

    {# Allow modules to render at the top of home (place Manline Slider module here via Layouts) #}
    {{ content_top }}

    {# Legacy Home slider (from home.json) #}
    {% if home_slider is defined and home_slider %}
      <div class="col-xs-12">
        <div class="slider_w">
          {% for s in home_slider %}
            <div>
              <div class="slider_item">
                {% set img_src = s.image|default('') %}
                {% if img_src and (img_src starts with 'http' or img_src starts with '/') %}
                  <img src="{{ img_src }}" alt="" loading="lazy" style="width:100%"/>
                {% else %}
                  <img src="/{{ img_src }}" alt="" loading="lazy" style="width:100%"/>
                {% endif %}
                {% if s.href %}<a class="slider_link" href="{{ s.href }}"></a>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Benefits row (OC2-like) #}
    {% if home_features is defined and home_features %}
      <div class="col-xs-12">
        <div class="pre_wrap mob_hid">
          {% for f in home_features %}
            <div class="col-xs-3 pre_w{% if loop.last %} bn{% endif %}">
              <img src="/{{ f.image }}" alt="{% if lang == 'uk-ua' %}{{ f.alt_ua|default(f.alt_ru|default('')) }}{% else %}{{ f.alt_ru|default(f.alt_ua|default('')) }}{% endif %}" class="pre pre{{ loop.index }}"/>
              <div class="pre_td">
                <div class="pre_t">
                  {% if lang == 'uk-ua' %}{{ f.title_ua|default(f.title_ru|default('')) }}{% else %}{{ f.title_ru|default(f.title_ua|default('')) }}{% endif %}
                </div>
                <div class="pre_d">
                  {% if lang == 'uk-ua' %}{{ f.desc_ua|default(f.desc_ru|default('')) }}{% else %}{{ f.desc_ru|default(f.desc_ua|default('')) }}{% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="clearfix"></div>

        {# Top categories grid (OC2: top categories with image) #}
        {% if home_top_categories is defined and home_top_categories %}
          <div class="row mt-40">
            {% for c in home_top_categories %}
              <div class="col-xs-6 col-md-4 mb-30">
                <a href="{{ c.href }}">
                  <img class="res_img" src="{{ c.image }}" alt="{{ c.name|e }}" loading="lazy"/>
                </a>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {# Popular brands carousel (OC2-like) #}
    {% if home_brands is defined and home_brands %}
      <div class="col-xs-12">
        <div class="container">
          <div class="title mt-20"><span>{% if lang == 'uk-ua' %}Популярні бренди{% else %}Популярные бренды{% endif %}</span></div>
          <div class="clearfix"></div>
          <div class="brand_carousel">
            {% for b in home_brands %}
              <div class="brand_carousel_item">
                <a href="{{ b.href }}" class="manuf_cat_href">
                  <img src="{{ b.image starts with 'http' or b.image starts with '/' ? b.image : '/image/' ~ b.image }}" alt="" loading="lazy"/>
                  <span class="manuf_cat_name">{{ b.name }}</span>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}

    {# Legacy Category tiles (from home.json) #}
    {% if home_category_tiles is defined and home_category_tiles %}
      <div class="col-xs-12" style="margin-top:20px">
        <div class="row">
          {% for t in home_category_tiles %}
            <div class="col-xs-12 col-sm-4">
              <a class="cat_sub" href="{{ t.href }}">
                <img src="/{{ t.image }}" alt="" loading="lazy"/>
                <span class="cat_sub_name">
                  {% if lang == 'uk-ua' %}
                    {{ t.title_ua|default(t.title_ru|default('')) }}
                  {% else %}
                    {{ t.title_ru|default(t.title_ua|default('')) }}
                  {% endif %}
                </span>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Featured products carousel #}
    {% if home_featured_products is defined and home_featured_products %}
      <div class="col-xs-12" style="margin-top:35px">
        <div class="title">
          <h2>
            {% if lang == 'uk-ua' %}{{ home_featured_title_ua|default('Рекомендуємо') }}{% else %}{{ home_featured_title_ru|default('Рекомендуем') }}{% endif %}
          </h2>
        </div>
        <div class="carusel_prod">
          {% for p in home_featured_products %}
            {{ p }}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Blog: latest posts (fast path: from home.json) #}
    {% if home_blog_posts is defined and home_blog_posts %}
      <div class="col-xs-12">
        <div class="blog_w mt-70">
          <div class="container">
            <div class="title mb-40">
              <span>{% if lang == 'uk-ua' %}{{ home_blog_title_ua|default('Останнє з блогу') }}{% else %}{{ home_blog_title_ru|default('Последнее из блога') }}{% endif %}</span>
            </div>
            <div class="blog_items_w">
              {% for b in home_blog_posts %}
                <div class="col-xs-12 col-md-4 blog_item_w">
                  <div class="blog_item_in">
                    {# b.image may be a full URL (model_tool_image->resize) or a relative path #}
                    {% set img_src = b.image|default('') %}
                    {% if img_src and (img_src starts with 'http' or img_src starts with '/') %}
                      <a class="blog_img_w" href="{{ b.href }}"><img src="{{ img_src }}" alt="" loading="lazy"/></a>
                    {% else %}
                      <a class="blog_img_w" href="{{ b.href }}"><img src="/{{ img_src }}" alt="" loading="lazy"/></a>
                    {% endif %}
                    <div class="blog_title_w">
                      <a href="{{ b.href }}" class="blog_title">
                        {% if lang == 'uk-ua' %}{{ b.title_ua|default(b.title_ru|default('')) }}{% else %}{{ b.title_ru|default(b.title_ua|default('')) }}{% endif %}
                      </a>
                      {% set blog_desc = (lang == 'uk-ua') ? (b.desc_ua|default(b.desc_ru|default(''))) : (b.desc_ru|default(b.desc_ua|default(''))) %}
                      {% if blog_desc %}
                        <div class="blog_desc">{{ blog_desc }}</div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="blog_dop">
                    <div class="blog_date">
                      <div class="date_d">{{ b.date_day|default('') }}</div>
                      <div class="date_m_y">
                        {% if lang == 'uk-ua' %}{{ b.date_month_ua|default(b.date_month_ru|default('')) }}{% else %}{{ b.date_month_ru|default(b.date_month_ua|default('')) }}{% endif %} <br>
                        {{ b.date_year|default('') }}
                      </div>
                    </div>
                    <a href="{{ b.href }}" class="read_more">
                      {% if lang == 'uk-ua' %}{{ b.read_more_ua|default(b.read_more_ru|default('Читати статтю')) }}{% else %}{{ b.read_more_ru|default(b.read_more_ua|default('Читать статью')) }}{% endif %}
                    </a>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {# Keep OC4 layout module positions (content_top moved to top) #}
    {{ content_bottom }}

  </div>
</div>

{{ footer }}