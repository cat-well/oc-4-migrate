{# OC2 legacy mobile search (shown at the bottom on mobile) #}
<div class="container only_mob mt-40 mb-20" id="content">
  <div class="title mb-30"><span>{{ text_search }}</span></div>
  <div class="searchpage">
    <input class="otsledit_inp" type="text" name="search" size="50" value="" id="mobile-search-input" placeholder="{{ text_search }}" autocomplete="off"/>
    <input type="hidden" name="description" value="1" id="mobile-search-description"/>
    <input type="button" value="{{ text_search }}" id="mobile-button-search" class="button btn"/>
  </div>
</div>

<script>
  (function () {
    var btn = document.getElementById('mobile-button-search');
    var input = document.getElementById('mobile-search-input');
    if (!btn || !input) return;

    function go() {
      var q = (input.value || '').trim();

      // Use backend-generated SEO-friendly search URL (same route as header).
      var url = '{{ search_url|e('js') }}';

      // Append query params safely.
      url += (url.indexOf('?') === -1 ? '?' : '&') + 'search=' + encodeURIComponent(q);
      // Legacy footer block always sent description=1
      url += '&description=1';

      window.location.href = url;
    }

    btn.addEventListener('click', go);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        go();
      }
    });
  })();
</script>

