{# Manline mini-cart (ported from legacy template/module/cart.tpl) #}
<div id="cart" class="cart-popup">
  <div class="heading">
    <a href="{{ checkout }}" class="cart_href" title="{{ heading_title|default('Корзина') }}">
      <span aria-hidden="true" class="glyphicon glyphicon-shopping-cart"></span>
      <span id="cart-total">{{ text_items }}</span>
    </a>
  </div>

  <div class="content white-popup mfp-with-anim">
    <button class="mfp-close" type="button" title="Close (Esc)">×</button>

    {% if products %}
      <div class="mini-cart-info">
        <div class="items">
          {% for product in products %}
            <div class="items-inner">
              <div class="cart-item-image">
                <a href="{{ product.href }}">
                  {% if product.thumb %}
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" />
                  {% endif %}
                </a>
              </div>

              <div class="cart-item-info">
                <div class="cart-item-title">
                  <a href="{{ product.href }}">{{ product.name }}</a>
                  {% if product.option %}
                    {% for option in product.option %}
                      <div class="cart_options">{{ option.name }} {{ option.value }}</div>
                    {% endfor %}
                  {% endif %}
                </div>

                <div class="cart-item-price">
                  <span class="pl_min">
                    <img class="pm_cart" src='catalog/view/theme/manline/image/minus.png' onclick='poltoQntUpdate("{{ product.key }}", {{ product.quantity - 1 }})'>
                    <span class="cart_quantity">{{ product.quantity }}</span>
                    <img class="pm_cart" src='catalog/view/theme/manline/image/plus.png' onclick='poltoQntUpdate("{{ product.key }}", {{ product.quantity + 1 }})'>
                  </span>
                  <span class="money">{{ product.total }}</span>
                </div>
              </div>

              <img class="cart-close" src="catalog/view/theme/manline/image/remove-small.png" alt="{{ button_remove|default('Удалить') }}" title="{{ button_remove|default('Удалить') }}" onclick="$('#cart').load('{{ list }} #cart > *');" />
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="mini-cart-total subtotal">
        {% for total in totals %}
          {% if total.code == 'total' %}
            <div class="total_w itogo">
              <span class="price_all_text">{{ total.title }}</span>
              <span class="cart-item-total-price"><span class="money">{{ total.text }}</span></span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="center">
        <div class="checkout action">
          <a href="#" class="gost">Продолжить покупки</a>
          <a class="button btn" href="{{ checkout }}">Оформить заказ</a>
        </div>
      </div>
    {% else %}
      <div class="empty">{{ text_empty|default('Ваша корзина пуста!') }}</div>
    {% endif %}
  </div>

  <a class="mob_btn" href="{{ checkout }}"></a>
</div>

<script type="text/javascript">
function poltoQntUpdate(key, quantity) {
  // Minimal stub: refresh cart block (full legacy behavior can be added later)
  $('#cart').load('{{ list }} #cart > *');
}
</script>
