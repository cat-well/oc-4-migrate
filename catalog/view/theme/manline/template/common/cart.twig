{# Manline mini-cart (ported from legacy template/module/cart.tpl) #}
<div id="cart" class="cart-popup">
  <div class="heading">
    <a href="{{ checkout }}" class="cart_href" title="{{ heading_title }}">
      <span id="cart-total">{{ text_items|raw }}</span>
    </a>
  </div>

  <div class="content white-popup mfp-with-anim">
    <button class="mfp-close" type="button" title="Close (Esc)">×</button>

    {% if products %}
      <div class="mini-cart-info">
        <div class="items">
          {% for product in products %}
            <div class="items-inner">
              <div class="cart-item-image">
                <a href="{{ product.href }}">
                  {% if product.thumb %}
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" />
                  {% endif %}
                </a>
              </div>

              <div class="cart-item-info">
                <div class="cart-item-title">
                  <a href="{{ product.href }}">{{ product.name }}</a>
                  {% if product.option %}
                    {% for option in product.option %}
                      <div class="cart_options">{{ option.name }} {{ option.value }}</div>
                    {% endfor %}
                  {% endif %}
                </div>

                <div class="cart-item-price">
                  <span class="pl_min">
                    <img class="pm_cart" src='catalog/view/theme/manline/image/minus.png' onclick='poltoQntUpdate("{{ product.cart_id }}", {{ product.quantity - 1 }})'>
                    <span class="cart_quantity">{{ product.quantity }}</span>
                    <img class="pm_cart" src='catalog/view/theme/manline/image/plus.png' onclick='poltoQntUpdate("{{ product.cart_id }}", {{ product.quantity + 1 }})'>
                  </span>
                  <span class="money">{{ product.total }}</span>
                </div>
              </div>

              <img class="cart-close" src="catalog/view/theme/manline/image/remove-small.png" alt="{{ button_remove|default('Удалить') }}" title="{{ button_remove|default('Удалить') }}" onclick="poltoCartRemove('{{ product.cart_id }}');" />
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="mini-cart-total subtotal">
        {% for total in totals %}
          {% if total.code == 'total' %}
            <div class="total_w itogo">
              <span class="price_all_text">{{ total.title }}</span>
              <span class="cart-item-total-price"><span class="money">{{ total.text }}</span></span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="center">
        <div class="checkout action">
          <a href="#" class="gost">{{ text_continue_shopping }}</a>
          <a class="button btn" href="{{ checkout }}">{{ text_checkout }}</a>
        </div>
      </div>
    {% else %}
      <div class="empty">{{ text_empty }}</div>
    {% endif %}
  </div>

  <a class="mob_btn" href="{{ checkout }}"></a>
</div>

<script type="text/javascript">
(function() {
  function refreshMiniCart() {
    // Refresh cart block markup (works both for header and popup)
    $('#cart').load('{{ list }} #cart > *');
  }

  window.poltoQntUpdate = function(key, quantity) {
    quantity = parseInt(quantity, 10);

    // legacy theme sometimes calls -1 / 0 → treat as remove
    if (!quantity || quantity < 1) {
      return window.poltoCartRemove(key);
    }

    $.ajax({
      url: 'index.php?route=checkout/cart.edit&language={{ language }}',
      type: 'post',
      data: {
        key: key,
        quantity: quantity
      },
      dataType: 'json',
      complete: function() {
        refreshMiniCart();
      }
    });
  };

  window.poltoCartRemove = function(key) {
    $.ajax({
      url: 'index.php?route=checkout/cart.remove&language={{ language }}&key=' + encodeURIComponent(key),
      type: 'get',
      dataType: 'json',
      complete: function() {
        refreshMiniCart();
      }
    });
  };
})();
</script>
