{# Manline OC4 theme — header 1:1 scaffold
   Goal: preserve OC2 markup/classes so existing CSS/JS works.
   (We will refine language switch + dynamic texts later.) #}
<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2176J7CZKG"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-2176J7CZKG');
  </script>

  <meta charset="UTF-8"/>
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">

  {# TODO: replicate OC2 robots/noindex rules based on route, sort/limit/page #}

  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}

  {# OpenGraph basics (OC2 had more fields; can be extended later) #}
  <meta property="og:title" content="{{ title }}"/>
  <meta property="og:type" content="website"/>

  {% if icon %}
    <link rel="icon" href="{{ icon }}" type="image/png">
  {% endif %}

  {# Core OpenCart assets (keep) #}
  <script src="{{ jquery }}" type="text/javascript"></script>
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>

  {# Legacy Manline CSS (1:1) #}
  <link rel="stylesheet" href="catalog/view/theme/manline/stylesheet/stylesheet.css?v=20260701-1"/>
  <link rel="stylesheet" href="catalog/view/theme/manline/stylesheet/slicknav.css"/>
  <link rel="stylesheet" href="catalog/view/theme/manline/stylesheet/magnific-popup.css"/>
  <link rel="stylesheet" href="catalog/view/theme/manline/stylesheet/tooltipster.bundle.css"/>
  <link rel="stylesheet" href="catalog/view/theme/manline/stylesheet/bootstrap.css"/>
  <link rel="stylesheet" href="catalog/view/theme/manline/stylesheet/fontawesome-all.min.css"/>

  {# IMPORTANT: For 1:1 parity we avoid loading OC4 default bootstrap/stylesheet here,
     because they override Manline legacy CSS (icons/alignments, cart/search styles). #}
  {# <link href="{{ bootstrap }}" type="text/css" rel="stylesheet" media="screen"/> #}
  {# <link href="{{ icons }}" rel="stylesheet" type="text/css"/> #}
  {# <link href="{{ stylesheet }}" type="text/css" rel="stylesheet"/> #}

  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}

  {# Legacy Manline JS (1:1) #}
  <script>
    // Used by legacy OC2-style theme JS for AJAX endpoints
    window.ocLanguage = '{{ current_language }}';
  </script>
  <script src="catalog/view/theme/manline/js/common.js" type="text/javascript"></script>
  <script src="catalog/view/theme/manline/js/polt_menu.js" type="text/javascript"></script>
  <script src="catalog/view/theme/manline/js/jquery.cookie.js"></script>
  <script src="catalog/view/theme/manline/js/jquery.magnific-popup.min.js"></script>
  <script src="catalog/view/theme/manline/js/jquery.elevateZoom-3.0.8.min.js"></script>
  <script src="catalog/view/theme/manline/js/tooltipster.bundle.js"></script>
  <script src="catalog/view/theme/manline/js/slick.min.js"></script>
  <script src="catalog/view/theme/manline/js/jquery.sticky.js"></script>
  <script src="catalog/view/theme/manline/js/jquery.slicknav.min.js"></script>
  {# OC2 leftover; file does not exist on OC4, causes console errors #}
  {# <script src="/send/send.js"></script> #}
  <script src="catalog/view/theme/manline/js/main.js?v=4.9"></script>

  {# Analytics (kept; OC4 modules may also inject analytics below) #}
  <script type="text/javascript">
    (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
    })(window,document,'script','//www.google-analytics.com/analytics.js','ga');
    (function(ga){
      var r = new RegExp("[\\?&]client_uuid=([^&#]*)"),p = r.exec(location.search);
      if(p === null){ci=undefined;}else{ci=decodeURIComponent(p[1].replace(/\+/g, " "));}
      ga('create', 'UA-51724077-1', {'clientId':ci});
      ga('require', 'displayfeatures');
      ga('send', 'pageview');
    })(ga);
  </script>

  <!-- search -->
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "url": "{{ base }}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ base }}search/?search={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
  <!-- search -->

  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}

  {% for script in scripts %}
    <script src="{{ script.href }}" type="text/javascript"></script>
  {% endfor %}
</head>
<body>
<!-- Google Tag Manager -->
<noscript><iframe src="//www.googletagmanager.com/ns.html?id=GTM-53L8XX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  '//www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-53L8XX');</script>
<!-- End Google Tag Manager -->

<div class="head_top">
  <div class="container">
    <div class="top_descr mob_hid">{{ text_top_desc|default('') }}</div>
    <div class="top_nav">
      <ul>
        {# TODO: restore OC2 /ua/ language switch behavior once OC4 SEO language URLs are aligned #}
        <li class="bn language_switch">
          {# UA #}
          {% if current_language == 'uk-ua' %}
            <a href="#" class="mob_hid" style="font-weight:bold;text-decoration:none!important" onclick="return false;"><img src="/catalog/view/theme/manline/image/tm6.png" class="tm_img" alt=""/>UA</a>
          {% else %}
            <a href="{{ lang_switch_ua }}" class="mob_hid"><img src="/catalog/view/theme/manline/image/tm6.png" class="tm_img" alt=""/>UA</a>
          {% endif %}
          <span class="mob_hid" style="margin-left: 2px;margin-right: 2px;">|</span>
          {# RU #}
          {% if current_language == 'ru-ru' %}
            <a href="#" class="mob_hid" style="font-weight:bold;text-decoration:none!important" onclick="return false;">RU</a>
          {% else %}
            <a href="{{ lang_switch_ru }}" class="mob_hid">RU</a>
          {% endif %}
        </li>
        <li><a href="{{ info_track|default('#') }}"><img src="/catalog/view/theme/manline/image/tm1.png" class="tm_img" alt=""/>{{ text_menu_1|default('Отследить заказ') }}</a></li>
        <li><a href="{{ info_exchange|default('#') }}"><img src="/catalog/view/theme/manline/image/tm2.png" class="tm_img" alt=""/>{{ text_menu_2|default('Обмен/возврат') }}</a></li>
        <li><a href="{{ info_help|default('#') }}"><img src="/catalog/view/theme/manline/image/tm3.png" class="tm_img" alt=""/>{{ text_menu_3|default('Помощь') }}</a></li>
        <li><a href="{{ info_contacts|default('#') }}"><img src="/catalog/view/theme/manline/image/tm4.png" class="tm_img" alt=""/>{{ text_menu_4|default('Контакты') }}</a></li>
      </ul>
    </div>
  </div>
</div>

<div class="container header" id="header">
  <div id="logo">
    <a href="{{ home }}"><img src="catalog/view/theme/manline/image/logo.png" title="{{ name }}" alt="{{ name }}"/></a>
  </div>

  <div class="search_w mob_hid">
    <div id="search" data-search-url="{{ search_url }}">
      <input type="text" value="{{ search_query|e }}" placeholder="{{ text_search|default('Поиск') }}" name="search" class="ui-autocomplete-input ui-corner-all" autocomplete="off" role="textbox" aria-autocomplete="list" aria-haspopup="true">
      <div class="button-search" role="button" aria-label="Search"><div class="button_search_inner"></div></div>
    </div>
  </div>

  <script>
    // Legacy Manline search: redirect to product/search with ?search=
    (function(){
      function root(){ return document.getElementById('search'); }
      function inp(){ return root() ? root().querySelector('input[name=search]') : null; }
      function go(){
        var r = root();
        var i = inp();
        if(!r || !i) return;
        var base = r.getAttribute('data-search-url') || '';
        var q = String(i.value || '').trim();
        if(!base) return;
        // keep existing query string (language=...) and append search
        var url = base + (base.indexOf('?') === -1 ? '?' : '&') + 'search=' + encodeURIComponent(q);
        window.location.href = url;
      }

      document.addEventListener('click', function(e){
        var btn = e.target && (e.target.closest ? e.target.closest('#search .button-search') : null);
        if(btn) { e.preventDefault(); go(); }
      });

      document.addEventListener('keydown', function(e){
        var i = inp();
        if(!i) return;
        if(e.key === 'Enter' && document.activeElement === i) {
          e.preventDefault();
          go();
        }
      });
    })();
  </script>

  {{ cart }}

  <div class="phone_h">
    <div class="select_phone_w">
      <div class="phone_pop show-list" style="display: none;">
        <ul class="drop_list">
          <li><span class="phone_pop_a first_phone_pop_a" data-phone-num="(068) 503 05 05">(068) 503 05 05</span></li>
          <li><span class="phone_pop_a" data-phone-num="(063) 641 56 99">(063) 641 56 99 <img src="/catalog/view/theme/manline/image/viber.svg" alt="" width="15" height="15"></span></li>
        </ul>
      </div>
      <div class="phone_self">
        <div class="phone_self_arr"></div>
        <div class="phone_self_dash">(068) 503 05 05</div>
      </div>
      <div class="clearfix"></div>
    </div>
    <span data-tooltip-content="#tooltip_content" class="call_c">{{ text_graph_1|default('') }}</span>
    <div class="none">
      <span id="tooltip_content">
        <div class="bold mb-5">{{ text_graph_2|default('') }}</div>
        {{ text_graph_3|default('') }}
        <br>
        {{ text_graph_4|default('') }}
      </span>
    </div>
  </div>
</div>

<div class="main_nav_w">
  <div class="container">
    <!--dg_nav_menu_start-->
    {{ menu }}
  </div>
</div>

