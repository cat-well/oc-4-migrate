{{ header }}

<div class="container">
  {# Breadcrumbs (OC2-like) #}
  <div class="breadcrumb_w">
    {% for breadcrumb in breadcrumbs %}
      {% if not loop.first %}
        <span class="sep">&gt;</span>
      {% endif %}
      {% if not loop.last %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% else %}
        <span class="current">{{ breadcrumb.text }}</span>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="container" id="content">
  {{ content_top }}

  <div class="title mb-40">
    <h1>{{ heading_title_oc2|default(heading_title) }}</h1>
  </div>

  <div class="citata">
    <div class="title_clean">{{ success_subtitle_oc2|default('') }}</div>
    {{ success_text_oc2|default('') }}
  </div>
</div>

{{ footer }}
