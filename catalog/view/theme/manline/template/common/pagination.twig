<div class="pagination">
  {% if first %}
    <a href="{{ first }}">|&lt;</a>
  {% endif %}
  {% if prev %}
    <a href="{{ prev }}">&lt;</a>
  {% endif %}

  {% for link in links %}
    {% if link.page == page %}
      <b>{{ link.page }}</b>
    {% else %}
      <a href="{{ link.href }}">{{ link.page }}</a>
    {% endif %}
  {% endfor %}

  {% if next %}
    <a href="{{ next }}">&gt;</a>
  {% endif %}
  {% if last %}
    <a href="{{ last }}">&gt;|</a>
  {% endif %}
</div>