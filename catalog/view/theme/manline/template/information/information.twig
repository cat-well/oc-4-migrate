{{ header }}

<div class="container">
  {# Breadcrumbs (OC2-like) #}
  <div class="breadcrumb_w">
    {% for breadcrumb in breadcrumbs %}
      {% if not loop.first %}
        <span class="sep">&gt;</span>
      {% endif %}
      {% if not loop.last %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% else %}
        <span class="current">{{ breadcrumb.text }}</span>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div id="information-information" class="container">
  <div class="row">
    {% if help_nav is defined and help_nav %}
      <div class="col-sm-3">
        <ul class="help_nav">
          {% for item in help_nav %}
            {% if item.active %}
              <li class="active"><span>{{ item.title }}</span></li>
            {% else %}
              <li><a href="{{ item.href }}">{{ item.title }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      <div id="content" class="col-sm-9">{{ content_top }}
        {% if information_id is defined and information_id == 4 %}
          {% include 'catalog/view/theme/manline/template/information/o_nas.twig' %}
        {% elseif information_id is defined and information_id == 7 %}
          {% include 'catalog/view/theme/manline/template/information/otsledit.twig' %}
        {% elseif information_id is defined and information_id == 17 %}
          {% include 'catalog/view/theme/manline/template/information/sotrudnichestvo.twig' %}
        {% elseif information_id is defined and information_id == 19 %}
          {% include 'catalog/view/theme/manline/template/information/ishem_modelej.twig' %}
        {% else %}
          <h1>{{ heading_title }}</h1>
          {{ description|raw }}
        {% endif %}
        {{ content_bottom }}
      </div>
    {% else %}
      {{ column_left }}
      <div id="content" class="col">{{ content_top }}
        {% if information_id is defined and information_id == 4 %}
          {% include 'catalog/view/theme/manline/template/information/o_nas.twig' %}
        {% elseif information_id is defined and information_id == 7 %}
          {% include 'catalog/view/theme/manline/template/information/otsledit.twig' %}
        {% elseif information_id is defined and information_id == 17 %}
          {% include 'catalog/view/theme/manline/template/information/sotrudnichestvo.twig' %}
        {% elseif information_id is defined and information_id == 19 %}
          {% include 'catalog/view/theme/manline/template/information/ishem_modelej.twig' %}
        {% else %}
          <h1>{{ heading_title }}</h1>
          {{ description|raw }}
        {% endif %}
        {{ content_bottom }}
      </div>
      {{ column_right }}
    {% endif %}
  </div>
</div>

{{ footer }}