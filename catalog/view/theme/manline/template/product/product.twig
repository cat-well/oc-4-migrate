{{ header }}

<!--this_is_product-->
<div class="breadcrumb container">
  {# OC2-like breadcrumbs with optional injected "Стиль" crumb #}
  {% set crumbs = breadcrumbs %}
  {% if style_breadcrumb %}
    {# Insert before last crumb (product) #}
    {% set last = crumbs|last %}
    {% set head = crumbs|slice(0, crumbs|length - 1) %}
    {% set crumbs = head|merge([style_breadcrumb, last]) %}
  {% endif %}

  {% for breadcrumb in crumbs %}
    {% if not loop.last %}
      <div style="display:inline"><a href="{{ breadcrumb.href }}"><span>{% if loop.first %}{% if lang == 'uk-ua' %}Головна{% else %}Главная{% endif %}{% else %}{{ breadcrumb.text }}{% endif %}</span></a></div>
      <div class="text_separator"></div>
    {% else %}
      <div><span>{{ breadcrumb.text }}</span></div>
    {% endif %}
  {% endfor %}
</div>

<div class="container">
  <div class="row">

    {# Left: gallery #}
    <div class="col-xs-12 col-md-5 relative">

      {% if is_new %}
        <div class="new">{% if lang == 'uk-ua' %}Новинка{% else %}Новинка{% endif %}</div>
      {% endif %}

      {% if thumb %}
        <div class="thumbnails">
          <div class="big_image_wrap">
            <a href="{{ popup }}" title="{{ heading_title }}" class="big_image gal" rel="gal">
              <img data-zoom-image="{{ popup }}" src="{{ thumb }}" alt="{{ heading_title }}" />
            </a>
          </div>

          {% for image in images %}
            <div class="big_image_wrap">
              <a class="big_image gal" rel="gal" href="{{ image.popup }}" title="{{ heading_title }}">
                <img data-zoom-image="{{ image.popup }}" {% if image.hover %}data-lazy="{{ image.hover }}"{% endif %} title="{{ heading_title }}" alt="{{ heading_title }}" />
              </a>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="additional_w">
        {% if thumb_thumb %}
          <div class="thumbnail_sm thumbnail_small"><img src="{{ thumb_thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></div>
        {% elseif thumb %}
          <div class="thumbnail_sm thumbnail_small"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></div>
        {% endif %}

        {% set count = 0 %}
        {% for image in images %}
          {% if image.thumb %}
            <div class="thumbnail_sm thumbnail_small">
              <img src="{{ image.thumb }}" title="{{ heading_title }} - Фото {{ count + 1 }}" alt="{{ heading_title }} - Фото {{ count + 1 }}" />
            </div>
          {% endif %}
          {% set count = count + 1 %}
        {% endfor %}
      </div>

    </div>

    {# Middle: short info / attributes #}
    <div class="col-xs-12 col-md-4 tovar_middle">
      <h1>{{ heading_title }}</h1>

      <div class="prod_short">
        <div class="psw">
          <div class="pst">{% if lang == 'uk-ua' %}Код товару:{% else %}Код товара:{% endif %}</div>
          <div class="pstext">{{ model }}</div>
        </div>

        <div class="hara">
          <ul class="hara_list">
            {% for attribute_group in attribute_groups %}
              {% for attribute in attribute_group.attribute %}
                <li>
                  <div class="hara_n">{{ attribute.name }}</div>
                  <div class="hara_t">{{ attribute.text }}</div>
                </li>
              {% endfor %}
            {% endfor %}
          </ul>

          <a href="{{ current_url }}#description" class="all_opis">{% if lang == 'uk-ua' %}Переглянути повний опис{% else %}Смотреть полное описание{% endif %}</a>
        </div>

        <div class="dozakaz" data-free-deliv="1500">
          <div class="free">{% if lang == 'uk-ua' %}<span class="red">Вітаємо!</span> Ви отримали безкоштовну доставку{% else %}<span class="red">Поздравляем!</span> Вы получили бесплатную доставку{% endif %}</div>
          <div class="dozakaz_in">{% if lang == 'uk-ua' %}<span class="dozak_word">Замовте</span> на <span class="rd">1500 грн</span> та отримайте <span class="rb">безкоштовну доставку</span>{% else %}<span class="dozak_word">Закажите</span> на <span class="rd">1500 грн</span> и получите <span class="rb">бесплатную доставку</span>{% endif %}</div>
        </div>

      </div>
    </div>

    {# Right: buy box #}
    <div class="col-xs-12 col-md-3 product-info">
      <div class="cart_r">

        {% if quantity > 0 %}
          <div class="nal">{% if lang == 'uk-ua' %}Є в наявності{% else %}Есть в наличии{% endif %}</div>
        {% else %}
          <div style="color:#ff0000;font-weight:bold">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>
        {% endif %}

        {% if price %}
          <div class="price">
            {% if not special %}
              {% if lang == 'uk-ua' %}Ціна: {{ price }}{% else %}Цена: {{ price }}{% endif %}
            {% else %}
              <span>{% if lang == 'uk-ua' %}Ціна{% else %}Цена{% endif %}: </span>
              <span class="price-old">{{ price }}</span>
              <span class="price-new">{{ special }}</span>
            {% endif %}
          </div>
        {% endif %}

        <div class="qnt_w">
          <div class="option_title">{% if lang == 'uk-ua' %}Кількість{% else %}Количество{% endif %}</div>
          <div class="qnt">
            <input id="quantity" type="text" name="quantity" size="2" value="{{ minimum }}" />
            <input type="hidden" name="product_id" value="{{ product_id }}" />
            <div class="minus"></div>
            <div class="plus"></div>
          </div>
        </div>
        <div class="clearfix"></div>

        {# Color kit block (optional; controller can fill later) #}
        {% if colors is defined and colors %}
          <div class="color styled">
            <div class="option_title">{% if lang == 'uk-ua' %}Колір{% else %}Цвет{% endif %}:</div>
            <div class="color_in">
              <div id="color_options">
                {% for color in colors %}
                  {% if color.product_id == product_id %}
                    <div class="color_option active {{ color.tpl }} {{ color.quantity }}" {% if color.color %}style="border-color: {{ color.color }};"{% endif %}>
                      {% if color.quantity %}<div class="hideQuantity">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>{% endif %}
                      {% if color.tpl == 'color' %}
                        <span class="color_block" style="background:{{ color.color }}"></span>
                      {% elseif color.tpl == 'photos' %}
                        <span class="color_block"><img src="{{ color.ico_photo }}" /></span>
                      {% else %}
                        <span class="color_block"><img src="{{ color.ico_color }}" /></span>
                      {% endif %}
                      {% if colors_cfg is defined and colors_cfg.name == 1 %}
                        <span class="color_name">{{ color.color_name }}</span>
                      {% endif %}
                    </div>
                  {% else %}
                    <div class="color_option {{ color.tpl }} {{ color.quantity }}">
                      {% if color.quantity %}<div class="hideQuantity">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>{% endif %}
                      <a href="{{ color.href }}">
                        {% if color.tpl == 'color' %}
                          <span class="color_block" style="background:{{ color.color }}"></span>
                        {% elseif color.tpl == 'photos' %}
                          <span class="color_block"><img src="{{ color.ico_photo }}" /></span>
                        {% else %}
                          <span class="color_block"><img src="{{ color.ico_color }}" /></span>
                        {% endif %}
                        {% if colors_cfg is defined and colors_cfg.name == 1 %}
                          <span class="color_name">{{ color.color_name }}</span>
                        {% endif %}
                      </a>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
        {% endif %}

        <div class="razmer styled">
          {% if options %}
            {% for option in options %}
              {% if option.option_id == 14 and option.type == 'radio' %}
                <div id="option-{{ option.product_option_id }}" class="option">
                  <div class="option_title">{% if option.required %}<span class="required">*</span>{% endif %}{{ option.name }}:</div>
                  <a href="{{ current_url }}#description" class="tabl_r">{% if lang == 'uk-ua' %}Дивитись таблицю розмірів{% else %}Смотреть таблицу размеров{% endif %}</a>
                  <div class="clearfix"></div>
                  <div class="row_wr">
                    {% for option_value in option.product_option_value %}
                      <div class="wr">
                        <label class="option_box_cont" for="option-value-{{ option_value.product_option_value_id }}">
                          <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" id="option-value-{{ option_value.product_option_value_id }}" />
                          {{ option_value.name }}
                        </label>
                      </div>
                    {% endfor %}
                    <div class="clearfix"></div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        <button class="button" id="button-cart" type="button"><span>{% if lang == 'uk-ua' %}Купити{% else %}Купить{% endif %}</span></button>

        <div class="doopl">
          <span data-tooltip-content="#dost_opl_tip" class="doopl_href">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %}</span>
          <div class="none">
            <span id="dost_opl_tip">
              <div class="bold mb-5">{% if lang == 'uk-ua' %}Доставка{% else %}Доставка{% endif %}</div>
              <ul class="wd">
                <li><a class="anim_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка кур'єром{% else %}Доставка курьером{% endif %}</a></li>
                <li><a class="anim_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Нова Пошта по Україні{% else %}Новая Почта по Украине{% endif %}</a></li>
                <li><a class="anim_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Вартість доставки{% else %}Стоимость доставки{% endif %}</a></li>
                <li class="bold yel">{% if lang == 'uk-ua' %}При замовленні від 1500 грн безкоштовно{% else %}При заказе от 1500 грн бесплатно{% endif %}</li>
              </ul>
              <div class="bold mt-10 mb-5">{% if lang == 'uk-ua' %}Оплата{% else %}Оплата{% endif %}</div>
              {% if lang == 'uk-ua' %}Оплата при отриманні{% else %}Наложенным платежом{% endif %}<br />
              Visa/MasterCard,
            </span>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<div class="prod_de_w sets_w">
  {{ set_block|default('')|raw }}

  <div class="container descr prod_cont" id="description">
    <div class="product_menu_w">
      <ul class="product_menu">
        <li class="active_menu"><a href="#description">{% if lang == 'uk-ua' %}Опис{% else %}Описание{% endif %}</a></li>
        <li><a href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %}</a></li>
        <li><a href="#otzivi">{% if lang == 'uk-ua' %}Відгуки{% else %}Отзывы{% endif %}</a></li>
      </ul>

      <div class="description_w">
        {{ description|raw }}
      </div>
    </div>
  </div>

  <div class="container descr prod_cont" id="dost_oplata">
    <div class="product_menu_w">
      <ul class="product_menu">
        <li><a href="#description">{% if lang == 'uk-ua' %}Опис{% else %}Описание{% endif %}</a></li>
        <li class="active_menu"><a class="dost_oplata_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %} <span class="more_dost_op">{% if lang == 'uk-ua' %}читати докладніше{% else %}читать подробнее{% endif %}</span></a></li>
        <li><a href="#otzivi">{% if lang == 'uk-ua' %}Відгуки{% else %}Отзывы{% endif %}</a></li>
      </ul>
      <div class="description_w" id="dost_oplata_d"></div>
    </div>
  </div>

  <div class="container descr prod_cont" id="otzivi">
    <div class="product_menu_w">
      <ul class="product_menu">
        <li><a href="#description">{% if lang == 'uk-ua' %}Опис{% else %}Описание{% endif %}</a></li>
        <li><a href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %}</a></li>
        <li class="active_menu"><a href="#otzivi">{% if lang == 'uk-ua' %}Відгуки{% else %}Отзывы{% endif %}</a></li>
      </ul>
      <div class="description_w">
        <div id="hypercomments_widget"></div>
        <script type="text/javascript">
          window._hcwp = window._hcwp || [];
          window._hcwp.push({widget:"Stream", widget_id: 79564});
          (function() {
            if("HC_LOAD_INIT" in window) return;
            window.HC_LOAD_INIT = true;
            var lang = (navigator.language || navigator.systemLanguage || navigator.userLanguage || "en").substr(0, 2).toLowerCase();
            var hcc = document.createElement("script"); hcc.type = "text/javascript"; hcc.async = true;
            hcc.src = (("https:" == document.location.protocol ? "https" : "http") + "://w.hypercomments.com/widget/hc/79564/" + lang + "/widget.js");
            var s = document.getElementsByTagName("script")[0];
            s.parentNode.insertBefore(hcc, s.nextSibling);
          })();
        </script>
      </div>
    </div>
  </div>
</div>

