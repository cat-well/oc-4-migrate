{{ header }}
{% if product_jsonld is defined %}{{ product_jsonld|raw }}{% endif %}

<!--this_is_product-->
<div class="breadcrumb container">
  {# OC2-like breadcrumbs with optional injected "Стиль" crumb #}
  {% set crumbs = breadcrumbs %}
  {% if style_breadcrumb %}
    {# Insert before last crumb (product) #}
    {% set last = crumbs|last %}
    {% set head = crumbs|slice(0, crumbs|length - 1) %}
    {% set crumbs = head|merge([style_breadcrumb, last]) %}
  {% endif %}

  {% for breadcrumb in crumbs %}
    {% if not loop.last %}
      <div style="display:inline"><a href="{{ breadcrumb.href }}"><span>{% if loop.first %}{% if lang == 'uk-ua' %}Головна{% else %}Главная{% endif %}{% else %}{{ breadcrumb.text }}{% endif %}</span></a></div>
      <div class="text_separator"></div>
    {% else %}
      <div><span>{{ breadcrumb.text }}</span></div>
    {% endif %}
  {% endfor %}
</div>

<div class="container">
  <div class="row">

    {# Left: gallery #}
    <div class="col-xs-12 col-md-5 relative">

      {% if is_new %}
        <div class="new">{% if lang == 'uk-ua' %}Новинка{% else %}Новинка{% endif %}</div>
      {% endif %}

      {% if thumb %}
        <div class="thumbnails">
          <div class="big_image_wrap">
            <a href="{{ popup }}" title="{{ heading_title }}" class="big_image gal" rel="gal">
              <img data-zoom-image="{{ popup }}" src="{{ thumb }}" alt="{{ heading_title }}" />
            </a>
          </div>

          {% for image in images %}
            <div class="big_image_wrap">
              <a class="big_image gal" rel="gal" href="{{ image.popup }}" title="{{ heading_title }}">
                <img data-zoom-image="{{ image.popup }}" {% if image.hover %}data-lazy="{{ image.hover }}"{% endif %} title="{{ heading_title }}" alt="{{ heading_title }}" />
              </a>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="additional_w">
        {% if thumb_thumb %}
          <div class="thumbnail_sm thumbnail_small"><img src="{{ thumb_thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></div>
        {% elseif thumb %}
          <div class="thumbnail_sm thumbnail_small"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></div>
        {% endif %}

        {% set count = 0 %}
        {% for image in images %}
          {% if image.thumb %}
            <div class="thumbnail_sm thumbnail_small">
              <img src="{{ image.thumb }}" title="{{ heading_title }} - Фото {{ count + 1 }}" alt="{{ heading_title }} - Фото {{ count + 1 }}" />
            </div>
          {% endif %}
          {% set count = count + 1 %}
        {% endfor %}
      </div>

    </div>

    {# Middle: short info / attributes #}
    <div class="col-xs-12 col-md-4 tovar_middle">
      <h1>{{ heading_title }}</h1>

      <div class="prod_short">
        <div class="psw">
          <div class="pst">{% if lang == 'uk-ua' %}Код товару:{% else %}Код товара:{% endif %}</div>
          <div class="pstext">{{ model }}</div>
        </div>

        <div class="hara">
          <ul class="hara_list">
            {% set first_cat = (breadcrumbs|length > 1) ? (breadcrumbs[1].text|default('')) : '' %}
            {% for attribute_group in attribute_groups %}
              {% for attribute in attribute_group.attribute %}

                {# OC2 special cases #}
                {% if attribute.attribute_id == 26 and manufacturer %}
                  <li>
                    <div class="hara_n">{{ attribute.name }}</div>
                    <div class="hara_t">
                      <a href="{{ attribute.text }}">{{ manufacturer }}</a>
                    </div>
                  </li>

                {% elseif attribute.attribute_id == 17 and first_cat == 'Мужские трусы' %}
                  {% set c = attribute.text|lower %}
                  {% set cmap = {
                    'красный': '/muzhskie-trusy/krasnye/',
                    'оранжевый': '/muzhskie-trusy/oranzhevye/',
                    'белый': '/muzhskie-trusy/belye/',
                    'синий': '/muzhskie-trusy/sinie/',
                    'серый': '/muzhskie-trusy/serye/',
                    'черный': '/muzhskie-trusy/chernye/',
                    'коричневый': '/muzhskie-trusy/korichnevye/',
                    'бежевый': '/muzhskie-trusy/bezhevye/',
                    'голубой': '/muzhskie-trusy/golybye/',
                    'желтый': '/muzhskie-trusy/zheltye/',
                    'розовый': '/muzhskie-trusy/rozovye/'
                  } %}
                  <li>
                    <div class="hara_n">{{ attribute.name }}</div>
                    <div class="hara_t">
                      {% if cmap[c] is defined %}
                        <a href="{{ cmap[c] }}">{{ attribute.text }}</a>
                      {% else %}
                        {{ attribute.text }}
                      {% endif %}
                    </div>
                  </li>

                {% elseif attribute.attribute_id == 23 %}
                  <li>
                    <div class="hara_n">{{ attribute.name }}</div>
                    <div class="hara_t">
                      {% if style_tags is defined and style_tags %}
                        {% for t in style_tags %}
                          <a href="{{ t.href }}">{{ t.text }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                      {% elseif first_cat == 'Мужские плавки' and attribute.text|lower == 'шорты' %}
                        <a href="/plyazhnaya-odezhda/shorty/">{{ attribute.text }}</a>
                      {% else %}
                        {{ attribute.text }}
                      {% endif %}
                    </div>
                  </li>

                {% else %}
                  <li>
                    <div class="hara_n">{{ attribute.name }}</div>
                    <div class="hara_t">{{ attribute.text }}</div>
                  </li>
                {% endif %}

              {% endfor %}
            {% endfor %}
          </ul>

          <a href="{{ current_url }}#description" class="all_opis">{% if lang == 'uk-ua' %}Переглянути повний опис{% else %}Смотреть полное описание{% endif %}</a>
        </div>

        <div class="dozakaz" data-free-deliv="1500">
          <div class="free">{% if lang == 'uk-ua' %}<span class="red">Вітаємо!</span> Ви отримали безкоштовну доставку{% else %}<span class="red">Поздравляем!</span> Вы получили бесплатную доставку{% endif %}</div>
          <div class="dozakaz_in">{% if lang == 'uk-ua' %}<span class="dozak_word">Замовте</span> на <span class="rd">1500 грн</span> та отримайте <span class="rb">безкоштовну доставку</span>{% else %}<span class="dozak_word">Закажите</span> на <span class="rd">1500 грн</span> и получите <span class="rb">бесплатную доставку</span>{% endif %}</div>
        </div>

      </div>
    </div>

    {# Right: buy box #}
    <div class="col-xs-12 col-md-3 product-info">
      <div class="cart_r">

        {% if quantity > 0 %}
          <div class="nal">{% if lang == 'uk-ua' %}Є в наявності{% else %}Есть в наличии{% endif %}</div>
        {% else %}
          <div style="color:#ff0000;font-weight:bold">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>
        {% endif %}

        {% if price %}
          <div class="price">
            {% if not special %}
              {% if lang == 'uk-ua' %}Ціна: {{ price }}{% else %}Цена: {{ price }}{% endif %}
            {% else %}
              <span>{% if lang == 'uk-ua' %}Ціна{% else %}Цена{% endif %}: </span>
              <span class="price-old">{{ price }}</span>
              <span class="price-new">{{ special }}</span>
            {% endif %}
          </div>
        {% endif %}

        <div class="qnt_w">
          <div class="option_title">{% if lang == 'uk-ua' %}Кількість{% else %}Количество{% endif %}</div>
          <div class="qnt">
            <input id="quantity" type="text" name="quantity" size="2" value="{{ minimum }}" />
            <input type="hidden" name="product_id" value="{{ product_id }}" />
            <div class="minus"></div>
            <div class="plus"></div>
          </div>
        </div>
        <div class="clearfix"></div>

        {# Color kit block (optional; controller can fill later) #}
        {% if colors is defined and colors %}
          <div class="color styled">
            <div class="option_title">{% if lang == 'uk-ua' %}Колір{% else %}Цвет{% endif %}:</div>
            <div class="color_in">
              <div id="color_options">
                {% for color in colors %}
                  {% if color.product_id == product_id %}
                    <div class="color_option active {{ color.tpl }} {{ color.quantity }}" {% if color.color %}style="border-color: {{ color.color }};"{% endif %}>
                      {% if color.quantity %}<div class="hideQuantity">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>{% endif %}
                      {% if color.tpl == 'color' %}
                        <span class="color_block" style="background:{{ color.color }}"></span>
                      {% elseif color.tpl == 'photos' %}
                        <span class="color_block"><img src="{{ color.ico_photo }}" /></span>
                      {% else %}
                        <span class="color_block"><img src="{{ color.ico_color }}" /></span>
                      {% endif %}
                      {% if colors_cfg is defined and colors_cfg.name == 1 %}
                        <span class="color_name">{{ color.color_name }}</span>
                      {% endif %}
                    </div>
                  {% else %}
                    <div class="color_option {{ color.tpl }} {{ color.quantity }}">
                      {% if color.quantity %}<div class="hideQuantity">{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</div>{% endif %}

                      {# Don't allow clicking disabled variants (OC2-like) #}
                      {% if color.quantity %}
                        {% if color.tpl == 'color' %}
                          <span class="color_block" style="background:{{ color.color }}"></span>
                        {% elseif color.tpl == 'photos' %}
                          <span class="color_block"><img src="{{ color.ico_photo }}" /></span>
                        {% else %}
                          <span class="color_block"><img src="{{ color.ico_color }}" /></span>
                        {% endif %}
                        {% if colors_cfg is defined and colors_cfg.name == 1 %}
                          <span class="color_name">{{ color.color_name }}</span>
                        {% endif %}
                      {% else %}
                        <a href="{{ color.href }}">
                          {% if color.tpl == 'color' %}
                            <span class="color_block" style="background:{{ color.color }}"></span>
                          {% elseif color.tpl == 'photos' %}
                            <span class="color_block"><img src="{{ color.ico_photo }}" /></span>
                          {% else %}
                            <span class="color_block"><img src="{{ color.ico_color }}" /></span>
                          {% endif %}
                          {% if colors_cfg is defined and colors_cfg.name == 1 %}
                            <span class="color_name">{{ color.color_name }}</span>
                          {% endif %}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
        {% endif %}

        <div class="razmer styled">
          {% if options %}
            {% for option in options %}
              {% if option.option_id == 14 and option.type == 'radio' %}
                <div id="option-{{ option.product_option_id }}" class="option">
                  <div class="option_title">{% if option.required %}<span class="required">*</span>{% endif %}{{ option.name }}:</div>
                  <a href="{{ current_url }}#description" class="tabl_r">{% if lang == 'uk-ua' %}Дивитись таблицю розмірів{% else %}Смотреть таблицу размеров{% endif %}</a>
                  <div class="clearfix"></div>
                  <div class="row_wr">
                    {% for option_value in option.product_option_value %}
                      <div class="wr">
                        <label class="option_box_cont" for="option-value-{{ option_value.product_option_value_id }}">
                          <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" id="option-value-{{ option_value.product_option_value_id }}" />
                          {{ option_value.name }}
                        </label>
                      </div>
                    {% endfor %}
                    <div class="clearfix"></div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        {% if quantity > 0 %}
          <button class="button" id="button-cart" type="button"><span>{% if lang == 'uk-ua' %}Купити{% else %}Купить{% endif %}</span></button>
        {% else %}
          <button class="button" id="button-cart" type="button" disabled="disabled" style="opacity:.6;cursor:not-allowed"><span>{% if lang == 'uk-ua' %}Немає в наявності{% else %}Нет в наличии{% endif %}</span></button>
        {% endif %}

        <div class="doopl">
          <span data-tooltip-content="#dost_opl_tip" class="doopl_href">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %}</span>
          <div class="none">
            <span id="dost_opl_tip">
              <div class="bold mb-5">{% if lang == 'uk-ua' %}Доставка{% else %}Доставка{% endif %}</div>
              <ul class="wd">
                <li><a class="anim_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка кур'єром{% else %}Доставка курьером{% endif %}</a></li>
                <li><a class="anim_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Нова Пошта по Україні{% else %}Новая Почта по Украине{% endif %}</a></li>
                <li><a class="anim_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Вартість доставки{% else %}Стоимость доставки{% endif %}</a></li>
                <li class="bold yel">{% if lang == 'uk-ua' %}При замовленні від 1500 грн безкоштовно{% else %}При заказе от 1500 грн бесплатно{% endif %}</li>
              </ul>
              <div class="bold mt-10 mb-5">{% if lang == 'uk-ua' %}Оплата{% else %}Оплата{% endif %}</div>
              {% if lang == 'uk-ua' %}Оплата при отриманні{% else %}Наложенным платежом{% endif %}<br />
              Visa/MasterCard,
            </span>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<div class="prod_de_w sets_w">
  {# TECH-DEBT (Manline): OC2 "sets" / комплект блок. Сейчас не портировано в OC4.
     В теме есть legacy JS (js/set.js) и placeholder set_block, но нет backend route/data.
     Вернемся позже. #}
  {# {{ set_block|default('')|raw }} #}

  <div class="container descr prod_cont" id="description">
    <div class="product_menu_w">
      <ul class="product_menu">
        <li class="active_menu"><a href="#description">{% if lang == 'uk-ua' %}Опис{% else %}Описание{% endif %}</a></li>
        <li><a href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %}</a></li>
        <li><a href="#otzivi">{% if lang == 'uk-ua' %}Відгуки{% else %}Отзывы{% endif %}</a></li>
      </ul>

      <div class="description_w">
        {{ description|raw }}
      </div>
    </div>
  </div>

  <div class="container descr prod_cont" id="dost_oplata">
    <div class="product_menu_w">
      <ul class="product_menu">
        <li><a href="#description">{% if lang == 'uk-ua' %}Опис{% else %}Описание{% endif %}</a></li>
        <li class="active_menu"><a class="dost_oplata_href" href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %} <span class="more_dost_op">{% if lang == 'uk-ua' %}читати докладніше{% else %}читать подробнее{% endif %}</span></a></li>
        <li><a href="#otzivi">{% if lang == 'uk-ua' %}Відгуки{% else %}Отзывы{% endif %}</a></li>
      </ul>
      <div class="description_w" id="dost_oplata_d"></div>
    </div>
  </div>

  <div class="container descr prod_cont" id="otzivi">
    <div class="product_menu_w">
      <ul class="product_menu">
        <li><a href="#description">{% if lang == 'uk-ua' %}Опис{% else %}Описание{% endif %}</a></li>
        <li><a href="#dost_oplata">{% if lang == 'uk-ua' %}Доставка і оплата{% else %}Доставка и оплата{% endif %}</a></li>
        <li class="active_menu"><a href="#otzivi">{% if lang == 'uk-ua' %}Відгуки{% else %}Отзывы{% endif %}</a></li>
      </ul>
      <div class="description_w">
        <style>
          #otzivi #form-review { max-width: 640px; text-align: left; }
          #otzivi #form-review h2 { font-size: 20px; margin: 18px 0 14px; }
          #otzivi #form-review .mb-3 { margin-bottom: 16px; }
          #otzivi #form-review .form-label { display: block; font-weight: 600; margin-bottom: 6px; }
          #otzivi #form-review .form-control { display: block; width: 100%; max-width: 480px; padding: 9px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; line-height: 1.4; background: #fff; box-sizing: border-box; }
          #otzivi #form-review textarea.form-control { min-height: 120px; resize: vertical; }
          #otzivi #form-review .row { display: block; margin: 0; }
          #otzivi #form-review #input-rating { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; }
          #otzivi #form-review #input-rating input[type=radio] { width: 16px; height: 16px; margin: 0 2px; vertical-align: middle; }
          #otzivi #form-review .text-end { text-align: left; margin-top: 16px; }
          #otzivi #form-review .invalid-feedback { color: #c0392b; font-size: 13px; }
          #otzivi #review { margin-bottom: 22px; }
          #otzivi #alert .alert { padding: 10px 14px; border-radius: 4px; margin-bottom: 14px; font-size: 14px; }
          #otzivi #alert .alert-success { background: #e7f6e7; border: 1px solid #58a758; color: #256b25; }
          #otzivi #alert .alert-danger { background: #fdecea; border: 1px solid #d9534f; color: #a12622; }
          #otzivi #alert .btn-close, #otzivi #alert .fa-solid { display: none; }
        </style>
        <div id="alert"></div>
        {% if review_status %}{{ review }}{% endif %}
      </div>
    </div>
  </div>
</div>

{{ related|raw }}

{{ content_bottom }}

<script>
  (function($){
    if (!$) return;

    // Load delivery/payment content from information page (OC2: information_id=10 #dost_op_w)
    $(function(){
      var $d = $('#dost_oplata_d');
      if ($d.length) {
        var url = '{{ dost_oplata_info_url|e('js') }}';
        if (url) {
          $d.load(url + ' #dost_op_w', function(){
            try {
              $('.btn_pop').magnificPopup({
                removalDelay: 500,
                tClose: 'Закрыть (Esc)',
                tLoading: 'Загрузка...',
                callbacks: {
                  beforeOpen: function () { this.st.mainClass = this.st.el.attr('data-effect'); }
                },
                midClick: true
              });
            } catch(e) {}
            $('#dost_oplata_d .title').remove();
            $('#dost_oplata_d .col-lg-4').addClass('col-md-3').removeClass('col-lg-4');
          });
        }
      }

      // slick gallery
      if ($('.thumbnails').length && $('.additional_w').length && $.fn.slick) {
        $('.thumbnails').slick({
          slidesToShow: 1,
          lazyLoad: 'progressive',
          slidesToScroll: 1,
          asNavFor: '.additional_w',
          arrows: false,
          touchMove: false,
          touchThreshold: 12,
          responsive: [{ breakpoint: 991, settings: { dots: true } }]
        });
        $('.additional_w').slick({
          slidesToShow: 5,
          slidesToScroll: 1,
          asNavFor: '.thumbnails',
          focusOnSelect: true
        });
      }

      // zoom
      $(document).on('mouseenter', '.big_image img', function(){
        try {
          $('.zoomContainer').remove();
          var data_zoom_image = $(this).attr('data-zoom-image');
          $(this).data('zoom-image', data_zoom_image).elevateZoom({ zoomType : 'lens', lensShape : 'round', lensSize : 200 });
        } catch(e) {}
      });

      // qty +/-
      function btnminus(minQty){
        var $q = $('#quantity');
        var v = parseInt($q.val() || '0', 10);
        if (v > minQty) $q.val(v - 1);
        else $q.val(minQty);
      }
      function btnplus(){
        var $q = $('#quantity');
        var v = parseInt($q.val() || '0', 10);
        $q.val(v + 1);
      }
      $(document).on('click', '.qnt .plus', function(){ btnplus(); });
      $(document).on('click', '.qnt .minus', function(){ btnminus({{ minimum|default(1) }}); });

      // styled radio check class
      $('.styled input').each(function(){
        if ($(this).prop('checked')) {
          $(this).closest('div.styled').find('label').removeClass('checked');
          $(this).closest('label').addClass('checked');
        }
      });
      $(document).on('change', '.styled input', function(){
        $(this).closest('div.styled').find('label').removeClass('checked');
        if ($(this).prop('checked')) $(this).closest('label').addClass('checked');
      });

      // Tabs anchors (Описание / Доставка и оплата / Отзывы)
      function headerOffset(){
        var h = 0;
        var $hdr = $('#header');
        if ($hdr.length) h = $hdr.outerHeight() || 0;
        // extra spacing so the title isn't glued to header
        return h + 10;
      }
      function setActiveTab(hash){
        if (!hash) return;
        var id = String(hash).replace(/^#/, '');
        if (!id) return;
        $('.product_menu li').removeClass('active_menu');
        $('.product_menu a[href="#' + id.replace(/"/g,'\\"') + '"]').each(function(){
          $(this).closest('li').addClass('active_menu');
        });
      }
      function scrollToHash(hash, push){
        if (!hash || hash === '#') return;
        var $t = $(hash);
        if (!$t.length) return;
        setActiveTab(hash);
        var top = Math.max(0, ($t.offset().top || 0) - headerOffset());
        $('html, body').stop(true).animate({ scrollTop: top }, 350);
        if (push) {
          try { window.location.hash = hash; } catch(e) {}
        }
      }

      // Intercept clicks inside product tab menus and other in-page links
      $(document).on('click', 'a[href^="#"]', function(e){
        var href = $(this).attr('href');
        if (!href || href.length < 2) return;
        if ($(href).length) {
          e.preventDefault();
          scrollToHash(href, true);
        }
      });

      // On load: if URL has hash, scroll to it (after images/layout settle)
      setTimeout(function(){
        if (window.location.hash) {
          scrollToHash(window.location.hash, false);
        }
      }, 200);

      // Add to cart (OC2-like UX)
      // IMPORTANT: OC core common.js also binds #button-cart and can cause a duplicate add.
      // Remove any previously-bound handlers first.
      try {
        $('#button-cart').off('click');
        $(document).off('click', '#button-cart');
      } catch(e) {}

      // Guard against double-click/double-tap: can send 2 requests and add 2 items.
      var __manlineCartAdding = false;
      $(document).on('click', '#button-cart', function(e){
        if (e && e.preventDefault) e.preventDefault();
        if (__manlineCartAdding) return;
        __manlineCartAdding = true;
        var $btn = $(this);
        try { $btn.prop('disabled', true).addClass('is-loading'); } catch(e) {}

        $.ajax({
          url: 'index.php?route=checkout/cart.add&language={{ language }}',
          type: 'post',
          data: $('.product-info input[type=\'text\'], .product-info input[type=\'hidden\'], .product-info input[type=\'radio\']:checked, .product-info input[type=\'checkbox\']:checked, .product-info select, .product-info textarea'),
          dataType: 'json',
          success: function(json){
            $('.success, .warning, .attention, .information, .error').remove();
            $('span.error').remove();

            if (json && json.error) {
              // OC4 returns option errors like: { error: { option_<product_option_id>: "..." } }
              for (var k in json.error) {
                if (!Object.prototype.hasOwnProperty.call(json.error, k)) continue;
                if (String(k).indexOf('option_') === 0) {
                  var optId = String(k).replace('option_', '');
                  $('#option-' + optId).after('<span class="error">' + json.error[k] + '</span>');
                }
              }

              if (json.error.quantity) {
                $('.qnt_w').after('<span class="error">' + json.error.quantity + '</span>');
              }
              return;
            }

            if (json && json.success) {
              // cart popup (close reloads header cart)
              if ($.magnificPopup) {
                $.magnificPopup.open({
                  items: { src: 'index.php?route=common/cart.info&language={{ language }}' },
                  closeBtnInside: true,
                  type: 'ajax',
                  overflowY: 'scroll',
                  tLoading: '',
                  removalDelay: 200,
                  mainClass: 'mfp-with-anim mfp-zoom-in',
                  callbacks: {
                    open: function () {
                      // elevateZoom's .zoomContainer (z-index 99999) sits above the magnific popup
                      // and intercepts clicks on the qty +/- buttons inside the cart preview.
                      // Hide it while the cart popup is open (mirrors what set.js does).
                      $('.zoomContainer').addClass('none');
                    },
                    close: function () {
                      $('.zoomContainer').removeClass('none');
                      $('#cart').load('index.php?route=common/cart.info&language={{ language }}');
                    }
                  }
                });
              } else {
                $('#cart').load('index.php?route=common/cart.info&language={{ language }}');
              }
            }
          },
          complete: function(){
            __manlineCartAdding = false;
            try { $btn.prop('disabled', false).removeClass('is-loading'); } catch(e) {}
          },
          error: function(){
            // also release lock on hard error
            __manlineCartAdding = false;
            try { $btn.prop('disabled', false).removeClass('is-loading'); } catch(e) {}
          }
        });
      });

    });
  })(window.jQuery);
</script>

