{# Manline OC2-like product tile (listing) + hover mini-gallery #}
{% set is_ua = (lang_code is defined) and (lang_code in ['uk-ua','ua']) %}

<div class="col-xs-6 col-sm-4 col-md-3 product_w">
  <div class="product_in">

    {# Mini-gallery: OC2 shows it on hover, aligned to the left side of the expanded card #}
    {% if images is defined and images is not empty %}
      <div class="p_dop_photo">
        {% for img in images %}
          <div class="p_dop_photo_h {% if loop.first %}active{% endif %}" data-href="{{ img.popup }}">
            <img src="{{ img.thumb }}" alt="{{ name }}" loading="lazy"/>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="prod_info">
      <a class="prod_image" href="{{ href }}">
        {% if is_new is defined and is_new %}
          <div class="new">Новинка</div>
        {% endif %}

        <img src="{{ thumb }}" data-default="{{ thumb }}" title="{{ name }}" alt="{{ name }}" loading="lazy"/>
      </a>

      {# Button markup: keep OC2 look & hover (CSS targets #button-cart) #}
      <button class="button" id="button-cart" type="submit">
        <a href="{{ href }}" style="display:block;color:inherit">{{ is_ua ? 'Купити' : 'Купить' }}</a>
      </button>

      <div class="prod_name_w">
        <a class="prod_name" href="{{ href }}">{{ name }}</a>
      </div>

      {% if quantity is defined and quantity > 0 %}
        <div class="prod_stock">{{ is_ua ? 'Є в наявності' : 'Есть в наличии' }}</div>
      {% else %}
        <div style="color: #ff0000">{{ is_ua ? 'Немає в наявності' : 'Нет в наличии' }}</div>
      {% endif %}

      {% if price %}
        <div class="prod_price">
          {% if not special %}
            {{ is_ua ? 'Ціна: ' : 'Цена: ' }}{{ price }}
          {% else %}
            <span>{{ is_ua ? 'Ціна' : 'Цена' }}: </span><span class="price-old">{{ price }}</span> <span class="price-new">{{ special }}</span>
          {% endif %}
        </div>
      {% endif %}

      <div class="hover_tovar">
        {% if model %}
          <div class="hover_t_b"><span class="hov_text">{{ is_ua ? 'Код товару:' : 'Код товара:' }}</span> <span class="hot_text">{{ model }}</span></div>
        {% endif %}

        {% if product_polt_options is defined and product_polt_options %}
          <div class="hover_t_b"><span class="hov_text">{{ is_ua ? 'Розміри в наявності:' : 'Размеры в наличии:' }}</span> <span class="hot_text">{{ product_polt_options }}</span></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
