{# Manline OC2-like product tile + hover mini-gallery #}
<div class="product_w{% if images is empty %} noimgs{% endif %}">
  <div class="product_in">

    {% if images is not empty %}
      <div class="p_dop_photo" aria-hidden="true">
        {% for img in images %}
          <div class="p_dop_photo_h{% if loop.first %} active{% endif %}" data-popup="{{ img.popup }}">
            <img src="{{ img.thumb }}" alt="{{ name }}" loading="lazy"/>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="prod_image">
      <a href="{{ href }}" class="prod_image_val">
        <img
          src="{{ thumb }}"
          data-default="{{ thumb }}"
          alt="{{ name }}"
          title="{{ name }}"
          class="res_img prod-main-img"
          loading="lazy"
        />
      </a>
    </div>

    <div class="prod_info">
      <div class="prod_name_w">
        <a class="prod_name" href="{{ href }}">{{ name }}</a>
      </div>

      <div class="hover_tovar">
        {% if model %}
          <div><span class="hov_text">Код товару:</span> {{ model }}</div>
        {% endif %}
      </div>

      <div class="prod_price">
        {% if price %}
          {% if not special %}
            {{ price }}
          {% else %}
            <span class="price-old">{{ price }}</span>
            <span class="price-new">{{ special }}</span>
          {% endif %}
        {% endif %}
      </div>

      {% if quantity is defined and quantity > 0 %}
        <div class="prod_stock">Є в наявності</div>
      {% else %}
        <div class="prod_stock no_stock">Немає в наявності</div>
      {% endif %}

      <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart" class="mt-2">
        <button type="submit" class="button-cart" formaction="{{ cart_add }}" title="{{ button_cart }}">
          <span>{{ button_cart }}</span>
        </button>
        <input type="hidden" name="product_id" value="{{ product_id }}"/>
        <input type="hidden" name="quantity" value="{{ minimum }}"/>
      </form>

    </div>
  </div>
</div>
