{{ header }}

<div id="product-category" class="container">

  {# Breadcrumbs (OC2-like) #}
  <div class="breadcrumb_w">
    {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        <span class="sep">&gt;</span>
      {% else %}
        <span class="current">{{ breadcrumb.text }}</span>
      {% endif %}
    {% endfor %}
  </div>

  <div class="row">

    {# Left column: OC2 had FilterPro here. In OC4 it's not migrated yet,
       so we render a placeholder to preserve 1:1 layout width. #}
    {% if column_left %}
      {{ column_left }}
    {% else %}
      <aside id="column-left" class="col-md-3 hidden-xs hidden-sm"></aside>
    {% endif %}

    {# Content width depending on side columns.
       We always reserve the left column width (col-3 placeholder) to match OC2. #}
    {% if column_right %}
      {% set class = 'col-md-6' %}
    {% else %}
      {% set class = 'col-md-9' %}
    {% endif %}

    <div id="content" class="{{ class }}">{% set is_ua = is_ua is defined ? is_ua : (language|default('') in ['uk-ua','ua']) %}
      {# content_top currently contains a category list module that duplicates navigation and breaks layout #}
      {# {{ content_top }} #}

      <div class="title"><h1>{{ heading_title }}</h1></div>

      {# IMPORTANT for FilterPro AJAX: keep these nodes always present, even when 0 products #}
      <div class="product-filter">
        <button type="button" id="mobile-filter-toggle" aria-controls="mobile-filter-drawer" aria-expanded="false">
          {{ is_ua ? 'Фільтри' : 'Фильтры' }}
        </button>

        <div class="sort">
          <div class="product-filter-title">{{ text_sort }}:</div>
          <select id="input-sort" class="select" onchange="location = this.value;">
            {% for sorts in sorts %}
              <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="limit">
          <div class="product-filter-title">{{ text_limit }}:</div>
          <select id="input-limit" class="select" onchange="location = this.value;">
            {% for limits in limits %}
              <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="row product-grid" id="product-list">
        {% if products %}
          {% for product in products %}
            {{ product }}
          {% endfor %}
        {% else %}
          <div class="fp_empty">{% if is_ua %}Товарів не знайдено{% else %}Товаров не найдено{% endif %}</div>
        {% endif %}
      </div>

      <div class="pagination_w center">{{ pagination }}</div>

      {% if description %}
        <div class="cat_seo_text">
          {{ description }}
        </div>
      {% endif %}

      {# When 0 products, we show the empty message inside #product-list above #}
      {% if not categories and not products %}
        {# keep legacy block disabled to avoid duplicate empty messages #}
      {% endif %}

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>

  {# Mobile-only filter drawer. Populated on first open by cloning #filterpro from the desktop aside. #}
  <div id="mobile-filter-drawer" aria-hidden="true">
    <div class="mfd-backdrop"></div>
    <aside class="mfd-panel" role="dialog" aria-modal="true" aria-label="{{ is_ua ? 'Фільтри' : 'Фильтры' }}">
      <div class="mfd-header">
        <span class="mfd-title">{{ is_ua ? 'Фільтри' : 'Фильтры' }}</span>
        <button type="button" class="mfd-close" aria-label="Close">×</button>
      </div>
      <div class="mfd-body"></div>
    </aside>
  </div>
</div>

<style>
  #mobile-filter-toggle { display: none; }
  #mobile-filter-drawer { display: none; }
  @media (max-width: 991px) {
    #mobile-filter-toggle {
      display: inline-block;
      background: #fed700; color: #000;
      border: none; padding: 8px 14px;
      font-weight: 700; font-size: 14px;
      cursor: pointer; margin: 0 12px 8px 0;
      border-radius: 3px; vertical-align: middle;
    }
    #mobile-filter-drawer.is-open { display: block; }
    #mobile-filter-drawer .mfd-backdrop {
      position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9998;
    }
    #mobile-filter-drawer .mfd-panel {
      position: fixed; top: 0; right: 0; bottom: 0;
      width: 88%; max-width: 360px; background: #fff;
      z-index: 9999; overflow-y: auto;
      transform: translateX(100%); transition: transform .25s ease;
      display: flex; flex-direction: column;
    }
    #mobile-filter-drawer.is-open .mfd-panel { transform: translateX(0); }
    #mobile-filter-drawer .mfd-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 16px; border-bottom: 1px solid #eee; flex-shrink: 0;
    }
    #mobile-filter-drawer .mfd-title { font-weight: 700; }
    #mobile-filter-drawer .mfd-close {
      background: none; border: none; font-size: 28px; line-height: 1; cursor: pointer; padding: 0 4px;
    }
    #mobile-filter-drawer .mfd-body { padding: 16px; overflow-y: auto; flex: 1; }
    body.mfd-lock { overflow: hidden; }
  }
</style>

<script>
  // Mobile filter drawer: clone #filterpro from the (visually hidden) desktop aside on first open.
  (function () {
    var btn = document.getElementById('mobile-filter-toggle');
    var drawer = document.getElementById('mobile-filter-drawer');
    if (!btn || !drawer) return;

    var body = drawer.querySelector('.mfd-body');
    var backdrop = drawer.querySelector('.mfd-backdrop');
    var closeBtn = drawer.querySelector('.mfd-close');

    function populate() {
      if (body.firstChild) return;
      var src = document.getElementById('filterpro');
      if (!src) return;
      var clone = src.cloneNode(true);
      clone.id = 'filterpro-mobile';
      clone.querySelectorAll('[id]').forEach(function (el) { el.id = el.id + '-mobile'; });
      body.appendChild(clone);
    }

    function open() {
      populate();
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('mfd-lock');
    }
    function close() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('mfd-lock');
    }

    btn.addEventListener('click', open);
    backdrop.addEventListener('click', close);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
    });

    // Hide the toggle if there's nothing to show (filter module returned empty).
    if (!document.getElementById('filterpro')) btn.style.display = 'none';
  })();
</script>

<script>
  // OC2-like mini-gallery behavior: hovering a thumbnail replaces the main image.
  document.addEventListener('mouseover', function (e) {
    const thumb = e.target.closest('.p_dop_photo_h');
    if (!thumb) return;

    const product = thumb.closest('.product_w');
    if (!product) return;

    const mainImg = product.querySelector('.prod_image img');
    if (!mainImg) return;

    const href = thumb.getAttribute('data-href');
    if (href) {
      mainImg.src = href;
    }

    // active class (note: OC2 markup uses a space before 'active')
    product.querySelectorAll('.p_dop_photo_h').forEach(el => el.classList.remove('active'));
    thumb.classList.add('active');
  });

  // Restore main image when leaving product card
  document.addEventListener('mouseout', function (e) {
    const product = e.target.closest && e.target.closest('.product_w');
    if (!product) return;

    if (e.relatedTarget && product.contains(e.relatedTarget)) return;

    const mainImg = product.querySelector('.prod_image img');
    if (mainImg && mainImg.dataset.default) {
      mainImg.src = mainImg.dataset.default;
    }

    product.querySelectorAll('.p_dop_photo_h').forEach(el => el.classList.remove('active'));
    const first = product.querySelector('.p_dop_photo_h');
    if (first) first.classList.add('active');
  });
</script>

{{ footer }}
