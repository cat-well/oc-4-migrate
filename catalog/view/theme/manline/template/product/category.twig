{{ header }}

<div id="product-category" class="container">

  {# Breadcrumbs (OC2-like) #}
  <div class="breadcrumb_w">
    {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        <span class="sep">&gt;</span>
      {% else %}
        <span class="current">{{ breadcrumb.text }}</span>
      {% endif %}
    {% endfor %}
  </div>

  <div class="row">

    {{ column_left }}

    {# Content width depending on side columns #}
    {% if column_left and column_right %}
      {% set class = 'col-md-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-md-9' %}
    {% else %}
      {% set class = 'col-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

      <div class="title"><h1>{{ heading_title }}</h1></div>

      {% if products %}
        <div class="product-filter">
          <div class="sort">
            <div class="product-filter-title">{{ text_sort }}:</div>
            <select id="input-sort" class="select" onchange="location = this.value;">
              {% for sorts in sorts %}
                <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="limit">
            <div class="product-filter-title">{{ text_limit }}:</div>
            <select id="input-limit" class="select" onchange="location = this.value;">
              {% for limits in limits %}
                <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="product-grid" id="product-list">
          {% for product in products %}
            <div class="wrap-product-item col-sm-6 col-md-3">{{ product }}</div>
          {% endfor %}
        </div>

        <div class="pagination_w center">
          {{ pagination }}
        </div>

      {% endif %}

      {% if description %}
        <div class="cat_seo_text">
          {{ description }}
        </div>
      {% endif %}

      {% if not categories and not products %}
        <p>{{ text_no_results }}</p>
        <div class="text-end"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      {% endif %}

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>

<script>
  // Hover mini-gallery (left thumbnails -> swap main image)
  document.addEventListener('mouseover', function (e) {
    const thumb = e.target.closest('.p_dop_photo_h');
    if (!thumb) return;

    const product = thumb.closest('.product_w');
    if (!product) return;

    const mainImg = product.querySelector('img.prod-main-img');
    if (!mainImg) return;

    const popup = thumb.getAttribute('data-popup');
    if (popup) {
      mainImg.src = popup;
    }

    product.querySelectorAll('.p_dop_photo_h.active').forEach(el => el.classList.remove('active'));
    thumb.classList.add('active');
  });

  // Restore main image when leaving product card
  document.addEventListener('mouseout', function (e) {
    const product = e.target.closest && e.target.closest('.product_w');
    if (!product) return;

    // If we are still inside the same product card, ignore
    if (e.relatedTarget && product.contains(e.relatedTarget)) return;

    const mainImg = product.querySelector('img.prod-main-img');
    if (mainImg && mainImg.dataset.default) {
      mainImg.src = mainImg.dataset.default;
    }

    product.querySelectorAll('.p_dop_photo_h.active').forEach(el => el.classList.remove('active'));
    const first = product.querySelector('.p_dop_photo_h');
    if (first) first.classList.add('active');
  });
</script>

{{ footer }}
