{{ header }}

<div id="product-search" class="container">

  {# Breadcrumbs (OC2-like) #}
  <div class="breadcrumb_w">
    {% for breadcrumb in breadcrumbs %}
      {% if not loop.last %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        <span class="sep">&gt;</span>
      {% else %}
        <span class="current">{{ breadcrumb.text }}</span>
      {% endif %}
    {% endfor %}
  </div>

  <div class="row">

    {# Left column: OC2-like FilterPro sidebar (search mode) #}
    {% if filterpro_like %}
      <aside id="column-left" class="col-md-3 hidden-xs hidden-sm">{{ filterpro_like }}</aside>
    {% elseif column_left %}
      {{ column_left }}
    {% else %}
      <aside id="column-left" class="col-md-3 hidden-xs hidden-sm"></aside>
    {% endif %}

    {% if column_right %}
      {% set class = 'col-md-6' %}
    {% else %}
      {% set class = 'col-md-9' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {# {{ content_top }} #}

      <div class="title"><h1>{{ heading_title }}</h1></div>

      <div class="product-filter">
        <div class="sort">
          <div class="product-filter-title">{{ text_sort }}:</div>
          <select id="input-sort" class="select" onchange="location = this.value;">
            {% for sorts in sorts %}
              <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="limit">
          <div class="product-filter-title">{{ text_limit }}:</div>
          <select id="input-limit" class="select" onchange="location = this.value;">
            {% for limits in limits %}
              <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="row product-grid" id="product-list">
        {% if products %}
          {% for product in products %}
            {{ product }}
          {% endfor %}
        {% else %}
          <div class="fp_empty">{% if lang == 'uk-ua' %}Товарів не знайдено{% else %}Товаров не найдено{% endif %}</div>
        {% endif %}
      </div>

      <div class="pagination_w center">{{ pagination }}</div>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>

{{ footer }}
