<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ text_redirect_title }}</title>
</head>
<body onload="document.getElementById('liqpay_form').submit();">
    <div style="text-align: center; padding: 50px;">
        <p>{{ text_redirect_message }}</p>
        <div class="spinner-border" role="status">
            <span class="visually-hidden">{{ text_loading }}</span>
        </div>
    </div>
    
    <form id="liqpay_form" action="{{ action }}" method="post" style="display: none;">
        <input type="hidden" name="data" value="{{ data }}">
        <input type="hidden" name="signature" value="{{ signature }}">
    </form>
</body>
</html>