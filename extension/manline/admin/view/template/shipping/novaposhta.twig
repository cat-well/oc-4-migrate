{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_api_key" value="{{ shipping_novaposhta_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-url" class="col-sm-2 col-form-label">{{ entry_api_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_api_url" value="{{ shipping_novaposhta_api_url }}" placeholder="{{ entry_api_url }}" id="input-api-url" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-free-total" class="col-sm-2 col-form-label">{{ entry_free_total }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_free_total" value="{{ shipping_novaposhta_free_total }}" placeholder="{{ entry_free_total }}" id="input-free-total" class="form-control"/>
              <div class="form-text">{{ help_free_total }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-branch-cost" class="col-sm-2 col-form-label">{{ entry_branch_cost }}</label>
            <div class="col-sm-8">
              <input type="text" name="shipping_novaposhta_branch_cost" value="{{ shipping_novaposhta_branch_cost }}" placeholder="{{ entry_branch_cost }}" id="input-branch-cost" class="form-control"/>
            </div>
            <div class="col-sm-2">
              <div class="form-check form-switch form-switch-lg mt-2">
                <input type="hidden" name="shipping_novaposhta_branch_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_branch_status" value="1" class="form-check-input"{% if shipping_novaposhta_branch_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-courier-cost" class="col-sm-2 col-form-label">{{ entry_courier_cost }}</label>
            <div class="col-sm-8">
              <input type="text" name="shipping_novaposhta_courier_cost" value="{{ shipping_novaposhta_courier_cost }}" placeholder="{{ entry_courier_cost }}" id="input-courier-cost" class="form-control"/>
            </div>
            <div class="col-sm-2">
              <div class="form-check form-switch form-switch-lg mt-2">
                <input type="hidden" name="shipping_novaposhta_courier_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_courier_status" value="1" class="form-check-input"{% if shipping_novaposhta_courier_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-locker-cost" class="col-sm-2 col-form-label">{{ entry_locker_cost }}</label>
            <div class="col-sm-8">
              <input type="text" name="shipping_novaposhta_locker_cost" value="{{ shipping_novaposhta_locker_cost }}" placeholder="{{ entry_locker_cost }}" id="input-locker-cost" class="form-control"/>
            </div>
            <div class="col-sm-2">
              <div class="form-check form-switch form-switch-lg mt-2">
                <input type="hidden" name="shipping_novaposhta_locker_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_locker_status" value="1" class="form-check-input"{% if shipping_novaposhta_locker_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-default-sender-city" class="col-sm-2 col-form-label">{{ entry_default_sender_city }}</label>
            <div class="col-sm-10 np-sender-autocomplete-wrap">
              <input type="text" name="shipping_novaposhta_default_sender_city" value="{{ shipping_novaposhta_default_sender_city }}" placeholder="{{ entry_default_sender_city }}" id="input-default-sender-city" class="form-control" autocomplete="off"/>
              <input type="hidden" name="shipping_novaposhta_default_sender_city_ref" value="{{ shipping_novaposhta_default_sender_city_ref }}" id="input-default-sender-city-ref"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-default-sender-delivery-type" class="col-sm-2 col-form-label">{{ entry_default_sender_delivery_type }}</label>
            <div class="col-sm-10">
              <select name="shipping_novaposhta_default_sender_delivery_type" id="input-default-sender-delivery-type" class="form-select">
                <option value="branch"{% if shipping_novaposhta_default_sender_delivery_type != 'locker' %} selected{% endif %}>{{ text_delivery_branch }}</option>
                <option value="locker"{% if shipping_novaposhta_default_sender_delivery_type == 'locker' %} selected{% endif %}>{{ text_delivery_locker }}</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-default-sender-warehouse" class="col-sm-2 col-form-label">{{ entry_default_sender_warehouse }}</label>
            <div class="col-sm-10 np-sender-autocomplete-wrap">
              <textarea name="shipping_novaposhta_default_sender_warehouse" placeholder="{{ entry_default_sender_warehouse }}" id="input-default-sender-warehouse" class="form-control" rows="2" autocomplete="off">{{ shipping_novaposhta_default_sender_warehouse }}</textarea>
              <input type="hidden" name="shipping_novaposhta_default_sender_warehouse_ref" value="{{ shipping_novaposhta_default_sender_warehouse_ref }}" id="input-default-sender-warehouse-ref"/>
              <div class="form-text">{{ help_default_sender }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_replace_flat }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_novaposhta_replace_flat" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_replace_flat" value="1" class="form-check-input"{% if shipping_novaposhta_replace_flat %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_replace_flat }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_novaposhta_tax_class_id" id="input-tax-class" class="form-select">
                <option value="0">{{ text_none }}</option>
                {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_novaposhta_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_novaposhta_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_novaposhta_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_novaposhta_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_status" value="1" id="input-status" class="form-check-input"{% if shipping_novaposhta_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_sort_order" value="{{ shipping_novaposhta_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
    var endpoint = '{{ novaposhta_lookup|replace({'&amp;':'&'})|escape('js') }}';

    function attach($input, getPayload, onPick) {
        var $wrap = $input.closest('.np-sender-autocomplete-wrap');
        $wrap.css('position', 'relative');

        var $list = $('<ul class="dropdown-menu w-100 shadow-sm" style="position:absolute; left:0; max-height:240px; overflow:auto; z-index:1060;"></ul>').hide();
        $input.after($list);

        var items = {};
        var timer = null;

        function hide() {
            $list.hide();
        }

        function show() {
            var pos = $input.position();
            $list.css({
                top: pos.top + $input.outerHeight(),
                left: pos.left,
                width: $input.outerWidth()
            }).show();
        }

        function render(data) {
            items = {};
            var html = '';

            if (!Array.isArray(data) || !data.length) {
                $list.html('');
                hide();
                return;
            }

            data.forEach(function(item, idx) {
                var value = String(item.value || item.description || '');
                if (!value) return;
                items[String(idx)] = item;
                html += '<li><a class="dropdown-item" href="#" data-key="' + idx + '" style="white-space:normal;">' +
                    $('<div/>').text(String(item.label || value)).html() +
                    '</a></li>';
            });

            $list.html(html);
            if (html && $input.is(':focus')) show();
        }

        function request() {
            var payload = getPayload(String($input.val() || ''));
            if (!payload) {
                render([]);
                return;
            }

            clearTimeout(timer);
            timer = setTimeout(function() {
                $.ajax({
                    url: endpoint,
                    type: 'POST',
                    dataType: 'json',
                    data: payload,
                    global: false
                }).done(function(json) {
                    render(Array.isArray(json) ? json : []);
                }).fail(function() {
                    render([]);
                });
            }, 180);
        }

        $input.on('focus.npDefaultSender input.npDefaultSender keyup.npDefaultSender', request);
        $input.on('blur.npDefaultSender', function() {
            setTimeout(hide, 200);
        });

        $list.on('mousedown.npDefaultSender touchstart.npDefaultSender', 'a', function(e) {
            e.preventDefault();

            var item = items[String($(this).data('key'))];
            if (!item) return;

            onPick(item);
            hide();
        });
    }

    attach(
        $('#input-default-sender-city'),
        function(search) {
            return {action: 'getCities', search: search};
        },
        function(item) {
            $('#input-default-sender-city').val(String(item.value || ''));
            $('#input-default-sender-city-ref').val(String(item.ref || ''));
            $('#input-default-sender-warehouse').val('');
            $('#input-default-sender-warehouse-ref').val('');
        }
    );

    attach(
        $('#input-default-sender-warehouse'),
        function(search) {
            var cityRef = String($('#input-default-sender-city-ref').val() || '');
            if (!cityRef) return null;

            return {
                action: 'getWarehouses',
                search: search,
                city_ref: cityRef,
                delivery_type: String($('#input-default-sender-delivery-type').val() || 'branch')
            };
        },
        function(item) {
            $('#input-default-sender-warehouse').val(String(item.value || ''));
            $('#input-default-sender-warehouse-ref').val(String(item.ref || ''));
        }
    );

    $('#input-default-sender-delivery-type').on('change.npDefaultSender', function() {
        $('#input-default-sender-warehouse').val('');
        $('#input-default-sender-warehouse-ref').val('');
    });

    $('#input-default-sender-city').on('input.npDefaultSenderClear', function() {
        $('#input-default-sender-city-ref').val('');
        $('#input-default-sender-warehouse').val('');
        $('#input-default-sender-warehouse-ref').val('');
    });

    $('#input-default-sender-warehouse').on('input.npDefaultSenderClear', function() {
        $('#input-default-sender-warehouse-ref').val('');
    });
})();
</script>
{{ footer }}
