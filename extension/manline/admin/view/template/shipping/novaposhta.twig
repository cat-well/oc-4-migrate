{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_api_key" value="{{ shipping_novaposhta_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-url" class="col-sm-2 col-form-label">{{ entry_api_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_api_url" value="{{ shipping_novaposhta_api_url }}" placeholder="{{ entry_api_url }}" id="input-api-url" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-free-total" class="col-sm-2 col-form-label">{{ entry_free_total }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_free_total" value="{{ shipping_novaposhta_free_total }}" placeholder="{{ entry_free_total }}" id="input-free-total" class="form-control"/>
              <div class="form-text">{{ help_free_total }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-branch-cost" class="col-sm-2 col-form-label">{{ entry_branch_cost }}</label>
            <div class="col-sm-8">
              <input type="text" name="shipping_novaposhta_branch_cost" value="{{ shipping_novaposhta_branch_cost }}" placeholder="{{ entry_branch_cost }}" id="input-branch-cost" class="form-control"/>
            </div>
            <div class="col-sm-2">
              <div class="form-check form-switch form-switch-lg mt-2">
                <input type="hidden" name="shipping_novaposhta_branch_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_branch_status" value="1" class="form-check-input"{% if shipping_novaposhta_branch_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-courier-cost" class="col-sm-2 col-form-label">{{ entry_courier_cost }}</label>
            <div class="col-sm-8">
              <input type="text" name="shipping_novaposhta_courier_cost" value="{{ shipping_novaposhta_courier_cost }}" placeholder="{{ entry_courier_cost }}" id="input-courier-cost" class="form-control"/>
            </div>
            <div class="col-sm-2">
              <div class="form-check form-switch form-switch-lg mt-2">
                <input type="hidden" name="shipping_novaposhta_courier_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_courier_status" value="1" class="form-check-input"{% if shipping_novaposhta_courier_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-locker-cost" class="col-sm-2 col-form-label">{{ entry_locker_cost }}</label>
            <div class="col-sm-8">
              <input type="text" name="shipping_novaposhta_locker_cost" value="{{ shipping_novaposhta_locker_cost }}" placeholder="{{ entry_locker_cost }}" id="input-locker-cost" class="form-control"/>
            </div>
            <div class="col-sm-2">
              <div class="form-check form-switch form-switch-lg mt-2">
                <input type="hidden" name="shipping_novaposhta_locker_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_locker_status" value="1" class="form-check-input"{% if shipping_novaposhta_locker_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_replace_flat }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_novaposhta_replace_flat" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_replace_flat" value="1" class="form-check-input"{% if shipping_novaposhta_replace_flat %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_replace_flat }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_novaposhta_tax_class_id" id="input-tax-class" class="form-select">
                <option value="0">{{ text_none }}</option>
                {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_novaposhta_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_novaposhta_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_novaposhta_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_novaposhta_status" value="0"/>
                <input type="checkbox" name="shipping_novaposhta_status" value="1" id="input-status" class="form-check-input"{% if shipping_novaposhta_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_novaposhta_sort_order" value="{{ shipping_novaposhta_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
