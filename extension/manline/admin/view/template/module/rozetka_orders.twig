{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}

    <div class="alert alert-secondary"><i class="fa-solid fa-eye"></i> {{ text_readonly }}</div>

    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-key"></i> {{ text_token }}</div>
      <div class="card-body">
        <form action="{{ save }}" method="post">
          <div class="row mb-2">
            <label class="col-sm-2 col-form-label" for="input-token">{{ entry_token }}</label>
            <div class="col-sm-8">
              <input type="password" name="token" value="" id="input-token" class="form-control" placeholder="{{ token_set ? token_hint : 'gapi_…' }}" autocomplete="off"/>
              <div class="form-text">
                {% if token_set %}<span class="text-success"><i class="fa-solid fa-circle-check"></i> {{ text_token_set }}</span> — {% endif %}{{ help_token }}
              </div>
            </div>
            <div class="col-sm-2">
              <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-save"></i> {{ button_save }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    {% if not token_set %}
      <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_need_token }}</div>
    {% elseif api_error %}
      <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_api_error }}: {{ api_error }}</div>
    {% else %}

      <div class="row mb-3">
        <div class="col"><div class="card text-center"><div class="card-body">
          <div class="h3 mb-0">{{ summary.orders }}</div><small class="text-muted">{{ text_orders }}</small></div></div></div>
        <div class="col"><div class="card text-center"><div class="card-body">
          <div class="h3 mb-0">{{ summary.items }}</div><small class="text-muted">{{ text_items }}</small></div></div></div>
        <div class="col"><div class="card text-center border-success"><div class="card-body">
          <div class="h3 mb-0 text-success">{{ summary.exact }}</div><small class="text-muted">{{ text_exact }}</small></div></div></div>
        <div class="col"><div class="card text-center"><div class="card-body">
          <div class="h3 mb-0">{{ summary.matched - summary.exact }}</div><small class="text-muted">{{ text_by_name }}</small></div></div></div>
        <div class="col"><div class="card text-center border-warning"><div class="card-body">
          <div class="h3 mb-0 text-warning">{{ summary.ambiguous }}</div><small class="text-muted">{{ text_ambiguous }}</small></div></div></div>
        <div class="col"><div class="card text-center {{ summary.unmatched ? 'border-danger' : '' }}"><div class="card-body">
          <div class="h3 mb-0 {{ summary.unmatched ? 'text-danger' : '' }}">{{ summary.unmatched }}</div><small class="text-muted">{{ text_unmatched }}</small></div></div></div>
      </div>

      <div class="card">
        <div class="card-header"><i class="fa-solid fa-bag-shopping"></i> {{ text_orders_list }}
          {% if meta.totalCount is defined %}<span class="badge bg-secondary float-end">{{ text_total }}: {{ meta.totalCount }}</span>{% endif %}
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered align-middle">
              <thead>
                <tr>
                  <td>{{ column_order }}</td>
                  <td>{{ column_date }}</td>
                  <td class="text-end">{{ column_amount }}</td>
                  <td>{{ column_customer }}</td>
                  <td>{{ column_ttn }}</td>
                  <td>{{ column_items }}</td>
                </tr>
              </thead>
              <tbody>
                {% for order in orders %}
                  <tr>
                    <td class="text-nowrap"><strong>#{{ order.id }}</strong></td>
                    <td class="text-nowrap"><small>{{ order.created }}</small></td>
                    <td class="text-end text-nowrap">{{ order.amount }}</td>
                    <td><small>{{ order.customer }}<br/>{{ order.phone }}</small></td>
                    <td><small>{{ order.ttn ?: '—' }}</small></td>
                    <td>
                      {% if not order.detail_ok %}
                        <span class="text-danger"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_detail_fail }}</span>
                      {% endif %}
                      {% for item in order.items %}
                        <div class="mb-2 pb-2 {{ not loop.last ? 'border-bottom' : '' }}">
                          <div>{{ item.name }} <span class="text-muted">×{{ item.quantity }}</span></div>
                          <small class="text-muted">offer: {{ item.offer }}</small>
                          <div class="mt-1">
                            {% if item.match.confidence == 'exact' %}
                              <span class="badge bg-success">{{ text_m_exact }}</span>
                              <a href="{{ item.edit_url }}" target="_blank">#{{ item.match.product_id }} {{ item.match.name }}</a>
                            {% elseif item.match.confidence == 'name' %}
                              <span class="badge bg-info text-dark">{{ text_m_name }}</span>
                              <a href="{{ item.edit_url }}" target="_blank">#{{ item.match.product_id }} {{ item.match.name }}</a>
                            {% elseif item.match.confidence == 'ambiguous' %}
                              <span class="badge bg-warning text-dark">{{ text_m_ambiguous }}</span>
                              <span class="text-muted">{{ text_model }} {{ item.match.model }} → {{ item.match.candidates }} {{ text_candidates }}</span>
                            {% else %}
                              <span class="badge bg-danger">{{ text_m_none }}</span>
                            {% endif %}
                          </div>
                        </div>
                      {% endfor %}
                    </td>
                  </tr>
                {% else %}
                  <tr><td class="text-center" colspan="6">{{ text_no_orders }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>
{{ footer }}
