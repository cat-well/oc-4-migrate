{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-filterpro" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-filter"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-filterpro" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-select">
                <option value="1" {% if status %}selected{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not status %}selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_use_globally }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="use_globally" value="1" id="input-use-globally" {% if use_globally %}checked{% endif %} {% if not module_id %}disabled{% endif %}>
                <label class="form-check-label" for="input-use-globally"></label>
              </div>
              {% if not module_id %}
                <div class="form-text">{{ text_save_first|default('Save module first to enable global binding.') }}</div>
              {% endif %}
            </div>
          </div>

          <hr/>

          <h3 class="mb-3">{{ text_blocks|default('Blocks') }}</h3>

          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <th>{{ column_block }}</th>
                  <th style="width:180px">{{ column_display }}</th>
                  <th style="width:120px">{{ column_expanded }}</th>
                  <th>{{ column_tooltip }}</th>
                </tr>
              </thead>
              <tbody>
                {% for i, b in blocks %}
                  <tr data-fp-row>
                    <td>
                      <div class="row g-2">
                        <div class="col-md-4">
                          <input type="text" class="form-control" name="blocks[{{ i }}][key]" value="{{ b.key ?? '' }}" placeholder="key (e.g. price, manufacturer, option:14)"/>
                        </div>
                        <div class="col-md-8">
                          {% for language in languages %}
                            <div class="input-group mb-2">
                              <span class="input-group-text"><img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" title="{{ language.name }}"></span>
                              <input type="text" class="form-control" name="blocks[{{ i }}][label][{{ language.code }}]" value="{{ b.label[language.code] ?? '' }}" placeholder="{{ column_block }}"/>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    </td>
                    <td>
                      <select class="form-select" name="blocks[{{ i }}][display]">
                        {% for opt in display_options %}
                          <option value="{{ opt.value }}" {% if b.display == opt.value %}selected{% endif %}>{{ opt.text }}</option>
                        {% endfor %}
                      </select>
                    </td>
                    <td class="text-center">
                      <input type="checkbox" class="form-check-input" name="blocks[{{ i }}][expanded]" value="1" {% if b.expanded %}checked{% endif %}/>
                      <div class="mt-2">
                        <input type="number" class="form-control form-control-sm" name="blocks[{{ i }}][sort_order]" value="{{ b.sort_order ?? (i * 10) }}" placeholder="sort" />
                      </div>
                    </td>
                    <td>
                      {% for language in languages %}
                        <div class="input-group mb-2">
                          <span class="input-group-text"><img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" title="{{ language.name }}"></span>
                          <textarea class="form-control" name="blocks[{{ i }}][tooltip][{{ language.code }}]" rows="2">{{ b.tooltip[language.code] ?? '' }}</textarea>
                        </div>
                      {% endfor %}

                      <div class="text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-fp-remove>Remove</button>
                      </div>
                    </td>
                  </tr>
                {% endfor %}

                <tr>
                  <td colspan="4">
                    <button type="button" class="btn btn-outline-primary" id="fp-add-row">Add block</button>
                    <div class="form-text mt-2">
                      Keys supported: <code>price</code>, <code>manufacturer</code>, <code>option:&lt;id&gt;</code>, <code>attribute:&lt;id&gt;</code>, <code>popular_queries</code>.
                      Legacy keys: <code>color</code>, <code>style</code>, <code>size</code>.
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <hr/>

          <h3 class="mb-3">{{ text_popular_queries|default('Popular queries') }}</h3>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_popular_queries|default('Links list') }}</label>
            <div class="col-sm-10">
              {% for language in languages %}
                <div class="input-group mb-2">
                  <span class="input-group-text"><img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" title="{{ language.name }}"></span>
                  <textarea class="form-control" name="popular_queries[{{ language.code }}]" rows="6" placeholder="one per line: label|url">{{ popular_queries[language.code] ?? '' }}</textarea>
                </div>
              {% endfor %}
              <div class="form-text">
                One per line: <code>label|url</code>. Example: <code>купить мужское белье|https://example.com</code>
              </div>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
<script>
  (function() {
    function matches(el, selector) {
      if (!el) return false;
      var fn = el.matches || el.msMatchesSelector || el.webkitMatchesSelector;
      return fn ? fn.call(el, selector) : false;
    }

    function closest(el, selector) {
      while (el && el.nodeType === 1) {
        if (matches(el, selector)) return el;
        el = el.parentElement;
      }
      return null;
    }

    function nextIndex() {
      var rows = document.querySelectorAll('tr[data-fp-row]');
      return rows.length;
    }

    function rowTemplate(i) {
      // Note: tooltips are per-language
      var languages = {{ languages|json_encode|raw }};
      var tooltipHtml = '';
      languages.forEach(function(lang) {
        tooltipHtml +=
          '<div class="input-group mb-2">' +
            '<span class="input-group-text"><img src="language/' + lang.code + '/' + lang.code + '.png" alt="' + lang.name + '" title="' + lang.name + '"></span>' +
            '<textarea class="form-control" name="blocks[' + i + '][tooltip][' + lang.code + ']" rows="2"></textarea>' +
          '</div>';
      });

      return (
        '<tr data-fp-row>' +
          '<td>' +
            '<div class="row g-2">' +
              '<div class="col-md-4">' +
                '<input type="text" class="form-control" name="blocks[' + i + '][key]" value="" placeholder="key (e.g. price, manufacturer, option:14)"/>' +
              '</div>' +
              '<div class="col-md-8">' +
                (function(){
                  var html='';
                  languages.forEach(function(lang){
                    html += '<div class="input-group mb-2">' +
                      '<span class="input-group-text"><img src="language/' + lang.code + '/' + lang.code + '.png" alt="' + lang.name + '" title="' + lang.name + '"></span>' +
                      '<input type="text" class="form-control" name="blocks[' + i + '][label][' + lang.code + ']" value="" placeholder="{{ column_block }}"/>' +
                    '</div>';
                  });
                  return html;
                })() +
              '</div>' +
            '</div>' +
          '</td>' +
          '<td>' +
            '<select class="form-select" name="blocks[' + i + '][display]">' +
              {% for opt in display_options %}
                '<option value="{{ opt.value }}">{{ opt.text|e('js') }}</option>' +
              {% endfor %}
            '</select>' +
          '</td>' +
          '<td class="text-center">' +
            '<input type="checkbox" class="form-check-input" name="blocks[' + i + '][expanded]" value="1" checked />' +
            '<div class="mt-2">' +
              '<input type="number" class="form-control form-control-sm" name="blocks[' + i + '][sort_order]" value="' + ((i + 1) * 10) + '" placeholder="sort" />' +
            '</div>' +
          '</td>' +
          '<td>' +
            tooltipHtml +
            '<div class="text-end">' +
              '<button type="button" class="btn btn-outline-danger btn-sm" data-fp-remove>Remove</button>' +
            '</div>' +
          '</td>' +
        '</tr>'
      );
    }

    document.addEventListener('click', function(e) {
      var t = e.target;

      // Add block
      var addBtn = closest(t, '#fp-add-row');
      if (addBtn) {
        var i = nextIndex();
        var addRowTr = closest(addBtn, 'tr');
        if (addRowTr) {
          addRowTr.insertAdjacentHTML('beforebegin', rowTemplate(i));
        }
        return;
      }

      // Remove block
      var btn = closest(t, '[data-fp-remove]');
      if (!btn) return;
      var tr = closest(btn, 'tr');
      if (tr) tr.remove();
    });
  })();
</script>

{{ footer }}
