{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-item" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}</div>
    {% endif %}

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pen"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-item" action="{{ save }}" method="post" enctype="multipart/form-data">

          <ul class="nav nav-tabs" id="langTabs" role="tablist">
            {% for language in languages %}
              <li class="nav-item" role="presentation">
                <button class="nav-link {{ loop.first ? 'active' : '' }}" id="lang-{{ language.language_id }}" data-bs-toggle="tab" data-bs-target="#pane-{{ language.language_id }}" type="button" role="tab">
                  <img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" title="{{ language.name }}"/> {{ language.name }}
                </button>
              </li>
            {% endfor %}
          </ul>

          <div class="tab-content pt-3">
            {% for language in languages %}
              <div class="tab-pane fade {{ loop.first ? 'show active' : '' }}" id="pane-{{ language.language_id }}" role="tabpanel">
                <div class="row mb-3">
                  <label class="col-sm-2 col-form-label" for="input-name-{{ language.language_id }}">{{ entry_title }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="menu_description[{{ language.language_id }}][name]" value="{{ menu_description[language.language_id].name ?? '' }}" id="input-name-{{ language.language_id }}" class="form-control"/>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-link">{{ entry_link }}</label>
            <div class="col-sm-10">
              <input type="text" name="link" value="{{ link }}" id="input-link" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-parent">{{ entry_parent_id }}</label>
            <div class="col-sm-10">
              <select name="parent_id" id="input-parent" class="form-select">
                <option value="0">--</option>
                {% for m in custom_menu %}
                  <option value="{{ m.menu_id }}" data-parent="{{ m.parent_id }}" {{ m.menu_id == parent_id ? 'selected' : '' }}>{{ m.name }}</option>
                {% endfor %}
              </select>
              <input type="hidden" name="parent_parent_id" value="{{ parent_parent_id }}" id="input-parent-parent-id"/>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_image }}</label>
            <div class="col-sm-10">
              <div class="card image">
                <img src="{{ thumb }}" alt="" id="thumb" class="card-img-top"/>
                <input type="hidden" name="image" value="{{ image }}" id="input-image"/>
                <div class="card-body">
                  <button type="button" class="btn btn-primary" data-oc-toggle="image" data-oc-target="#input-image" data-oc-thumb="#thumb" data-oc-placeholder="{{ placeholder }}"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</button>
                  <button type="button" class="btn btn-warning" data-oc-toggle="clear" data-oc-target="#input-image" data-oc-thumb="#thumb" data-oc-placeholder="{{ placeholder }}"><i class="fa-regular fa-trash-can"></i> {{ button_clear }}</button>
                </div>
              </div>
              <div class="form-text">{{ help_image }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-column">{{ entry_column }}</label>
            <div class="col-sm-10">
              <input type="number" min="1" name="column" value="{{ column }}" id="input-column" class="form-control" style="max-width:120px"/>
              <div class="form-text">{{ help_column }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-select" style="max-width:240px">
                <option value="1" {{ status ? 'selected' : '' }}>{{ text_enabled }}</option>
                <option value="0" {{ status ? '' : 'selected' }}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-sort">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="sort_order" value="{{ sort_order }}" id="input-sort" class="form-control" style="max-width:120px"/>
            </div>
          </div>

          <input type="hidden" name="menu_id" value="{{ menu_id }}"/>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  function syncParentParentId() {
    const sel = document.querySelector('#input-parent');
    const opt = sel.options[sel.selectedIndex];
    const parent = opt.getAttribute('data-parent') || 0;
    document.querySelector('#input-parent-parent-id').value = parent;
  }
  document.querySelector('#input-parent').addEventListener('change', syncParentParentId);
  syncParentParentId();
</script>
{{ footer }}
