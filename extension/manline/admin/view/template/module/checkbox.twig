{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-checkbox" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div id="alert"></div>

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-receipt"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-checkbox" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="module_id" value="{{ module_id }}"/>

          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-select">
                <option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <fieldset>
            <legend>API</legend>

            <div class="row mb-3">
              <label for="input-api-url" class="col-sm-2 col-form-label">{{ entry_api_url }}</label>
              <div class="col-sm-10">
                <input type="text" name="api_url" value="{{ api_url }}" id="input-api-url" class="form-control"/>
                <div id="error-api_url" class="invalid-feedback"></div>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-auth-method" class="col-sm-2 col-form-label">{{ entry_auth_method }}</label>
              <div class="col-sm-10">
                <select name="auth_method" id="input-auth-method" class="form-select">
                  <option value="pin"{% if auth_method == 'pin' %} selected{% endif %}>{{ text_auth_pin }}</option>
                  <option value="password"{% if auth_method == 'password' %} selected{% endif %}>{{ text_auth_password }}</option>
                </select>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-license-key" class="col-sm-2 col-form-label">{{ entry_license_key }}</label>
              <div class="col-sm-10">
                <input type="password" name="license_key" value="{{ license_key }}" id="input-license-key" class="form-control" autocomplete="new-password"/>
                <div class="form-text">{{ help_license_key }}</div>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-cashier-pin" class="col-sm-2 col-form-label">{{ entry_cashier_pin }}</label>
              <div class="col-sm-10">
                <input type="password" name="cashier_pin" value="{{ cashier_pin }}" id="input-cashier-pin" class="form-control" autocomplete="new-password"/>
                <div class="form-text">{{ help_cashier_pin }}</div>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-cashier-login" class="col-sm-2 col-form-label">{{ entry_cashier_login }}</label>
              <div class="col-sm-10">
                <input type="text" name="cashier_login" value="{{ cashier_login }}" id="input-cashier-login" class="form-control" autocomplete="off"/>
                <div class="form-text">{{ help_cashier_login }}</div>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-cashier-password" class="col-sm-2 col-form-label">{{ entry_cashier_password }}</label>
              <div class="col-sm-10">
                <input type="password" name="cashier_password" value="{{ cashier_password }}" id="input-cashier-password" class="form-control" autocomplete="new-password"/>
                <div class="form-text">{{ help_cashier_password }}</div>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-client-name" class="col-sm-2 col-form-label">{{ entry_client_name }}</label>
              <div class="col-sm-10">
                <input type="text" name="client_name" value="{{ client_name }}" id="input-client-name" class="form-control"/>
              </div>
            </div>

            <div class="row mb-3">
              <label for="input-client-version" class="col-sm-2 col-form-label">{{ entry_client_version }}</label>
              <div class="col-sm-10">
                <input type="text" name="client_version" value="{{ client_version }}" id="input-client-version" class="form-control"/>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
