{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-recommended" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div id="alert"></div>

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-layer-group"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-recommended" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="module_id" value="{{ module_id }}"/>

          <div class="row mb-3 required">
            <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
              <div id="error-name" class="invalid-feedback"></div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-select">
                <option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <fieldset>
            <legend>{{ text_blocks }}</legend>

            <div class="table-responsive">
              <table id="blocks" class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <th>{{ entry_title_ru }}</th>
                    <th>{{ entry_title_ua }}</th>
                    <th style="min-width: 320px">{{ entry_products }}</th>
                    <th style="width: 160px">{{ entry_image }}</th>
                    <th style="width: 140px">{{ entry_sort_order }}</th>
                    <th style="width: 80px">{{ entry_status }}</th>
                    <th style="width: 90px"></th>
                  </tr>
                </thead>
                <tbody>
                  {% set block_row = 0 %}
                  {% for b in blocks %}
                    <tr data-row="{{ block_row }}">
                      <td><input type="text" name="blocks[{{ block_row }}][title_ru]" value="{{ b.title_ru }}" class="form-control"/></td>
                      <td><input type="text" name="blocks[{{ block_row }}][title_ua]" value="{{ b.title_ua }}" class="form-control"/></td>
                      <td>
                        <input type="hidden" class="block-product-ids" name="blocks[{{ block_row }}][product_ids]" value="{{ b.product_ids }}"/>
                        <input type="text" class="form-control block-product-search" placeholder="{{ help_products }}" data-row="{{ block_row }}" autocomplete="off"/>
                        <div class="small text-muted mt-1">IDs: <span class="block-product-ids-text">{{ b.product_ids }}</span></div>
                      </td>
                      <td>
                        <div class="input-group">
                          <input type="number" name="blocks[{{ block_row }}][image_width]" value="{{ b.image_width }}" class="form-control"/>
                          <span class="input-group-text">x</span>
                          <input type="number" name="blocks[{{ block_row }}][image_height]" value="{{ b.image_height }}" class="form-control"/>
                        </div>
                      </td>
                      <td><input type="number" name="blocks[{{ block_row }}][sort_order]" value="{{ b.sort_order }}" class="form-control"/></td>
                      <td>
                        <select name="blocks[{{ block_row }}][status]" class="form-select">
                          <option value="1"{% if b.status %} selected{% endif %}>{{ text_enabled }}</option>
                          <option value="0"{% if not b.status %} selected{% endif %}>{{ text_disabled }}</option>
                        </select>
                      </td>
                      <td class="text-end"><button type="button" class="btn btn-danger btn-sm" onclick="removeBlockRow(this)">{{ button_remove }}</button></td>
                    </tr>
                    {% set block_row = block_row + 1 %}
                  {% endfor %}
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="6"></td>
                    <td class="text-end"><button type="button" class="btn btn-primary btn-sm" id="button-add-block">{{ button_add_block }}</button></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function removeBlockRow(btn) {
  const tr = btn.closest('tr');
  if (tr) tr.remove();
}

function parseIds(text) {
  return String(text || '')
    .split(',')
    .map(s => parseInt(s.trim(), 10))
    .filter(n => Number.isFinite(n) && n > 0);
}

function setRowIds(row, ids) {
  const tr = document.querySelector('tr[data-row="' + row + '"]');
  if (!tr) return;
  const input = tr.querySelector('.block-product-ids');
  const label = tr.querySelector('.block-product-ids-text');
  const value = ids.join(',');
  if (input) input.value = value;
  if (label) label.textContent = value;
}

function addRow() {
  const tbody = document.querySelector('#blocks tbody');
  let row = 0;
  tbody.querySelectorAll('tr[data-row]').forEach(tr => {
    const r = parseInt(tr.getAttribute('data-row'), 10);
    if (Number.isFinite(r) && r >= row) row = r + 1;
  });

  const html = `
    <tr data-row="${row}">
      <td><input type="text" name="blocks[${row}][title_ru]" value="" class="form-control"/></td>
      <td><input type="text" name="blocks[${row}][title_ua]" value="" class="form-control"/></td>
      <td>
        <input type="hidden" class="block-product-ids" name="blocks[${row}][product_ids]" value=""/>
        <input type="text" class="form-control block-product-search" placeholder="{{ help_products|escape('js') }}" data-row="${row}" autocomplete="off"/>
        <div class="small text-muted mt-1">IDs: <span class="block-product-ids-text"></span></div>
      </td>
      <td>
        <div class="input-group">
          <input type="number" name="blocks[${row}][image_width]" value="250" class="form-control"/>
          <span class="input-group-text">x</span>
          <input type="number" name="blocks[${row}][image_height]" value="375" class="form-control"/>
        </div>
      </td>
      <td><input type="number" name="blocks[${row}][sort_order]" value="0" class="form-control"/></td>
      <td>
        <select name="blocks[${row}][status]" class="form-select">
          <option value="1" selected>{{ text_enabled|escape('js') }}</option>
          <option value="0">{{ text_disabled|escape('js') }}</option>
        </select>
      </td>
      <td class="text-end"><button type="button" class="btn btn-danger btn-sm" onclick="removeBlockRow(this)">{{ button_remove|escape('js') }}</button></td>
    </tr>`;

  tbody.insertAdjacentHTML('beforeend', html);
}

// (handler replaced below)

function bindAutocomplete(input) {
  const row = parseInt(input.getAttribute('data-row'), 10);
  const targetId = 'dropdown-recommended-' + row;

  if (!input.getAttribute('data-oc-target')) {
    input.setAttribute('data-oc-target', targetId);
    const ul = document.createElement('ul');
    ul.className = 'dropdown-menu';
    ul.id = targetId;
    input.parentNode.appendChild(ul);
  }

  function applySelectedProduct(pid) {
    const tr = document.querySelector('tr[data-row="' + row + '"]');
    if (!tr) return;
    const idsInput = tr.querySelector('.block-product-ids');
    if (!idsInput) return;

    const current = parseIds(idsInput.value);
    pid = parseInt(pid, 10);

    if (Number.isFinite(pid) && pid > 0 && !current.includes(pid)) {
      current.push(pid);
    }

    setRowIds(row, current);
    input.value = '';
  }

  $(input).autocomplete({
    source: function(request, response) {
      $.ajax({
        url: 'index.php?route=catalog/product.autocomplete&user_token={{ user_token|escape('js') }}&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) {
            return {
              label: item['name'] + (item['model'] ? ' (' + item['model'] + ')' : ''),
              value: item['product_id']
            };
          }));
        }
      });
    },
    select: function(item) {
      applySelectedProduct(item.value);
    }
  });

  // Fallback click handler: sometimes dropdown inside table-responsive is tricky.
  // This guarantees selecting an item updates hidden IDs.
  $(document).off('click.recommended-' + row).on('click.recommended-' + row, '#' + targetId + ' a.dropdown-item', function(e) {
    e.preventDefault();
    applySelectedProduct($(this).attr('href'));
    $('#' + targetId).removeClass('show');
  });
}


function bindAllAutocompletes() {
  document.querySelectorAll('.block-product-search').forEach(function(el) {
    if (el.__recommendedBound) return;
    el.__recommendedBound = true;
    bindAutocomplete(el);
  });
}

bindAllAutocompletes();
document.getElementById('button-add-block').addEventListener('click', function() {
  addRow();
  bindAllAutocompletes();
});
</script>

{{ footer }}
