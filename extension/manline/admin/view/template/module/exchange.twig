{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-1c" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endif %}

    <div class="alert alert-secondary"><i class="fa-solid fa-flask"></i> {{ text_skeleton }}</div>

    <div class="card mb-3">
      <div class="card-header"><i class="fa-solid fa-arrows-rotate"></i> {{ text_settings }}</div>
      <div class="card-body">
        <form id="form-1c" action="{{ save }}" method="post">

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="status" value="0"/>
                <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{{ status ? ' checked' : '' }}/>
                <label class="form-check-label" for="input-status">
                  {% if status %}<span class="text-success">{{ text_on }}</span>{% else %}<span class="text-danger">{{ text_off }}</span>{% endif %}
                </label>
              </div>
              <div class="form-text">{{ help_status }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-username">{{ entry_username }}</label>
            <div class="col-sm-10">
              <input type="text" name="username" value="{{ username }}" id="input-username" class="form-control" autocomplete="off"/>
              <div class="form-text">{{ help_credentials }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label" for="input-password">{{ entry_password }}</label>
            <div class="col-sm-10">
              <input type="password" name="password" value="" id="input-password" class="form-control" placeholder="{{ password ? '••••••••' : '' }}" autocomplete="off"/>
              <div class="form-text">{{ help_password }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_endpoint }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" value="{{ endpoint }}" class="form-control" readonly onclick="this.select();"/>
                <a href="{{ endpoint }}" target="_blank" class="btn btn-outline-secondary"><i class="fa-solid fa-up-right-from-square"></i></a>
              </div>
              <div class="form-text">{{ help_endpoint }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>

    {% if captured %}
      <div class="card mb-3">
        <div class="card-header"><i class="fa-solid fa-file-code"></i> {{ text_captured }}</div>
        <div class="card-body">
          <table class="table table-sm table-bordered mb-0">
            <thead><tr><td>{{ column_file }}</td><td class="text-end">{{ column_size }}</td><td>{{ column_date }}</td></tr></thead>
            <tbody>
              {% for f in captured %}
                <tr><td>{{ f.name }}</td><td class="text-end">{{ (f.size / 1024)|round }} KB</td><td>{{ f.date }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    {% endif %}

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-terminal"></i> {{ text_log }}</div>
      <div class="card-body">
        {% if log %}
          <pre class="bg-dark text-light p-3 rounded mb-0" style="max-height: 360px; overflow: auto; font-size: 12px;">{{ log }}</pre>
        {% else %}
          <div class="text-muted">{{ text_log_empty }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
